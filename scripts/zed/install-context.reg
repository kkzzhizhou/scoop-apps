Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\*\shell\Zed]
@="Open with Zed"
"Icon"="\"{{dir}}\\Zed.exe\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Zed\command]
@="\"{{dir}}\\Zed.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\directory\shell\Zed]
@="Open with Zed"
"Icon"="\"{{dir}}\\Zed.exe\""

[HKEY_CURRENT_USER\Software\Classes\directory\shell\Zed\command]
@="\"{{dir}}\\Zed.exe\" \"%V\""

[HKEY_CURRENT_USER\Software\Classes\directory\background\shell\Zed]
@="Open with Zed"
"Icon"="\"{{dir}}\\Zed.exe\""

[HKEY_CURRENT_USER\Software\Classes\directory\background\shell\Zed\command]
@="\"{{dir}}\\Zed.exe\" \"%V\""

[HKEY_CURRENT_USER\Software\Classes\zed]
@="URL:zed Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\zed\DefaultIcon]
@="\"{{dir}}\\Zed.exe\",1"

[HKEY_CURRENT_USER\Software\Classes\zed\shell\open\command]
@="\"{{dir}}\\Zed.exe\" \"%1\""
