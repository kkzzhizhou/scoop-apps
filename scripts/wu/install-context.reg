Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\*\shell\Wu]
@="Open with Wu"
"Icon"="\"{{dir}}\\Wu.exe\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Wu\command]
@="\"{{dir}}\\Wu.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\directory\shell\Wu]
@="Open with Wu"
"Icon"="\"{{dir}}\\Wu.exe\""

[HKEY_CURRENT_USER\Software\Classes\directory\shell\Wu\command]
@="\"{{dir}}\\Wu.exe\" \"%V\""

[HKEY_CURRENT_USER\Software\Classes\directory\background\shell\Wu]
@="Open with Wu"
"Icon"="\"{{dir}}\\Wu.exe\""

[HKEY_CURRENT_USER\Software\Classes\directory\background\shell\Wu\command]
@="\"{{dir}}\\Wu.exe\" \"%V\""

[HKEY_CURRENT_USER\Software\Classes\wu]
@="URL:wu Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\wu\DefaultIcon]
@="\"{{dir}}\\Wu.exe\",1"

[HKEY_CURRENT_USER\Software\Classes\wu\shell\open\command]
@="\"{{dir}}\\Wu.exe\" \"%1\""
