{
    "version": "0.2.9",
    "description": "关掉国产安卓手机系统里的广告、热搜、资讯推荐和营销推送。不 root，可还原，支持 AI 智能体一键执行。",
    "homepage": "https://github.com/rddmwmddr/android-ad-cleaner",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/rddmwmddr/android-ad-cleaner#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rddmwmddr/android-ad-cleaner/releases/download/v0.2.9/AndroidAdCleaner-0.2.9-windows-portable.zip",
            "hash": "54f4e7c5246a30f802f706dc51edd8876008b5ce8e7335d3fc6abcaae3978ad2"
        }
    },
    "extract_dir": "AndroidAdCleaner",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\AndroidAdCleaner\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\AndroidAdCleaner\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "AndroidAdCleaner.exe",
    "shortcuts": [
        [
            "AndroidAdCleaner.exe",
            "AndroidAdCleaner"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/rddmwmddr/android-ad-cleaner/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rddmwmddr/android-ad-cleaner/releases/download/v$version/AndroidAdCleaner-$version-windows-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
