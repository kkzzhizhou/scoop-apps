    "notes": [
        "To set profile 'Scoop-Nightly' as *DEFAULT*, or profiles/settings was lost after update:",
        "  - Run 'Firefox Nightly Profile Manager', choose 'Scoop-Nightly' then click 'Start Nightly'.",
        "  - Visit 'about:profiles' page in Firefox Nightly to check *DEFAULT* profile.",
        "For details: https://support.mozilla.org/en-US/kb/profile-manager-create-remove-switch-firefox-profiles"
    ],
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/10/2026-10-22-21-49-40-mozilla-central/firefox-161.0a1.en-US.win64.installer.exe#/dl.7z",
            "hash": "sha512:6b4211b80995e928f866ffdf7d43cc892cfc3beeafd694ea6c64e1e16286abbb837a045c85bfd0163cabe8ca0e76deaefa7239a406b97d05b9ac714871f69325"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/10/2026-10-22-21-49-40-mozilla-central/firefox-161.0a1.en-US.win32.installer.exe#/dl.7z",
