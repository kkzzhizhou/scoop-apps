            "hash": "sha512:9cf961eebde620807f1b5cbd4b9e5e0be77b6e0e62c01548ab3bb60119fce08bd2a253aeccb6a97fde52926243c9051bb49d2cf6f1cde77c5a0e0130ab1428e8"
        },
        "32bit": {
