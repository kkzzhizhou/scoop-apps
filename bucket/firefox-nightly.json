    "notes": [
        "To set profile 'Scoop-Nightly' as *DEFAULT*, or profiles/settings was lost after update:",
        "  - Run 'Firefox Nightly Profile Manager', choose 'Scoop-Nightly' then click 'Start Nightly'.",
        "  - Visit 'about:profiles' page in Firefox Nightly to check *DEFAULT* profile.",
        "For details: https://support.mozilla.org/en-US/kb/profile-manager-create-remove-switch-firefox-profiles"
    ],
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/11/2026-11-12-01-04-10-mozilla-central/firefox-162.0a1.en-US.win64.installer.exe#/dl.7z",
            "hash": "sha512:dfb7af70d4ad2441b468c744d1cbca59fd0df81fab94a2d8545f47e14b5c53e4c78497e750c14cedd9f82d76ae80e48ffd7885cd881205d882a4dbaaaa953b5d"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/nightly/2026/11/2026-11-12-01-04-10-mozilla-central/firefox-162.0a1.en-US.win32.installer.exe#/dl.7z",
