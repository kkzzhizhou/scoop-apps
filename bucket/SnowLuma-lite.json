{
    "version": "2.4.2",
    "description": "The Node.js-dependent Lite distribution of SnowLuma, a QQ client interoperability runtime with OneBot v11, WebUI, SDK and MCP.",
    "homepage": "https://github.com/SnowLuma/SnowLuma",
    "license": "SnowLuma Source-Available Non-Commercial License",
    "notes": "Requires Node.js ^24.22.1 or >=26.12.1. Start with the SnowLuma Lite shortcut or `snowluma-lite`; manage updates with `scoop update SnowLuma-lite` instead of the built-in updater.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/SnowLuma/SnowLuma/releases/download/v2.4.2/SnowLuma-v2.4.2-win-x64-lite.zip",
            "hash": "14c6f137196d5f556e6c601a880ee8aa238ffaf4227696848a146209f96d0f31"
        }
    },
    "pre_install": "@('@echo off', 'cd /d \"%~dp0\"', 'node \"%~dp0check-node-version.cjs\"', 'if errorlevel 1 exit /b 1', 'node \"%~dp0index.mjs\" %*') | Set-Content -LiteralPath \"$dir\\snowluma-lite.cmd\" -Encoding Ascii",
    "bin": [
        [
            "snowluma-lite.cmd",
            "snowluma-lite"
        ]
    ],
    "shortcuts": [
        [
            "snowluma-lite.cmd",
            "SnowLuma Lite"
        ]
    ],
    "persist": [
        "config",
        "data",
        "logs"
    ],
    "checkver": {
        "github": "https://github.com/SnowLuma/SnowLuma"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SnowLuma/SnowLuma/releases/download/v$version/SnowLuma-v$version-win-x64-lite.zip"
            }
        }
    }
}
