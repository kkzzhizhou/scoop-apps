    "checkver": {
        "url": "https://www.cheatengine.org/downloads.php",
        "script": [
            "$page = Invoke-WebRequest -Uri $url -UseBasicParsing",
            "$regexVersion = [regex]'Download Cheat Engine ([\\d.]+)'",
            "$regexUrl = [regex]'https://(?<subdomain>[^\\.]+)\\.cloudfront\\.net/(?<filename>[^\\.]+)\\.exe'",
            "$matchVersion = $regexVersion.Match($page.Content)",
            "$matchUrl = $regexUrl.Match($page.Content)",
            "if (-not $matchVersion.Success) { throw '无法从官网解析出版本号' }",
            "if (-not $matchUrl.Success) { throw '无法从官网解析出下载链接' }",
            "$version = $matchVersion.Groups[1].Value",
            "$subdomain = $matchUrl.Groups['subdomain'].Value",
            "$filename = $matchUrl.Groups['filename'].Value",
            "$version + ' ' + $subdomain + ' ' + $filename"
        ],
        "regex": "(?<version>[\\d.]+)\\s+(?<subdomain>[^\\s]+)\\s+(?<filename>[^\\s]+)"
    },
    "autoupdate": {
        "url": "https://$matchSubdomain.cloudfront.net/$matchFilename.exe",
        "hash": "skip"
    }
