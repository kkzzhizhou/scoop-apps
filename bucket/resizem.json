{
    "version": "1.0.1",
    "description": "Resizem is an app designed for bulk image process. It is particularly useful for users who need to resize, convert, and manage large numbers of image files at once.",
    "homepage": "https://github.com/barats/resizem",
    "license": {
        "identifier": "MulanPSL2",
        "url": "https://github.com/barats/resizem#License-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/barats/resizem/releases/download/v1.0.1/Resizem-amd64-installer.exe#/dl.7z",
            "hash": "f2affc3078582d95a59e7606fc1978e483158b5b894b552543e175e9aff912fe"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninst*\" -Force -Recurse",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\" -Target \"$env:APPDATA\\Resizem.exe\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Resizem.exe\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "shortcuts": [
        [
            "Resizem.exe",
            "Resizem"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/barats/resizem/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/barats/resizem/releases/download/v$version/Resizem-amd64-installer.exe#/dl.7z"
            }
        }
    }
}
