{
    "##": "_edited_from: https://github.com/ScoopInstaller/Versions/blob/master/bucket/googlechrome-beta.json",
    "version": "158.0.8127.18",
    "description": "Fast, secure, and free web browser, built for the modern web.",
    "homepage": "https://www.google.com/chrome/beta",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.google.com/chrome/privacy/eula_text.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://dl.google.com/release2/chrome/ad2odyb76k3dxk57tktayzbdakra_158.0.8127.18/158.0.8127.18_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3be75521abf8151b44d1203ddb917eca61b3b72478d91dc52751b482b8702014"
        }
    },
    "extract_dir": "Chrome-bin",
    "post_install": [
        "# 数据迁移",
        "$link = \"$env:LocalAppData\\Google\\Chrome\\User Data\"",
        "$target = ensure \"$persist_dir\\User Data\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}"
    ],
    "bin": [
        [
            "chrome.exe",
            "chrome-beta"
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Google Chrome (Beta)",
            "--force-device-scale-factor=1.5"
        ]
    ],
    "persist": "User Data",
    "post_uninstall": [
        "# 删除数据软连接",
        "$link = \"$env:LocalAppData\\Google\\Chrome\\User Data\"",
        "Remove-Item -Path $link -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "script": [
            "$AppID = '{8A69D345-D564-463C-AFF1-A69D9E530F96}'",
            "$Body = '<?xml version=\"1.0\" encoding=\"UTF-8\"?><request protocol=\"3.0\"><os platform=\"win\" version=\"10.0.22000.0\" arch=\"x64\"/><app appid=\"' + $AppID + '\" ap=\"1.1-beta-arch_x64\" version=\"\"><updatecheck/></app></request>'",
            "$R = Invoke-RestMethod 'https://update.googleapis.com/service/update2' -Method Post -Body $Body",
            "$Version = $R.response.app.updatecheck.manifest.version",
            "$Base = $R.SelectSingleNode(\"//url[starts-with(@codebase, 'https://dl.google.com/release2/chrome/')]\")",
            "$Base.GetAttribute('codebase') -match 'release2/chrome/([^/]+)/' | Out-Null",
            "$File = $R.SelectSingleNode('//package').GetAttribute('name')",
            "Write-Output \"$Version,$($Matches[1])/$File\""
        ],
        "regex": "(?<version>[\\d.]+),(?<archx64>.+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/release2/chrome/$matchArchx64#/dl.7z"
            }
        }
    }
}
