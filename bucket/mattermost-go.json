{
    "version": "0.5.6",
    "description": "Native Mattermost client written in Go (Mattermost Go)",
    "homepage": "https://github.com/txchen/mattermostgo",
    "license": "Apache-2.0",
    "notes": [
        "Windows support is a preview and the installer is unsigned: if SmartScreen warns, choose More info then Run anyway.",
        "Mattermost Go has its own signed auto-updater that checks once a day and installs updates in place; let it update, or run 'scoop update mattermost-go' again, but do not mix both.",
        "Servers and the image cache live under your user profile (most likely %APPDATA%\\com.github.txchen.mattermostgo), not in the Scoop directory, so they survive updates and uninstalls. Session tokens are kept in Windows Credential Manager."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/txchen/mattermostgo/releases/download/v0.5.6/mattermost-go-setup-0.5.6-amd64.exe#/dl.7z",
            "hash": "a5c92dcb956dbbd0777d85327651e0e46be52926a7043d4f26dcde2b21aa937a"
        },
        "arm64": {
            "url": "https://github.com/txchen/mattermostgo/releases/download/v0.5.6/mattermost-go-setup-0.5.6-arm64.exe#/dl.7z",
            "hash": "dcc9b4f084b03dcca3c70f3aaf0c1f0cd85c0b6ec24b48cc22abd5fda152c085"
        }
    },
    "bin": [
        [
            "Mattermost Go.exe",
            "mattermost-go"
        ]
    ],
    "shortcuts": [
        [
            "Mattermost Go.exe",
            "Mattermost Go"
        ]
    ],
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$*\" -Recurse -Force -ErrorAction SilentlyContinue",
    "checkver": {
        "github": "https://github.com/txchen/mattermostgo"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/txchen/mattermostgo/releases/download/v$version/mattermost-go-setup-$version-amd64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/txchen/mattermostgo/releases/download/v$version/mattermost-go-setup-$version-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "$basename"
        }
    }
}
