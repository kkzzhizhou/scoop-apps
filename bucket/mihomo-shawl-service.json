        "",
        "=== SERVICE CONTROL COMMANDS ===",
        "",
        "Start Service (auto-recovers service if missing):",
        "mihomo-helper start",
        "",
        "Stop Service:",
        "mihomo-helper stop",
        "",
        "Restart Service:",
        "mihomo-helper restart",
        "",
        "Enable Auto-Start (on boot):",
        "mihomo-helper enable",
        "",
        "Disable Auto-Start (manual start):",
        "mihomo-helper disable",
        "",
        "Repair / Re-register Service (e.g. after Windows Update):",
        "mihomo-helper repair"
    ],
