        "arm64": {
            "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v1.25.0/coolapk-desktop_1.25.0_arm64-portable.exe#/coolapk.exe",
            "hash": "ec9e022cdcde31f24fd4fc3284fe3cb05308df4cdd76246021e03db18d3ea767"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\com.coolapk.desktop\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\com.coolapk.desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\com.coolapk.desktop\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.coolapk.desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "coolapk.exe",
    "shortcuts": [
        [
            "coolapk.exe",
            "Coolapk"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/daimiaopeng/coolapk-desktop/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v$version/coolapk-desktop_$version_x64-portable.exe#/coolapk.exe"
            },
            "arm64": {
                "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v$version/coolapk-desktop_$version_arm64-portable.exe#/coolapk.exe"
            }
        }
    }
}
