{
    "version": "3.8.0",
    "description": "批量为视频生成字幕，并可将字幕翻译成其它语言。这是一个客户端工具, 跨平台支持 mac 和 windows 系统",
    "homepage": "https://github.com/buxuku/SmartSub",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/buxuku/SmartSub#MIT-1-ov-file"
    },
    "url": "https://github.com/buxuku/SmartSub/releases/download/v3.8.0/SmartSub_Windows_3.8.0_x64.exe#/dl.7z",
    "hash": "sha512:3fc20e7232affe19872bff17a9a73b82cac61e132b5f22afa463c92d952e93b7ca567724a85387cd641e15dd17e9bcb9b5923a2f90c9090f4c82328d7d2aa1f1",
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$*\" -Force -Recurse"
    ],
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\" -Target \"$env:APPDATA\\video-subtitle-master\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\video-subtitle-master\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "shortcuts": [
        [
            "SmartSub.exe",
            "SmartSub"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/buxuku/SmartSub/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\w.-]+)"
    },
    "autoupdate": {
        "url": "https://github.com/buxuku/SmartSub/releases/download/v$version/SmartSub_Windows_$version_x64.exe#/dl.7z",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512:\\s+$base64"
        }
    }
}
