            "hash": "d3870e5734295b3c56fb4011c754706b08a02a025a657943f19f8382c098d2f5"
        },
        "32bit": {
            "url": "https://definitionupdates.microsoft.com/packages/content/msert.exe?packageType=Scanner&packageVersion=1.463.1.0&arch=x86",
