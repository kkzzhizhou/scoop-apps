            "hash": "804bb515db1f3eb82a2ed44f1d03eb73eb2550907af9e2e31233c2381d3fd507"
        },
        "32bit": {
            "url": "https://definitionupdates.microsoft.com/packages/content/msert.exe?packageType=Scanner&packageVersion=1.457.314.0&arch=x86",
