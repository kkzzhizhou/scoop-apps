    "architecture": {
        "64bit": {
            "url": "https://github.com/LaelLuo/scoop/releases/download/qqnt-9.9.35.260902/qqnt-9.9.35.260902-x64.exe#/dl.7z",
            "hash": "9f4b408e7e33f6d74ddf2b117d6953367a42dbb41af6d82150482d3ffebf05f7"
        }
