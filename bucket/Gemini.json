    "checkver": {
        "script": [
            "$appid = '{533DD80C-942A-4464-B6A9-2E59428D784E}'",
            "$headers = @{ 'x-goog-update-appid' = $appid; 'x-goog-update-updater' = 'GoogleUpdater/1.0' }",
            "foreach ($arch in 'x64', 'arm64') {",
            "    $body = @{ request = @{ os = @{ sp = ''; version = '10.0.26100'; arch = $arch; platform = 'win' }; app = @( @{ appid = $appid; ap = 'prod'; version = '1.0.0.0'; cohort = '1::'; enabled = $true; updatecheck = @{} } ) } } | ConvertTo-Json -Depth 8 -Compress",
            "    $resp = Invoke-WebRequest -Uri 'https://update.googleapis.com/service/update2/json' -Method Post -Headers $headers -ContentType 'application/json' -Body $body -UseBasicParsing",
            "    $raw = $resp.Content -replace '^[\\x29\\x5d\\x7d\\x27]+\\s*', ''",
            "    (($raw | ConvertFrom-Json).gupdate.app[0].updatecheck.codebase)",
            "}"
        ],
        "regex": "(?<path64>release2/[^/\\s]+/[^/\\s]+_(?<version>\\d+(?:\\.\\d+)+)/[^/\\s]+)\\s+\\S+?(?<patharm>release2/[^/\\s]+/[^/\\s]+_\\d+(?:\\.\\d+)+/[^/\\s]+)"
    },
    "autoupdate": {
        "extract_dir": "app-$version",
        "architecture": {
            "64bit": {
                "url": "https://dl.google.com/$matchPath64#/dl.7z"
            },
            "arm64": {
                "url": "https://dl.google.com/$matchPatharm#/dl.7z"
