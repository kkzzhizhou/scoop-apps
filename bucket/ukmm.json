{
    "homepage": "https://nicenenerd.github.io/ukmm/",
    "version": "0.17.1",
    "description": "A mod manager for The Legend of Zelda: Breath of the Wild. Successor to BCML. ",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/NiceneNerd/ukmm/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/NiceneNerd/UKMM/releases/download/v0.17.1/ukmm-x86_64-pc-windows-msvc.zip",
            "hash": "13bb4fd5704e86640dbe15ab23d7144b4875c5d772a375275cb2b4ac05dd9e4a",
            "bin": [
                [
                    "ukmm.exe",
                    "ukmm",
                    "--portable"
                ]
            ],
            "shortcuts": [
                [
                    "ukmm.exe",
                    "Zelda BOTW Mod Manager",
                    "--portable"
                ]
            ]
        }
    },
    "persist": [
        "data",
        "config"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/NiceneNerd/ukmm/releases/latest",
        "jsonpath": {
            "version": "$.tag_name",
            "download": "$.assets[?(@.name =~ /.*msvc\\.zip$/)].browser_download_url"
        },
        "regex": "v([\\d.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchDownload",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
