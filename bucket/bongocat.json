{
    "version": "2.4.0",
    "description": "跨平台桌宠 BongoCat，为桌面增添乐趣！",
    "homepage": "https://github.com/ayangweb/BongoCat",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/ayangweb/BongoCat#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/ayangweb/BongoCat/releases/download/v2.4.0/BongoCat_2.4.0_x64.exe#/dl.7z",
            "hash": "33b06239866e50705178b8959901b0c143bf44928ad1ae84cd52d587551672e0"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\com.ayangweb.bongo-cat\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.ayangweb.bongo-cat\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "bongocat-app.exe",
            "BongoCat"
        ]
    ],
    "shortcuts": [
        [
            "bongocat-app.exe",
            "BongoCat"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/ayangweb/BongoCat/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ayangweb/BongoCat/releases/download/v$version/BongoCat_$version_x64.exe#/dl.7z"
            }
        }
    }
}
