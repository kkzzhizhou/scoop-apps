{
    "version": "0.0.43-20364",
    "description": "Sony PlayStation 3 emulator",
    "homepage": "https://rpcs3.net/",
    "license": {
        "identifier": "GPL-2.0",
        "url": "https://github.com/RPCS3/rpcs3/blob/master/LICENSE"
    },
    "notes": [
        "ATTENTION: RPCS3 requires a copy of the official PS3 firmware to function.",
        "Install the ps3-system-software package.  You must still manually load PS3UPDAT.PUP",
        "See the official quickstart guide for further instructions: https://rpcs3.net/quickstart"
    ],
    "depends": "ps3-system-software",
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/RPCS3/rpcs3-binaries-win/releases/download/build-4b1a801f5498376f250a2b606bdfe580ff7c5943/rpcs3-v0.0.43-20364-4b1a801f_win64_msvc.7z",
            "hash": "b92e2c95ae7fdc32463d4f3f7c9915ca1a8b1ff4adfff284c8dfec57af9790d9"
        },
        "arm64": {
            "url": "https://github.com/RPCS3/rpcs3-binaries-win-arm64/releases/download/build-4b1a801f5498376f250a2b606bdfe580ff7c5943/rpcs3-v0.0.43-20364-4b1a801f_win64_aarch64_clang.7z",
            "hash": "c45ff90eb3b717b2de2d566ffad9e601869a4145f66c1268874936a72b43acc2"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-Item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   New-Item \"$persist_dir\\config.yml\" -ItemType File | Out-Null",
        "   New-Item \"$persist_dir\\games.yml\" -ItemType File | Out-Null",
        "   '[Meta]', 'checkUpdateStart=false' | Set-Content \"$dir\\GuiConfigs\\CurrentSettings.ini\"",
        "}"
    ],
    "bin": "rpcs3.exe",
    "shortcuts": [
        [
            "rpcs3.exe",
            "Sony PlayStation 3 [ps3][rpcs3]"
        ]
    ],
    "persist": [
        "dev_flash",
        "dev_flash2",
        "dev_flash3",
        "dev_hdd0",
        "dev_hdd1",
        "dev_usb000",
        "cache",
        "captures",
        "config.yml",
        "config",
        "firmware",
        "games.yml",
        "GuiConfigs",
        "Icons",
        "patches"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/RPCS3/rpcs3-binaries-win-arm64/releases/latest",
        "jsonpath": "$.assets[?(@.name =~ /rpcs3-v[a-f\\d.-]+_win64_aarch64_clang\\.7z$/)].browser_download_url",
        "regex": "releases/download/(?<build>build-[a-f\\d]+)/rpcs3-v(?<version>[\\d.-]+)-(?<commit>[a-f\\d]+)_win64_aarch64_clang\\.7z"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RPCS3/rpcs3-binaries-win/releases/download/$matchBuild/rpcs3-v$version-$matchCommit_win64_msvc.7z",
                "hash": {
                    "url": "https://github.com/RPCS3/rpcs3-binaries-win/releases/download/$matchBuild/rpcs3-v$version-$matchCommit_win64_msvc.7z.sha256"
                }
            },
            "arm64": {
                "url": "https://github.com/RPCS3/rpcs3-binaries-win-arm64/releases/download/$matchBuild/rpcs3-v$version-$matchCommit_win64_aarch64_clang.7z",
                "hash": {
                    "url": "https://github.com/RPCS3/rpcs3-binaries-win-arm64/releases/download/$matchBuild/rpcs3-v$version-$matchCommit_win64_aarch64_clang.7z.sha256"
                }
            }
        }
    }
}
