                "https://github.com/borkdude/deps.clj/releases/download/v1.12.6.1673/deps.clj-1.12.6.1673-windows-amd64.zip",
                "https://github.com/clojure/brew-install/releases/download/1.12.6.1673/clojure-tools.zip"
            ],
            "hash": [
                "826e2f52657483471bb98013797d9d01df2ddac850ca7182792936cd6b31c834",
                "bb2f8a9f3fa94834813bd437b2a28b857c2f4b7267cb80168c0c6b910f883d4f"
            ]
        }
    },
    "pre_install": [
        "Move-Item \"$dir\\ClojureTools\\*\" \"$dir\\\"",
        "Remove-Item -Path \"$dir\\ClojureTools\",\"$dir\\ClojureTools.psd1\",\"$dir\\ClojureTools.psm1\" -Force -Recurse"
    ],
    "env_set": {
