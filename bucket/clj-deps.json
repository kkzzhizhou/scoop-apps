                "url": [
                    "https://github.com/borkdude/deps.clj/releases/download/v$version/deps.clj-$version-windows-amd64.zip",
                    "https://github.com/clojure/brew-install/releases/download/$matchHead$matchTail/clojure-tools.zip"
                ]
