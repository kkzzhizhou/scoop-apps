{
    "version": "1.0.6",
    "description": "Safety-first disk cleaner and disk space analyzer for macOS and Windows, with duplicate file finder, large file cleanup, app uninstaller, and startup manager",
    "homepage": "https://mangodisk.app/",
    "license": {
        "identifier": "GPL-3.0 license",
        "url": "https://github.com/harry0703/MangoDisk#GPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/harry0703/MangoDisk/releases/download/v1.0.6/MangoDisk-1.0.6-windows.exe#/dl.7z",
            "hash": "eec94da6587ea26f8d7bb0a73ad1bae6ac2b274009d260dc1e5a786e866f363a",
            "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\app.mangodisk.desktop\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\app.mangodisk.desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\app.mangodisk.desktop\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\app.mangodisk.desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "MangoDisk.exe",
    "shortcuts": [
        [
            "MangoDisk.exe",
            "MangoDisk"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/harry0703/MangoDisk/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/harry0703/MangoDisk/releases/download/v$version/MangoDisk-$version-windows.exe#/dl.7z"
            }
        }
    }
}
