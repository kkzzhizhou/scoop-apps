{
    "version": "0.1.38",
    "description": "Desktop companion and tray app for OpenCLI with bundled runtime, Browser Bridge diagnostics, and login keepalive.",
    "homepage": "https://opencli.info/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jackwener/opencli-website/releases/download/app-v0.1.38/OpenCLIApp_0.1.38_x64-setup.exe#/dl.7z",
            "hash": "5923a89855f4a83419e70f3b340aeae66a489b5b5fad688910894ab7965bbe27"
        }
    },
    "pre_install": [
        "Set-Content \"$dir\\opencli.cmd\" '@echo off', '\"%~dp0node_modules\\node\\bin\\node.exe\" \"%~dp0node_modules\\@jackwener\\opencli\\dist\\src\\main.js\" %*' -Encoding ASCII",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\", \"$dir\\uninstall.sh\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": "opencli.cmd",
    "shortcuts": [
        [
            "opencli-app.exe",
            "OpenCLIApp"
        ]
    ],
    "checkver": {
        "url": "https://github.com/jackwener/opencli-website/releases",
        "regex": "releases/tag/app-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jackwener/opencli-website/releases/download/app-v$version/OpenCLIApp_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
