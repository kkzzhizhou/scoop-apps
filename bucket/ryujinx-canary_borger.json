{
    "version": "1.3.356",
    "description": "Nintendo Switch emulator",
    "homepage": "https://ryujinx.app",
    "license": {
        "identifier": "MIT",
        "url": "https://git.ryujinx.app/projects/Ryubing/src/branch/master/LICENSE.txt"
    },
    "notes": "ATTENTION: Ryujinx requires Nintendo Switch firmware and a prod.keys file to function.",
    "architecture": {
        "64bit": {
            "url": "https://git.ryujinx.app/Ryubing/Canary/releases/download/1.3.356/ryujinx-canary-1.3.356-win_x64.zip",
            "hash": "a6d07a4f87aaa5e71a1bbb9779ec32182301813f4e2da2f61d41822c876e0f29"
        }
    },
    "extract_dir": "publish",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-item \"$persist_dir\\portable\" -ItemType Directory | Out-Null",
        "   if (Test-Path \"$env:APPDATA\\Ryujinx\") {",
        "       Write-host \"Migrating AppData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:APPDATA\\Ryujinx\\*\" -Destination \"$persist_dir\\portable\" -Recurse",
        "       Remove-Item -Path \"$env:APPDATA\\Ryujinx\" -Recurse",
        "   }",
        "}"
    ],
    "shortcuts": [
        [
            "Ryujinx.exe",
            "Nintendo Switch [nsw][ryujinx]"
        ]
    ],
    "persist": "portable",
    "checkver": {
        "url": "https://git.ryujinx.app/Ryubing/Canary/releases",
        "regex": "ryujinx-canary-(?<version>\\d+\\.\\d+\\.\\d+)-win_x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://git.ryujinx.app/Ryubing/Canary/releases/download/$version/ryujinx-canary-$version-win_x64.zip"
            }
        }
    }
}
