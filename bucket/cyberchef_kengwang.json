{
    "version": "11.5.0",
    "description": "The Cyber Swiss Army Knife - a web app for encryption, encoding, compression and data analysis",
    "homepage": "https://github.com/gchq/CyberChef",
    "license": "Apache-2.0",
    "checkver": {
        "url": "https://api.github.com/repos/gchq/CyberChef/releases/latest",
        "regex": "releases/download/v([\\d.]+)/CyberChef_(?<commit>[0-9a-f]+)\\.zip"
    },
    "url": "https://github.com/gchq/CyberChef/releases/download/v11.5.0/CyberChef_8cd426dd4f40f1423912d5fad91b578a86a65112.zip",
    "hash": "f6478925d3eaa16ec08626a85f5b85eed10d531a5e18700615fed7ecb024cccf",
    "autoupdate": {
        "url": "https://github.com/gchq/CyberChef/releases/download/v$version/CyberChef_$matchCommit.zip"
    },
    "pre_install": [
        "$content = (Get-Content -Path $(Join-Path $(Find-BucketDirectory -Root -Name $bucket) starters/cyberchef.cmd)) -replace '%%HOME%%', $dir",
        "Set-Content -Path $(Join-Path $dir cyberchef.cmd) -Value $content -Encoding UTF8",
        "Move-Item -Path $(Join-Path $dir CyberChef*.html) -Destination $(Join-Path $dir cyberchef.html) -Force"
    ],
    "bin": "CyberChef.cmd",
    "shortcuts": [
        [
            "CyberChef.html",
            "CyberChef"
        ]
    ]
}
