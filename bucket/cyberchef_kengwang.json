{
    "version": "11.5.0",
    "description": "The Cyber Swiss Army Knife - a web app for encryption, encoding, compression and data analysis",
    "homepage": "https://github.com/gchq/CyberChef",
    "license": "Apache-2.0",
    "checkver": {
        "url": "https://api.github.com/repos/gchq/CyberChef/releases/latest",
        "regex": "releases/download/v([\\d.]+)/CyberChef_(?<commit>[0-9a-f]+)\\.zip"
    },
    "url": "https://github.com/gchq/CyberChef/releases/download/v11.5.0/CyberChef_8cd426dd4f40f1423912d5fad91b578a86a65112.zip",
    "hash": "f6478925d3eaa16ec08626a85f5b85eed10d531a5e18700615fed7ecb024cccf",
    "extract_to": "original",
    "autoupdate": {
        "url": "https://github.com/gchq/CyberChef/releases/download/v$version/CyberChef_$matchCommit.zip"
    },
    "pre_install": [
        "Copy-Item -LiteralPath (Join-Path (Find-BucketDirectory -Root -Name $bucket) 'starters/cyberchef.cmd') -Destination \"$dir/cyberchef.cmd\"",
        "Copy-Item -Path \"$dir/original/CyberChef*.html\" -Destination \"$dir/CyberChef.html\""
    ],
    "post_install": "& (Join-Path (Find-BucketDirectory -Root -Name $bucket) 'scripts/ConvertTo-CyberChefSingleFile.ps1') -InstallDir $dir",
    "notes": "CyberChef.html is repackaged as a single HTML file for direct offline use. The unmodified upstream files are in '$dir\\original'.",
    "bin": "CyberChef.cmd",
    "shortcuts": [
        [
            "CyberChef.html",
            "CyberChef"
        ]
    ]
}
