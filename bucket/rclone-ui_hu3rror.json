{
    "version": "3.7.2",
    "description": "GUI for rclone & S3",
    "homepage": "https://rcloneui.com",
    "license": "Apache-2.0",
    "suggest": {
        "Microsoft Edge WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v3.7.2/Rclone.UI_x64.exe#/dl.7z",
            "hash": "ef0840c4af1d433846512c3ede2b52c630771d3cada27649671ba8325c3b119e"
        },
        "arm64": {
            "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v3.7.2/Rclone.UI_arm64.exe#/dl.7z",
            "hash": "accdb529501adc83065c5afa3bf4cb0060e9a3c333a95433d016807821db50a1"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Force -Recurse",
    "persist_external": [
        [
            "$env:APPDATA\\com.rclone.ui",
            "data",
            "directory"
        ],
        [
            "$env:LOCALAPPDATA\\com.rclone.ui",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalInstall -Manifest $manifest -PersistDir $persist_dir -Dir $dir"
    ],
    "pre_uninstall": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalUninstall -Manifest $manifest -Dir $dir"
    ],
    "bin": [
        [
            "Rclone UI.exe",
            "rclone-ui"
        ]
    ],
    "shortcuts": [
        [
            "Rclone UI.exe",
            "Rclone UI"
        ]
    ],
    "checkver": {
        "github": "https://github.com/rclone-ui/rclone-ui"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v$version/Rclone.UI_x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/rclone-ui/rclone-ui/releases/download/v$version/Rclone.UI_arm64.exe#/dl.7z"
            }
        }
    }
}
