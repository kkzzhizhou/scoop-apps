{
	"version": "1.14.0-beta.12",
	"description": "The universal proxy platform (latest one no matter pre-release or release).",
	"homepage": "https://sing-box.sagernet.org/",
	"license": "GPL-3.0-or-later",
	"notes": [
		"If you want to use TUN mode, please run sing-box with administrator privileges.",
		"Your configuration and cache files are persisted in '$persist_dir'.",
		"You can run with a directory of configs using: 'sing-box run -C $persist_dir\\config.d'"
	],
	"architecture": {
		"64bit": {
			"url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.0-beta.12/sing-box-1.14.0-beta.12-windows-amd64.zip",
			"hash": "30f962d9db7a8060d8fe176db2b93224a85a19481b6634888d4eca2dfc346491",
			"extract_dir": "sing-box-1.14.0-beta.12-windows-amd64"
		},
		"32bit": {
			"url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.0-beta.12/sing-box-1.14.0-beta.12-windows-386.zip",
			"hash": "db563ba4eab154bbc16dec0dcd724480359b8e83f6db8582abdb90ee9f0a15b7",
			"extract_dir": "sing-box-1.14.0-beta.12-windows-386"
		},
		"arm64": {
			"url": "https://github.com/SagerNet/sing-box/releases/download/v1.14.0-beta.12/sing-box-1.14.0-beta.12-windows-arm64.zip",
			"hash": "77e55fb60367fe1ed920d23e662fc13049a0e01fd29f0a95a211f1fb79800726",
			"extract_dir": "sing-box-1.14.0-beta.12-windows-arm64"
		}
	},
	"pre_install": [
		"if (!(Test-Path \"$persist_dir\")) { New-Item -Path \"$persist_dir\" -ItemType Directory | Out-Null }",
		"if (!(Test-Path \"$persist_dir\\config.json\")) {",
		"   $utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
		"   [System.IO.File]::WriteAllText(\"$persist_dir\\config.json\", \"{}`n\", $utf8NoBom)",
		"}",
		"if (!(Test-Path \"$persist_dir\\cache.db\")) { New-Item -Path \"$persist_dir\\cache.db\" -ItemType File | Out-Null }"
	],
	"bin": "sing-box.exe",
	"persist": ["config", "config.d", "config.json", "cache.db"],
	"checkver": {
		"script": [
			"$rel_info = Invoke-RestMethod -Uri 'https://api.github.com/repos/SagerNet/sing-box/releases'",
			"$latest = $rel_info | Where-Object { $_.prerelease } | Sort-Object { $_.published_at } | Select-Object -last 1",
			"Write-Output $latest.tag_name"
		],
		"regex": "v(?<version>[^\\s]+)"
	},
	"autoupdate": {
		"architecture": {
			"64bit": {
				"url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-amd64.zip",
				"extract_dir": "sing-box-$version-windows-amd64"
			},
			"32bit": {
				"url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-386.zip",
				"extract_dir": "sing-box-$version-windows-386"
			},
			"arm64": {
				"url": "https://github.com/SagerNet/sing-box/releases/download/v$version/sing-box-$version-windows-arm64.zip",
				"extract_dir": "sing-box-$version-windows-arm64"
			}
		}
	}
}
