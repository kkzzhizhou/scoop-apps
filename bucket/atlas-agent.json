{
    "version": "1.1.0",
    "description": "A general-purpose AI agent desktop app built in Go",
    "homepage": "https://github.com/gvenusleo/Atlas",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/gvenusleo/Atlas/releases/download/v1.1.0/atlas-1.1.0-windows-amd64.tar.gz",
            "hash": "415eb6f7411464cc535e8ca645429d207c8601e325a23693666b318d3300d1a9"
        },
        "arm64": {
            "url": "https://github.com/gvenusleo/Atlas/releases/download/v1.1.0/atlas-1.1.0-windows-arm64.tar.gz",
            "hash": "967597c47192581e47b1f3635eb76982ff0d4aa8d6a19868e183cf51ff8c55a7"
        }
    },
    "bin": "Atlas.exe",
    "shortcuts": [
        [
            "Atlas.exe",
            "Atlas"
        ]
    ],
    "notes": [
        "Atlas keeps all settings and session data in %USERPROFILE%\\.atlas\\ (settings.json, auth.json, AGENTS.md, gui.json, schedule.json, atlas.db). This folder is outside the Scoop directory, so it is not managed by Scoop and survives updates automatically.",
        "API keys are read only from %USERPROFILE%\\.atlas\\auth.json, not from environment variables.",
        "The app has a built-in updater; leave it disabled so that Scoop remains the single source of truth for updates."
    ],
    "checkver": {
        "github": "https://github.com/gvenusleo/Atlas"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gvenusleo/Atlas/releases/download/v$version/atlas-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/gvenusleo/Atlas/releases/download/v$version/atlas-$version-windows-arm64.tar.gz"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "([a-fA-F0-9]{64})\\s+$basename"
        }
    }
}
