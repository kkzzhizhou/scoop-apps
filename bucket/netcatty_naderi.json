{
    "version": "1.1.88",
    "description": "A beautiful, feature-rich SSH workspace built with Electron, React, and xterm.js.",
    "homepage": "https://netcatty.app/",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/binaricat/Netcatty/releases/download/v1.1.88/Netcatty-1.1.88-win-x64.exe#/dl.7z",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "hash": "bf00ebad4ecb28b59e578b0c2a67af9bbecce4ee594f41aba965c3a8dd4fc3ec"
        }
    },
    "shortcuts": [
        [
            "Netcatty.exe",
            "Netcatty"
        ]
    ],
    "post_install": "Remove-Item \"$dir\\uninstall*\", \"$dir\\`$*\", \"$dir\\resources\\app-update.yml\" -Force -Recurse -ErrorAction SilentlyContinue",
    "post_uninstall": "if ($purge) { Remove-Item \"$env:APPDATA\\netcatty\" -Force -Recurse -ErrorAction SilentlyContinue }",
    "notes": [
        "Netcatty is NOT portable.",
        "Settings are stored in '%APPDATA%\\netcatty', and will be purged during uninstallation with --purge flag."
    ],
    "checkver": {
        "url": "https://github.com/binaricat/Netcatty/releases.atom",
        "regex": "Repository/\\d+/v(.+?)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/binaricat/Netcatty/releases/download/v$version/Netcatty-$version-win-x64.exe#/dl.7z"
            }
        }
    }
}
