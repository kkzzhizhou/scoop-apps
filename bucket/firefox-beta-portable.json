    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0b4/win64/en-US/Firefox%20Setup%20156.0b4.exe#/dl.7z",
            "hash": "sha512:72fa3fb26979d41f77eddb6cdf1e6a703f4da00dd6875aa84df7d85a14fe8dd51040f504c7ba8f5eeed780b8334c6aadf698f92de70defe4b886f3f2544b9547"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0b4/win32/en-US/Firefox%20Setup%20156.0b4.exe#/dl.7z",
            "hash": "sha512:504d583049d6f1cc0d5142d121521b8571d0ddf88f1f2f416f7096543327bf5886beb889c35bb8a78d17b192bdc5ad7b9ff211d2756f3866d464f32ec56893df"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox Beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_DEVEL_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
