{
    "version": "157.0b2",
    "description": "Beta builds of Firefox: the popular open source web browser.",
    "homepage": "https://www.mozilla.org/en-US/firefox/beta/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/157.0b2/win64/en-US/Firefox%20Setup%20157.0b2.exe#/dl.7z",
            "hash": "sha512:6eada71086970a6c7c094b328b8b1c30b4aed050932920d6872b2d3cf60f43a694cac44a07d3a27180590f8a80a93627545ba8ad235953dffa8defcbbf71175e"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/157.0b2/win32/en-US/Firefox%20Setup%20157.0b2.exe#/dl.7z",
            "hash": "sha512:be23bddb03192274bfacbe9100e90c0797d331a24f8ca393ddda3798809215269bebaa7e6a78a3152d3edd1da4169c841d19d9761a88c71a9be3773872b1c32e"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox Beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_DEVEL_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
