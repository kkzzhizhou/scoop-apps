{
    "version": "155.0b3",
    "description": "Beta builds of Firefox: the popular open source web browser.",
    "homepage": "https://www.mozilla.org/en-US/firefox/beta/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/155.0b3/win64/en-US/Firefox%20Setup%20155.0b3.exe#/dl.7z",
            "hash": "sha512:96d9ace13c56c7459145c530377bd8aa471bfa4050f7951999f69388ee312154eccc162e1de135ae36a173b8c78bf14f2666a88bb6a0b9094ec52280d1bb91cb"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/155.0b3/win32/en-US/Firefox%20Setup%20155.0b3.exe#/dl.7z",
            "hash": "sha512:2e3cbd727a5ab294525adf2a337fd2ba9fac7a26492122b9116238b14bd925a69d020236ca38a641077060216aa6ce881aeb6e5b93e9766e5ed308efc12c75ef"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox Beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_DEVEL_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
