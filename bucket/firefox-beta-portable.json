            "hash": "sha512:1c496cd3fc58d61eb905fead8b663d322d884acd3c3bb9d76ab245891e1b689c34013c95edaca8e655ec3c06863626f337ed547f78661786d961342017166761"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0b3/win32/en-US/Firefox%20Setup%20156.0b3.exe#/dl.7z",
            "hash": "sha512:1434fe91895b6e136a280cd80f4caaca597470530a1aa038716ca7d0759959eacfa607652a4e9a8322cc99eb7dc2c77ed7a4514e2c337da8bb41c3704fcd7cd9"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-beta",
            "-profile \"$dir\\profile\""
