            "hash": "sha512:f8f3643f6b15d31f634489f5b4c91b92cda388f0f7b470105a333ea6b7c235ac065ac235a239659bb04be9b8ac1dd7ab511ce2fd3f9dd388259cb039e5b717fd"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/155.0b5/win32/en-US/Firefox%20Setup%20155.0b5.exe#/dl.7z",
            "hash": "sha512:470aa92f53e49885b1f0c8b9e8c9756448f8d89c8c6d5ad815e665228abea00e51864784f4c0f6348307195507f5c5998d99d1620f404082d5782fdaea4d549c"
