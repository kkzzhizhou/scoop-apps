            "hash": "sha512:6218e01cde35c14db690bd278ad677924cd634770cba28b290b9cabef5e7cea4bd61de1d035ff117b2edcbd446c19f43d2be4d5f8c71e738444e233605021756"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0b5/win32/en-US/Firefox%20Setup%20154.0b5.exe#/dl.7z",
            "hash": "sha512:5bff963e287f0d5238924f6cdbccbf8456ca1bc4a1189424330a35ce5ef75df7f92e7783783684df26e6b0c308b98096db07f42282f434b9df10f54727c5e19a"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox Beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_DEVEL_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
