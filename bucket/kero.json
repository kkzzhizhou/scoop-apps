{
    "version": "2.1.36",
    "description": "A cross-platform native terminal app optimized for agents",
    "homepage": "https://kero.sh",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/egoist/kero/releases/download/v2.1.36/kero-2.1.36-windows-amd64.tar.gz",
            "hash": "8cef48e32d9e565ed4d4da2b965772819d790b7ae44836a65b1602a17f0211d4"
        },
        "arm64": {
            "url": "https://github.com/egoist/kero/releases/download/v2.1.36/kero-2.1.36-windows-arm64.tar.gz",
            "hash": "d151ff0b704738a869b5d2558019c5e12f39688393b67e6a96c2d0d9396abf9a"
        }
    },
    "bin": "Kero.exe",
    "persist_external": "$env:AppData\\kero",
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "shortcuts": [
        [
            "Kero.exe",
            "Kero"
        ]
    ],
    "notes": "Install the command line tool from Kero's menu: Kero > Install Command Line Tool...",
    "checkver": {
        "github": "https://github.com/egoist/kero"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/egoist/kero/releases/download/v$version/kero-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/egoist/kero/releases/download/v$version/kero-$version-windows-arm64.tar.gz"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
