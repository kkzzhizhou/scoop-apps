{
    "version": "8.1.4.0",
    "homepage": "https://www.ghxi.com/neatreader.html",
    "description": "Neat Reader Green",
    "license": "Freeware",
    "url": "https://cloud-index-x7k4m9q2.vercel.app/api/raw/?path=/packages/scoop/NeatReader_8.1.4.0.7z#/dl.7z_",
    "hash": "b54f9c8802b5eae9dffb3b580cfd048b0378521c96902873896e18b759cf2dfb",
    "pre_install": "Expand-7zipArchive -Path \"$dir\\dl.7z_\" -DestinationPath \"$dir\" -Removal -Switches '-pmuggle'",
    "persist_external": [
        "$env:AppData\\NeatReader"
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "shortcuts": [
        [
            "NeatReader.exe",
            "Neat Reader"
        ]
    ]
}
