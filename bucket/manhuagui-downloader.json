        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "bin": "manhuagui-downloader.exe",
    "shortcuts": [
        [
            "manhuagui-downloader.exe",
            "Manhuagui Downloader"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lanyeeee/manhuagui-downloader/releases/download/v$version/manhuagui-downloader_$version_windows_x64_portable.zip"
