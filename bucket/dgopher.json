{
    "version": "0.7.2",
    "description": "Fast, open-source database client for PostgreSQL, MySQL, ClickHouse, SQLite, DuckDB and Redis",
    "homepage": "https://github.com/saanuregh/dgopher",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/saanuregh/dgopher/releases/download/v0.7.2/DGopher-Setup-0.7.2-amd64.exe#/dl.7z",
            "hash": "3284be7eb0ed1884fea59038c373a82d9a1c64d355080b8d95ecfd92ba939c5a"
        }
    },
    "bin": "DGopher.exe",
    "shortcuts": [
        [
            "DGopher.exe",
            "DGopher"
        ]
    ],
    "pre_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force -ErrorAction SilentlyContinue",
        "if (!(Test-Path \"$dir\\config\")) { New-Item -ItemType Directory -Path \"$dir\\config\" | Out-Null }",
        "if (!(Test-Path \"$dir\\data\")) { New-Item -ItemType Directory -Path \"$dir\\data\" | Out-Null }"
    ],
    "persist": [
        "config",
        "data"
    ],
    "env_set": {
        "DGOPHER_CONFIG_DIR": "$persist_dir\\config",
        "DGOPHER_DATA_DIR": "$persist_dir\\data"
    },
    "checkver": {
        "github": "https://github.com/saanuregh/dgopher"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/saanuregh/dgopher/releases/download/v$version/DGopher-Setup-$version-amd64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "$basename"
        }
    }
}
