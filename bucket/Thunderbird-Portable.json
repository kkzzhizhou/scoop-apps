    "license": "MPL-2.0",
    "changelog": "https://www.thunderbird.net/en-US/thunderbird/91.3.2/releasenotes/#changes",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/154.0/win64/en-US/Thunderbird%20Setup%20154.0.exe#/dl.7z",
            "hash": "sha512:5ba58e609bf324643336bf264d3142c03a4455293c154e1ad38c6f57a6d62664b95f94a81903ea3ddb156888450450a0dd4449cd27bedc8dba144937d2c38841"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/154.0/win32/en-US/Thunderbird%20Setup%20154.0.exe#/dl.7z",
            "hash": "sha512:4d0abc0121e32e057c8aa5bc210182b8017dbbd4cff2e1c074560dae68ded5f782db00e4f0766423393655c3d0d731324b5a53693da5754960518dc0e945f98b"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "thunderbird.exe",
            "thunderbird",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "thunderbird.exe",
            "Mozilla Thunderbird",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://www.thunderbird.net/en-US/thunderbird/releases/",
        "regex": "defaultLatestVersion: '([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/win64/en-US/Thunderbird%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/win32/en-US/Thunderbird%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
