            "hash": "fe6c356747f17ea138cc4e841a5b9264598ca2650299119f54c1800d67a981a8",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        },
        "arm64": {
            "url": "https://github.com/stark81/VutronMusic/releases/download/v4.0.0/VutronMusic-4.0.0_win_arm64.exe#/dl.7z",
            "hash": "sha512:ff2a77235ebf38fcff762c7e23c6643a3b2d99798991d2dbce0848ce56d5ec9ff3e7f778a4e148cf0bff3684eeb79ef04f3b4c5b68f2b74fc478935204dc5024",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\VutronMusic\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\VutronMusic\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "VutronMusic.exe",
    "shortcuts": [
        [
            "VutronMusic.exe",
            "VutronMusic"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/stark81/VutronMusic/releases",
        "jsonpath": "$[0].assets[*].browser_download_url",
        "regex": "/releases/download/(?<tag>[\\w.-]+)/VutronMusic-([\\d.]+)_win_x64.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/stark81/VutronMusic/releases/download/$matchTag/VutronMusic-$version_win_x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "mode": "extract",
                    "regex": "(?sm)$basename.*?sha512:\\s+$base64"
                }
            },
            "arm64": {
                "url": "https://github.com/stark81/VutronMusic/releases/download/$matchTag/VutronMusic-$version_win_arm64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "mode": "extract",
                    "regex": "(?sm)$basename.*?sha512:\\s+$base64"
                }
            }
        }
    }
