{
    "version": "0.4.400",
    "description": "GUI client for herdr: Claude Code, Codex and pi agent sessions as clean chats.",
    "homepage": "https://alma.now",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yetone/alma-releases/releases/download/v0.4.400/alma-0.4.400-win-x64.exe#/dl.7z",
            "hash": "sha512:ed449786b532616027f9b8aa0c445c8f6feb84c03914d0034bce7af92901278091a7cc4a0a63370017a4d183b699a8eb392532d3f4107d040b55f9a120b3e0d2",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
            ]
        }
    },
    "persist_external": [
        [
            "$env:AppData\\alma",
            "data",
            "directory"
        ],
        [
            "$env:USERPROFILE\\.config\\alma",
            "config",
            "directory"
        ],
        [
            "$env:USERPROFILE\\.alma",
            "activity",
            "directory"
        ],
        [
            "$env:USERPROFILE\\.cache\\alma",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalUninstall"
    ],
    "shortcuts": [
        [
            "Alma.exe",
            "Alma"
        ]
    ],
    "checkver": {
        "github": "https://github.com/yetone/alma-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yetone/alma-releases/releases/download/v$version/alma-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "$basename\\s+sha512:\\s+$base64"
        }
    }
}
