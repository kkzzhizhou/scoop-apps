{
    "version": "2.2.1",
    "description": "A CLI-based Bilibili downloader. A continuation of bbdown.",
    "homepage": "https://github.com/LOVAHE/BBDownT",
    "license": "MIT",
    "suggest": {
        "FFmpeg": [
            "main/ffmpeg",
            "main/ffmpeg-essentials",
            "main/ffmpeg-shared"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.2.1/BBDownT_win-x64.exe#/BBDownT.exe",
            "hash": "fa6a9cefaa24b5d940b13cbc9e418f3df5aa14774ceab232a277b90115330d09"
        },
        "arm64": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.2.1/BBDownT_win-arm64.exe#/BBDownT.exe",
            "hash": "455eac68a2cab3207a866b0d05f583e26393d170fd2b87f7fa807a1c25508e62"
        }
    },
    "pre_install": [
        "@('BBDownT.archives', 'BBDownT.config', 'BBDownT.data', 'BBDownTApp.data', 'BBDownTTV.data') | ForEach-Object {",
        "    if (!(Test-Path -Path \"$persist_dir\\$_\")) {",
        "        New-Item -Path \"$dir\\$_\" -ItemType File -Force | Out-Null",
        "    }",
        "}"
    ],
    "bin": "BBDownT.exe",
    "persist": [
        "BBDownT.archives",
        "BBDownT.config",
        "BBDownT.data",
        "BBDownTApp.data",
        "BBDownTTV.data"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-x64.exe#/BBDownT.exe"
            },
            "arm64": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-arm64.exe#/BBDownT.exe"
            }
        }
    }
}
