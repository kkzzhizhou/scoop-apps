{
    "version": "2.1.0",
    "description": "A CLI-based Bilibili downloader. A continuation of bbdown.",
    "homepage": "https://github.com/LOVAHE/BBDownT",
    "license": "MIT",
    "suggest": {
        "FFmpeg": [
            "main/ffmpeg",
            "main/ffmpeg-essentials",
            "main/ffmpeg-shared"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.0/BBDownT_win-x64.exe#/BBDownT.exe",
            "hash": "c04be3f1ebde0b54072dc60ae8b22706b8f2a480622c3cc8abb5acb9102128da"
        },
        "arm64": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.0/BBDownT_win-arm64.exe#/BBDownT.exe",
            "hash": "921271621edae883139b622f3b018ed4f36ca13752bc564823d752e1e287e657"
        }
    },
    "pre_install": [
        "@('BBDownT.archives', 'BBDownT.config', 'BBDownT.data', 'BBDownTApp.data', 'BBDownTTV.data') | ForEach-Object {",
        "    if (!(Test-Path -Path \"$persist_dir\\$_\")) {",
        "        New-Item -Path \"$dir\\$_\" -ItemType File -Force | Out-Null",
        "    }",
        "}"
    ],
    "bin": "BBDownT.exe",
    "persist": [
        "BBDownT.archives",
        "BBDownT.config",
        "BBDownT.data",
        "BBDownTApp.data",
        "BBDownTTV.data"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-x64.exe#/BBDownT.exe"
            },
            "arm64": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-arm64.exe#/BBDownT.exe"
            }
        }
    }
}
