{
    "version": "2.1.6",
    "description": "A CLI-based Bilibili downloader. A continuation of bbdown.",
    "homepage": "https://github.com/LOVAHE/BBDownT",
    "license": "MIT",
    "suggest": {
        "FFmpeg": [
            "main/ffmpeg",
            "main/ffmpeg-essentials",
            "main/ffmpeg-shared"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.6/BBDownT_win-x64.exe#/BBDownT.exe",
            "hash": "9be1033bb24406123923fabd675c13ba5cc2ec42b4ce954f466c4b82ab3f87e2"
        },
        "arm64": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.6/BBDownT_win-arm64.exe#/BBDownT.exe",
            "hash": "890f2580a8c5296b51ad335fc90e601fa19b239ce616a3913171d85567e5aef5"
        }
    },
    "pre_install": [
        "@('BBDownT.archives', 'BBDownT.config', 'BBDownT.data', 'BBDownTApp.data', 'BBDownTTV.data') | ForEach-Object {",
        "    if (!(Test-Path -Path \"$persist_dir\\$_\")) {",
        "        New-Item -Path \"$dir\\$_\" -ItemType File -Force | Out-Null",
        "    }",
        "}"
    ],
    "bin": "BBDownT.exe",
    "persist": [
        "BBDownT.archives",
        "BBDownT.config",
        "BBDownT.data",
        "BBDownTApp.data",
        "BBDownTTV.data"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-x64.exe#/BBDownT.exe"
            },
            "arm64": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-arm64.exe#/BBDownT.exe"
            }
        }
    }
}
