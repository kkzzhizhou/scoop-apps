{
    "version": "2.1.1",
    "description": "A CLI-based Bilibili downloader. A continuation of bbdown.",
    "homepage": "https://github.com/LOVAHE/BBDownT",
    "license": "MIT",
    "suggest": {
        "FFmpeg": [
            "main/ffmpeg",
            "main/ffmpeg-essentials",
            "main/ffmpeg-shared"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.1/BBDownT_win-x64.exe#/BBDownT.exe",
            "hash": "383f4f003d534d500739bab897002848e93effabb3f2f8fe882bd49ce3c44cad"
        },
        "arm64": {
            "url": "https://github.com/LOVAHE/BBDownT/releases/download/v2.1.1/BBDownT_win-arm64.exe#/BBDownT.exe",
            "hash": "dc225189741bf46bcd963e1f5faeed0f8d8aa609ee876fdddb89e1130c803e7c"
        }
    },
    "pre_install": [
        "@('BBDownT.archives', 'BBDownT.config', 'BBDownT.data', 'BBDownTApp.data', 'BBDownTTV.data') | ForEach-Object {",
        "    if (!(Test-Path -Path \"$persist_dir\\$_\")) {",
        "        New-Item -Path \"$dir\\$_\" -ItemType File -Force | Out-Null",
        "    }",
        "}"
    ],
    "bin": "BBDownT.exe",
    "persist": [
        "BBDownT.archives",
        "BBDownT.config",
        "BBDownT.data",
        "BBDownTApp.data",
        "BBDownTTV.data"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-x64.exe#/BBDownT.exe"
            },
            "arm64": {
                "url": "https://github.com/LOVAHE/BBDownT/releases/download/v$version/BBDownT_win-arm64.exe#/BBDownT.exe"
            }
        }
    }
}
