{
    "version": "0.45",
    "description": "シンプルで高速な単画面型の画像ビューワ",
    "homepage": "http://www.massigra.net/",
    "license": "Freeware",
    "url": [
        "https://ftp.vector.co.jp/60/45/1855/MassiGra045.zip",
        "https://ftp.vector.co.jp/60/45/1855/MassiGra045Help.zip"
    ],
    "hash": [
        "76f28cf65e900778ae0f67d41ea324d35d0ec162624dcf50ada3e44ce831ca25",
        "e19e74666205fbacc221970f7c5b7a7354863f7ea5f8eca2d4fa1e61edbf6a9e"
    ],
    "pre_install": "ensure \"$persist_dir\\user\"",
    "persist": "user",
    "shortcuts": [
        [
            "MassiGra.exe",
            "MassiGra"
        ]
    ],
    "checkver": {
        "script": [
            "$ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/103.0.5060.114 Safari/537.36 Edg/103.0.1264.49'",
            "$headers = @{ 'user-agent' = $ua }",
            "$page = (Invoke-WebRequest -UseBasicParsing -Uri 'https://www.vector.co.jp/soft/dl/win95/art/se400675.html' -Headers $headers).Content",
            "$ver = [regex]::Match($page, 'MassiGra<span class=\"version\">([\\d\\.]+)</span>').Groups[1].Value",
            "$soft = ''",
            "$help = ''",
            "foreach ($link in [regex]::Matches($page, '/download/file/win95/art/[\\w\\d]+\\.html').Value) {",
            "    $filePage = (Invoke-WebRequest -UseBasicParsing -Uri \"https://www.vector.co.jp$link\" -Headers $headers).Content",
            "    if (!$soft) { $soft = [regex]::Match($filePage, 'https://ftp\\.vector\\.co\\.jp/[\\d/]+MassiGra[\\d]+\\.zip').Value }",
            "    if (!$help) { $help = [regex]::Match($filePage, 'https://ftp\\.vector\\.co\\.jp/[\\d/]+MassiGra[\\d]+Help\\.zip').Value }",
            "}",
            "if ($ver -and $soft -and $help) { \"$ver $soft $help\" }"
        ],
        "regex": "^([\\d\\.]+)\\s+(?<soft>\\S+)\\s+(?<help>\\S+)$"
    },
    "autoupdate": {
        "url": [
            "$matchSoft",
            "$matchHelp"
        ]
    }
}
