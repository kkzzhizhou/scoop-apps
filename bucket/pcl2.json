{
    "version": "2.99.0.1",
    "description": "Minecraft 启动器：Plain Craft Launcher。超快的下载速度，下载安装 Mod 和整合包，简洁且高度自定义的界面，流畅精细的动画……总之很棒就完事啦！",
    "homepage": "https://github.com/Hex-Dragon/PCL2",
    "license": "https://github.com/Hex-Dragon/PCL2/blob/main/LICENCE",
    "url": "https://raw.githubusercontent.com/Hex-Dragon/PCL2/main/%E6%9C%80%E6%96%B0%E6%AD%A3%E5%BC%8F%E7%89%88.zip",
    "hash": "4d239a62ed66fb9ebcf4633fd881eb098e9a7e4f296f0e414b58aa2f1f7f7830",
    "shortcuts": [
        [
            "Plain Craft Launcher 2.exe",
            "PCL2"
        ]
    ],
    "persist": [
        "PCL",
        ".minecraft"
    ],
    "pre_install": [
        "$reg_data = \"$persist_dir\\PCL2.reg\"",
        "if (Test-Path -Path $reg_data) {",
        "    reg.exe import \"$reg_data\" | Out-Null",
        "}"
    ],
    "post_install": [
        "$target = \"$env:APPDATA\\PCL\"",
        "$source = \"$persist_dir\\AppData_PCL\"",
        "if (-not (Test-Path $source)) { New-Item -Path $source -ItemType Directory -Force | Out-Null }",
        "if (Test-Path $target) {",
        "    $item = Get-Item $target -ErrorAction SilentlyContinue",
        "    if ($item.LinkType -eq 'Junction') {",
        "        Remove-Item $target -Force",
        "    } else {",
        "        Get-ChildItem $target -Force | Move-Item -Destination $source -Force",
        "        Remove-Item $target -Force -Recurse",
        "    }",
        "}",
        "New-Item -Path $target -ItemType Junction -Value $source -Force | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$reg_path = \"HKEY_CURRENT_USER\\Software\\PCL\"",
            "$reg_data = \"$persist_dir\\PCL2.reg\"",
            "if (Test-Path \"Registry::$reg_path\") {",
            "    reg.exe export \"$reg_path\" \"$reg_data\" /y | Out-Null",
            "    Remove-Item \"Registry::$reg_path\" -Recurse -Force -ErrorAction SilentlyContinue",
            "}",
            "$target = \"$env:APPDATA\\PCL\"",
            "if (Test-Path $target) {",
            "    $item = Get-Item $target -ErrorAction SilentlyContinue",
            "    if ($item.LinkType -eq 'Junction') {",
            "        Remove-Item $target -Force",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.github.com/repos/Hex-Dragon/PCL2/commits?path=%E6%9C%80%E6%96%B0%E6%AD%A3%E5%BC%8F%E7%89%88.zip&per_page=1",
        "jsonpath": "$.[0].commit.message",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/Hex-Dragon/PCL2/main/%E6%9C%80%E6%96%B0%E6%AD%A3%E5%BC%8F%E7%89%88.zip"
    }
}
