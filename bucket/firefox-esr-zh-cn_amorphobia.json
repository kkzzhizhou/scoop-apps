        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/153.8.0esr/win32/zh-CN/Firefox%20Setup%20153.8.0esr.exe#/dl.7z",
            "hash": "sha512:425b13bc379e626b5ef5f41a4081141ef861bbe4b45f36d56b86806bbd08ed740c060c848561fe9e6ad07cbb0b373f62af38023a28a31d8febec08db7be4f786"
