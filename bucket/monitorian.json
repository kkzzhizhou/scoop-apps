{
    "version": "4.16.11",
    "description": "A Windows desktop tool to adjust the brightness of multiple monitors with ease.",
    "homepage": "https://github.com/emoacht/Monitorian",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/emoacht/Monitorian/releases/download/4.16.11-Installer/MonitorianInstaller41611.zip",
            "hash": "ff02e95a955d6aa2e83b20b11434b21f3c8659cb78caf06b719351e5ae8e2855"
        }
    },
    "pre_install": "Expand-MsiArchive \"$dir\\Monitorian.Installer.msi\" $dir -ExtractDir 'PFiles\\Monitorian' -Removal",
    "post_install": [
        "# 数据迁移：LocalAppData\\Monitorian",
        "$link = \"$env:LocalAppData\\Monitorian\"",
        "$target = ensure \"$persist_dir\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}"
    ],
    "bin": "Monitorian.exe",
    "shortcuts": [
        [
            "Monitorian.exe",
            "Monitorian"
        ]
    ],
    "pre_uninstall": [
        "$registryKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "if ($cmd -eq 'uninstall') {",
        "    Remove-ItemProperty $registryKey -Name 'Monitorian' -ErrorAction SilentlyContinue",
        "}"
    ],
    "post_uninstall": [
        "# 删除数据软连接",
        "$link = \"$env:LocalAppData\\Monitorian\"",
        "Remove-Item -Path $link -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "github": "https://github.com/emoacht/Monitorian",
        "regex": "([\\d.]+)-Installer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/emoacht/Monitorian/releases/download/$version-Installer/MonitorianInstaller$cleanVersion.zip"
            }
        }
    }
}
