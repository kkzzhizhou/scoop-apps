{
    "homepage": "https://www.mozilla.org/ja/firefox/new/",
    "version": "156.0.1",
    "architecture": {
        "64bit": {
            "url": "https://download.mozilla.org/?product=firefox-156.0.1-SSL&os=win64&lang=ja#/firefox-setup.exe",
            "hash": "0d57cba1baebb5e6a7da7de96aad717abd538f48bded9a372a3110bf2cb074f1"
        },
        "32bit": {
            "url": "https://download.mozilla.org/?product=firefox-156.0.1-SSL&os=win&lang=ja#/firefox-setup.exe",
            "hash": "12c2ea5fa1b44163370f7f36f80e419ba680b6820487a70d10b8f7a168459dfc"
        }
    },
    "bin": "firefox.exe",
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox"
        ],
        [
            "firefox.exe",
            "Firefox Profile Manager",
            "-P"
        ]
    ],
    "pre_install": "echo \"[Install]`nInstallDirectoryPath=$dir`nQuickLaunchShortcut=false`nDesktopShortcut=false`nStartMenuShortcuts=false\" | sc \"$dir\\install.ini\"",
    "installer": {
        "file": "firefox-setup.exe",
        "args": "/INI=$dir\\install.ini"
    },
    "uninstaller": {
        "file": "uninstall\\helper.exe",
        "args": "/S"
    },
    "checkver": {
        "url": "https://www.mozilla.org/ja/firefox/notes/",
        "re": "data-latest-firefox=\"([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.mozilla.org/?product=firefox-$version-SSL&os=win64&lang=ja#/firefox-setup.exe",
                "hash": {
                    "find": "([a-fA-F0-9]{64})\\s+(?:win64/ja/Firefox Setup ([\\d.]+).exe)",
                    "url": "https://download-installer.cdn.mozilla.net/pub/firefox/releases/$version/SHA256SUMS"
                }
            },
            "32bit": {
                "url": "https://download.mozilla.org/?product=firefox-$version-SSL&os=win&lang=ja#/firefox-setup.exe",
                "hash": {
                    "find": "([a-fA-F0-9]{64})\\s+(?:win32/ja/Firefox Setup ([\\d.]+).exe)",
                    "url": "https://download-installer.cdn.mozilla.net/pub/firefox/releases/$version/SHA256SUMS"
                }
            }
        }
    }
}
