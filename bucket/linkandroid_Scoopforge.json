            "hash": "75b23d4c7a480a7309beed76705a828e1838029dd34bb55cbf04d3b8c4a5ab02",
            "pre_install": [
                "7z x $original_dir/PLUGINSDIR/app-64.7z -o\"$original_dir\""
            ]
        },
        "arm64": {
            "url": "https://github.com/modstart-lib/linkandroid/releases/download/v2.1.0/LinkAndroid-2.1.0-win-setup-arm64.exe#/dl.7z",
            "hash": "4893c207a4d7b2f830043ed4ec6efb89fe5b1026739437aff2a82b3bf728a841",
            "pre_install": [
                "7z x $original_dir/PLUGINSDIR/app-arm64.7z -o\"$original_dir\""
            ]
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name extras-cn) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\linkandroid\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name extras-cn) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\linkandroid\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "shortcuts": [
        [
            "LinkAndroid.exe",
            "LinkAndroid"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/modstart-lib/linkandroid/releases/latest",
        "regex": "/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/modstart-lib/linkandroid/releases/download/v$version/LinkAndroid-$version-win-setup-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/modstart-lib/linkandroid/releases/download/v$version/LinkAndroid-$version-win-setup-arm64.exe#/dl.7z"
            }
        }
    }
