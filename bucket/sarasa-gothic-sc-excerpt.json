{
    "version": "1.0.43",
    "description": "CJK programming font based on Iosevka and Source Han Sans",
    "homepage": "https://github.com/be5invis/Sarasa-Gothic",
    "license": "OFL-1.1",
    "notes": [
        "仅节选了以下字体：",
        "  更纱黑体 UI SC：常规, 半粗体",
        "  等距更纱黑体 SC：常规, 粗体, 粗斜体, 斜体",
        "如果需要重建字体缓存, 请在管理员模式下运行以下命令",
        "1. 停止字体缓存服务:",
        "Stop-Service -Name FontCache",
        "2. 删除字体缓存文件",
        "Get-ChildItem -Path $env:windir\\ServiceProfiles\\LocalService\\AppData\\Local\\FontCache -File | foreach { $_.Delete() }",
        "Remove-Item -Path $env:windir\\System32\\FNTCACHE.DAT -Force",
        "3. 启动字体缓存服务",
        "Start-Service -Name FontCache"
    ],
    "url": [
        "https://github.com/be5invis/Sarasa-Gothic/releases/download/v1.0.43/SarasaUiSC-TTF-1.0.43.7z#/SarasaUiSC.7z_",
        "https://github.com/be5invis/Sarasa-Gothic/releases/download/v1.0.43/SarasaMonoSC-TTF-1.0.43.7z#/SarasaMonoSC.7z_"
    ],
    "hash": [
        "3dc0f534b2cfa5f98b58a574948d3e3f9eb140600bd738f259c3d077acb2de66",
        "54747ee26f0bc47dc85583df5f8877a4607467afd70630b80ab4505cccaa8e1d"
    ],
    "installer": {
        "script": [
            "# 仅提取指定的字体文件",
            "$7zPath = Get-HelperPath -Helper 7zip  ",
            "$ArgList = @(                          ",
            "    'e', \"$dir\\SarasaUiSC.7z_\",     ",
            "    '*-Regular.ttf',                   ",
            "    '*-SemiBold.ttf',                  ",
            "    \"-o$dir\", '-y', '-aos'           ",
            ")                                      ",
            "Invoke-ExternalCommand -FilePath $7zPath -ArgumentList $ArgList",
            "$ArgList = @(                          ",
            "    'e', \"$dir\\SarasaMonoSC.7z_\",   ",
            "    '*-Bold.ttf',         ",
            "    '*-BoldItalic.ttf',   ",
            "    '*-Regular.ttf',      ",
            "    '*-Italic.ttf',       ",
            "    \"-o$dir\", '-y', '-aos'           ",
            ")                                      ",
            "Invoke-ExternalCommand -FilePath $7zPath -ArgumentList $ArgList",
            "Remove-Item -Path \"$dir\\SarasaUiSC.7z_\", \"$dir\\SarasaMonoSC.7z_\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "post_install": [
        "$dir_escaped = \"$dir\".Replace('\\', '\\\\')",
        "@('install-fonts.reg', 'uninstall-fonts.reg') | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\$bucket\\scripts\\$app\\$_\") {",
        "        $content = Get-Content \"$bucketsdir\\$bucket\\scripts\\$app\\$_\" -Encoding Unicode",
        "        $content = $content.Replace('$install_dir', $dir_escaped)",
        "        if ($global) {",
        "            $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE')",
        "        }",
        "        Set-Content -Path \"$dir\\$_\" $content -Encoding Unicode",
        "    }",
        "}",
        "# 导入字体注册表",
        "reg import \"$dir\\install-fonts.reg\""
    ],
    "pre_uninstall": "if ($cmd -eq 'uninstall') { reg import \"$dir\\uninstall-fonts.reg\" }",
    "checkver": "github",
    "autoupdate": {
        "url": [
            "https://github.com/be5invis/Sarasa-Gothic/releases/download/v$version/SarasaUiSC-TTF-$version.7z#/SarasaUiSC.7z_",
            "https://github.com/be5invis/Sarasa-Gothic/releases/download/v$version/SarasaMonoSC-TTF-$version.7z#/SarasaMonoSC.7z_"
        ]
    }
}
