    "shortcuts": [
        [
            "MusicLyricApp.exe",
            "Music Lyric"
        ]
    ],
    "persist_external": [
        "$env:APPDATA\\MusicLyricApp"
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/jitwxs/163MusicLyrics/releases/latest",
        "regex": "\"tag_name\":\\s*\"v(?<tag>[\\d.]+)\"[\\s\\S]*?MusicLyricApp-(?<version>[\\d.]+)-win-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jitwxs/163MusicLyrics/releases/download/v$matchTag/MusicLyricApp-$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/jitwxs/163MusicLyrics/releases/download/v$matchTag/MusicLyricApp-$version-win-x86.zip"
            }
        }
    }
