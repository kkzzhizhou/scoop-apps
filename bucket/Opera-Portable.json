{
    "version": "134.0.5954.46",
    "description": "Opera. Fast, secure, easy-to-use browser.",
    "homepage": "https://www.opera.com/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.opera.com/eula/computers"
    },
    "architecture": {
        "64bit": {
            "url": "https://download1.operacdn.com/pub/opera/desktop/134.0.5954.46/win/Opera_134.0.5954.46_Autoupdate_x64.exe#/dl.7z",
            "hash": "f6f67aaa54e52c1bc093682691222e10d14157fe71b65b9494b71c02969046f8"
        },
        "32bit": {
            "url": "https://download1.operacdn.com/pub/opera/desktop/134.0.5954.46/win/Opera_134.0.5954.46_Autoupdate.exe#/dl.7z",
            "hash": "eafe62b8a6719fdeeeb86f829cfa13be666c81022a1abad18c60ac0553847424"
        }
    },
    "installer": {
        "script": [
            "Remove-Item -Path \"$dir\\*_list\" -Force",
            "Move-Item -Path \"$dir\\*\" -Destination \"$dir\\$version\" -Exclude 'Assets', 'launcher*', 'Resources.pri' -ErrorAction Ignore",
            "if (!(Test-Path \"$dir\\$version\\localization\")) {",
            "   New-Item -Path \"$dir\\$version\\localization\" -ItemType Directory | Out-Null",
            "   Move-Item -Path \"$dir\\$version\\*.pak\" -Destination \"$dir\\$version\\localization\" -Exclude 'opera*' -ErrorAction Ignore",
            "}",
            "Set-Content -Path \"$dir\\installer_prefs.json\" -Value (@{ 'autoupdate'= $false; 'enable_stats' = $false; 'single_profile' = $true } | ConvertTo-Json) -Encoding ASCII"
        ]
    },
    "shortcuts": [
        [
            "launcher.exe",
            "Opera"
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://community.chocolatey.org/packages/opera",
        "regex": "Opera ([\\d.]+)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download1.operacdn.com/pub/opera/desktop/$version/win/Opera_$version_Autoupdate_x64.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://download1.operacdn.com/pub/opera/desktop/$version/win/Opera_$version_Autoupdate.exe#/dl.7z"
            }
        }
    }
}
