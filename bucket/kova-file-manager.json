{
    "version": "0.2.3",
    "description": "Native Windows file manager with tabs, file previews and Windows Shell integration",
    "homepage": "https://github.com/cubiix3/Kova-File-Manager",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/cubiix3/Kova-File-Manager/releases/download/v0.2.3/Kova-0.2.3-x64.zip",
            "hash": "fe345df9fa1deb95622f9a0f5eaa0fd02b4014040b82b1a67678379c5fc407b9"
        }
    },
    "bin": "Kova.exe",
    "persist": [
        "Kova"
    ],
    "shortcuts": [
        [
            "Kova.exe",
            "Kova"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\Kova\")) { New-Item -ItemType Directory -Path \"$dir\\Kova\" | Out-Null }"
    ],
    "checkver": {
        "github": "https://github.com/cubiix3/Kova-File-Manager"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cubiix3/Kova-File-Manager/releases/download/v$version/Kova-$version-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "find": "$basename"
        }
    },
    "notes": [
        "App stores user data at %LOCALAPPDATA%\\Kova (library.json, view-options.txt). Scoop cannot redirect %LOCALAPPDATA%; persist the Kova/ directory and document the external data location.",
        "All 5 releases (v0.1.0-v0.2.3) are marked prerelease on GitHub; v0.2.3 is the latest. SHA256SUMS.txt present in release assets."
    ]
}
