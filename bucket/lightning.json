{
    "version": "0.10.0",
    "description": "A native desktop Matrix client: Qt 6 on top of the official Rust Matrix SDK",
    "homepage": "https://www.lightning-matrix.org",
    "license": "GPL-3.0-or-later",
    "notes": [
        "User data (account stores, crypto store, cache, unencrypted message content) lives at %LOCALAPPDATA%\\MatrixClient\\matrix-client; post_install turns it into a junction to the app's persist folder, so upgrades keep your data.",
        "The portable ZIP writes no registry keys and installs no shortcuts itself; after uninstall you can delete the install folder and the leftover %LOCALAPPDATA%\\MatrixClient\\matrix-client junction.",
        "Windows packages are unsigned, so SmartScreen warns on first launch.",
        "A SHA-256 hash is recorded for the portable ZIP so Scoop verifies it at install time."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Mizerd/lightning/releases/download/v0.10.0/Lightning-0.10.0-1e80899-windows-x86_64-portable.zip",
            "hash": "bae56a2fd900a9ce57e4e4ffe7fd49cf4ffcb7aef01e71298d11e6ef49a25933"
        }
    },
    "extract_dir": "Lightning",
    "bin": "Lightning.exe",
    "shortcuts": [
        [
            "Lightning.exe",
            "Lightning"
        ]
    ],
    "persist": [
        "data"
    ],
    "post_install": [
        "$dest = Join-Path $env:LOCALAPPDATA 'MatrixClient\\matrix-client'",
        "$target = Join-Path $dir 'data'",
        "if (Test-Path $dest) {",
        "  $item = Get-Item $dest -Force",
        "  if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { [IO.Directory]::Delete($dest, $false) }",
        "  else { Get-ChildItem $dest -Force | Move-Item -Destination $target -Force -ErrorAction SilentlyContinue; Remove-Item $dest -Recurse -Force }",
        "}",
        "if (-not (Test-Path $dest)) {",
        "  New-Item -ItemType Directory -Path (Split-Path $dest) -Force | Out-Null",
        "  New-Item -ItemType Junction -Path $dest -Target $target | Out-Null",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/Mizerd/lightning",
        "regex": "Lightning-([0-9.]+)-(\\w+)-windows-x86_64-portable\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Mizerd/lightning/releases/download/v$version/Lightning-$version-$match2-windows-x86_64-portable.zip",
                "extract_dir": "Lightning"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "$basename"
        }
    }
}
