{
    "version": "0.9.18",
    "description": "QoderWork 中国版 - 智能编程助手，让工作更高效",
    "homepage": "https://qoder.cn",
    "license": {
        "identifier": "Proprietary",
        "url": "https://qoder.com/product-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://static.qoder.com.cn/qoder-work-cn/releases/latest/QoderWorkCN-Setup-User-x64.exe#/dl.7z",
            "hash": "085f668322572cca2c600f9a96e567f2f926f9830a78809966d9cc7c2e99242d",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item -Path \"$dir\\`$*\" -Recurse"
            ]
        }
    },
    "post_install": [
        "# 数据迁移：AppData\\QoderWork CN",
        "$link = \"$env:AppData\\QoderWork CN\"",
        "$target = ensure \"$persist_dir\\QoderWork CN\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}",
        "# 数据迁移：USERPROFILE\\.qoderworkcn",
        "$link = \"$env:USERPROFILE\\.qoderworkcn\"",
        "$target = ensure \"$persist_dir\\.qoderworkcn\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "QoderWork CN.exe",
            "QoderWork CN",
            "--force-device-scale-factor=1.5"
        ]
    ],
    "post_uninstall": [
        "# 删除数据软连接",
        "$link = @(\"$env:AppData\\QoderWork CN\", \"$env:USERPROFILE\\.qoderworkcn\")",
        "Remove-Item -Path $link -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "script": [
            "$url = 'https://static.qoder.com.cn/qoder-work-cn/releases/latest/QoderWorkCN-Setup-User-x64.exe'",
            "$tmp = Join-Path $env:TEMP ('qoder_' + [guid]::NewGuid() + '.exe')",
            "# 下载前 1MB 读版本号（已有实测确认）",
            "try {",
            "    Invoke-WebRequest -Uri $url -Headers @{Range='bytes=0-1048575'} -OutFile $tmp -UseBasicParsing -ErrorAction Stop",
            "    $version = (Get-Item $tmp).VersionInfo.FileVersion",
            "    if (-not $version) { throw '无法读取版本号' }",
            "} finally {",
            "    if (Test-Path $tmp) { Remove-Item -Path $tmp -Force -ErrorAction SilentlyContinue }",
            "}",
            "",
            "# 输出结果就是 'version'",
            "Write-Output (\"$version\")"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.qoder.com.cn/qoder-work-cn/releases/latest/QoderWorkCN-Setup-User-x64.exe#/dl.7z"
            }
        }
    }
}
