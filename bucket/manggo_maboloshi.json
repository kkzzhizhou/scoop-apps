{
    "version": "1.1.3",
    "description": "A desktop translation and screenshot OCR assistant for academic reading, web browsing, and cross-language communication.",
    "homepage": "https://manggo.pylogmon.com/",
    "license": "Proprietary",
    "url": "https://gitcode.com/Pylogmon/Manggo/releases/download/1.1.3/Manggo-1.1.3-Windows-AMD64.exe#/dl.7z",
    "hash": "9a2b055572bdf4f5e08bc867d35a9abcc09ac8af6916d4226ae876a59c49a015",
    "post_install": [
        "Remove-Item -Path \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue",
        "# 数据迁移",
        "$link = \"$env:LocalAppData\\Manggo\\Manggo\"",
        "$target = ensure \"$persist_dir\\Manggo\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "bin\\Manggo.exe",
            "Manggo"
        ]
    ],
    "persist": "Manggo",
    "post_uninstall": [
        "# 删除数据软连接",
        "$link = \"$env:LocalAppData\\Manggo\\Manggo\"",
        "Remove-Item -Path $link -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://api.gitcode.com/api/v5/repos/Pylogmon/Manggo/releases/latest",
        "jsonpath": "$.tag_name"
    },
    "autoupdate": {
        "url": "https://gitcode.com/Pylogmon/Manggo/releases/download/$version/Manggo-$version-Windows-AMD64.exe#/dl.7z"
    }
}
