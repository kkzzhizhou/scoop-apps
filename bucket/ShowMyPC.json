    "hash": "86a9b5a08c39f009e965e96bef94df03bb83825aa22db3bfd68f09c12fa3cc86",
    "installer": {
        "script": [
            "Expand-InnoArchive \"$dir\\Setup.exe\" -Removal",
            "$exe = Get-ChildItem -Path \"$dir\" -Recurse -Filter 'SMPCSetup.exe' | Select-Object -First 1",
            "if ($exe.Directory.FullName -ne $dir) { Move-Item \"$($exe.Directory.FullName)\\*\" \"$dir\" -Force; Remove-Item $exe.Directory.FullName -Recurse -Force }"
        ]
    },
    "bin": "SMPCSetup.exe",
    "shortcuts": [
        [
            "SMPCSetup.exe",
            "ShowMyPC"
        ]
    ]
}
