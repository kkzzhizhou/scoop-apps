            "hash": "69b64e7e5bc5c0594a56e289740d9eb70cb8cd0278278793dfe73674d822f340",
            "pre_install": "Remove-Item \"$dir\\`$*\" -Force -Recurse"
        },
        "arm64": {
            "url": "https://github.com/WCY-dt/MrRSS/releases/download/v1.3.34/MrRSS-1.3.34-windows-arm64-portable.zip",
