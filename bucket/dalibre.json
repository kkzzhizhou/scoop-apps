    "shortcuts": [
        [
            "Dalibre.exe",
            "Dalibre"
        ]
    ],
    "notes": [
        "Dalibre keeps its settings in %APPDATA%\\Dalibre\\settings.json, cover thumbnails in %LOCALAPPDATA%\\Dalibre\\thumbs, and installed plugins in %APPDATA%\\Dalibre\\plugins. These live outside the Scoop directory and are not managed by Scoop.",
        "Set DALIBRE_PLUGINS to load plugins from another folder, and DALIBRE_LIBRARY to open a specific calibre library at startup.",
        "Dalibre updates itself from its own GitHub releases, which can conflict with 'scoop update'. Disable automatic update checks in Settings if you prefer Scoop to manage versions."
    ],
    "checkver": {
        "github": "https://github.com/djyde/dalibre"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/djyde/dalibre/releases/download/v$version/dalibre-setup-$version-amd64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/djyde/dalibre/releases/download/v$version/dalibre-setup-$version-arm64.exe#/dl.7z"
