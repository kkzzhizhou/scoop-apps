            "hash": "321bf63e36871fb31ee44cf4987150d770c679ac3e233115540d83468d675b06"
        },
        "arm64": {
            "url": "https://github.com/ollama/ollama/releases/download/v0.33.1/ollama-windows-arm64.zip",
