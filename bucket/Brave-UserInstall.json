    "architecture": {
        "64bit": {
            "url": "https://github.com/brave/brave-browser/releases/download/v1.98.63/BraveBrowserStandaloneSilentSetup.exe#/setup.exe",
            "hash": "6c139a6915432e72b626ce8566865f12854f744310c19543c498ecfd87d5cffa"
        },
        "32bit": {
