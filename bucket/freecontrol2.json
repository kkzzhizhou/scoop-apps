    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/pdone/FreeControl2/releases/download/v1.1.0/FreeControl2_1.1.0_x64.exe#/FreeControl2.exe",
            "hash": "bf2b4c53d65b32184278ce2c64d26d87634cfb279a9b22ef7d4bf0946fbfddc1"
        },
        "arm64": {
            "url": "https://github.com/pdone/FreeControl2/releases/download/v1.1.0/FreeControl2_1.1.0_arm64.exe#/FreeControl2.exe",
            "hash": "ee6e9355f22f86e5be83c2a3f037de341bc1d2c1ebc298f1dce34c5e56d30dc2"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\com.freecontrol2\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\FreeControl2\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\com.freecontrol2\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\FreeControl2\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "FreeControl2.exe",
    "shortcuts": [
        [
            "FreeControl2.exe",
            "FreeControl2"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/pdone/FreeControl2/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pdone/FreeControl2/releases/download/v$version/FreeControl2_$version_x64.exe#/FreeControl2.exe"
            },
            "arm64": {
                "url": "https://github.com/pdone/FreeControl2/releases/download/v$version/FreeControl2_$version_arm64.exe#/FreeControl2.exe"
            }
        }
    }
}
