    "installer": {
        "script": [
            "if (!(is_admin)) { error \"需要管理员权限来安装证书和MSIX包。\"; break }",
            "$msix = (Get-ChildItem \"$dir\\*.msix\").FullName",
            "$cer = (Get-ChildItem \"$dir\\*.cer\").FullName",
