{
    "version": "6.4.0-beta02",
    "description": "One-stop online barrage drama tracking platform",
    "homepage": "https://github.com/open-ani/animeko",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/open-ani/animeko/releases/download/v6.4.0-beta02/ani-6.4.0-beta02-windows-x86_64.zip",
            "hash": "e12f2ab581eb3eeeb34b158e6697a30df1680c5dc7f67e492ed745b8a1b60cca",
            "extract_dir": "Ani"
        }
    },
    "bin": "Ani.exe",
    "shortcuts": [
        [
            "Ani.exe",
            "Ani"
        ]
    ],
    "persist_external": [
        [
            "$env:APPDATA\\Him188",
            "data",
            "directory"
        ],
        [
            "$env:LOCALAPPDATA\\Him188",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/open-ani/animeko/releases?per_page=10",
        "jsonpath": "$.[?(@.prerelease==true)].tag_name",
        "regex": "v([\\d.]+[-\\w]*)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/open-ani/animeko/releases/download/v$version/ani-$version-windows-x86_64.zip"
            }
        }
    }
}
