{
    "version": "2.4.0",
    "description": "A native SillyTavern client for desktop and mobile, built with Tauri and Rust.",
    "homepage": "https://github.com/Darkatse/TauriTavern",
    "license": "AGPL-3.0-only",
    "suggest": {
        "Microsoft Edge WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Darkatse/TauriTavern/releases/download/v2.4.0/TauriTavern-2.4.0-windows-x64-portable.exe#/TauriTavern.exe",
            "hash": "a03aac59ebc27357f54aedea29d73a000483ad290106693d982006d41f00ceb8"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\tauritavern-runtime.json\")) {",
        "    $runtimeConfig = [ordered]@{ version = 1; data_root = \"$persist_dir\\data\"; migration = $null; migration_error = $null } | ConvertTo-Json -Compress",
        "    [System.IO.File]::WriteAllText(\"$dir\\tauritavern-runtime.json\", $runtimeConfig)",
        "}"
    ],
    "shortcuts": [
        [
            "TauriTavern.exe",
            "TauriTavern"
        ]
    ],
    "persist": [
        "data",
        "logs",
        ".data-archive",
        "tauritavern-runtime.json"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Darkatse/TauriTavern/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "releases/download/v([\\d.]+)/TauriTavern-[\\d.]+-windows-x64-portable\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Darkatse/TauriTavern/releases/download/v$version/TauriTavern-$version-windows-x64-portable.exe#/TauriTavern.exe"
            }
        }
    }
}
