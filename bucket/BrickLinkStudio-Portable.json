        ]
    ],
    "checkver": {
        "script": [
            "$cont = $(Invoke-WebRequest('https://www.bricklink.com/v3/studio/download.page')).Content",
            "if(!($cont -match 'blapp\\.models\\.set\\( (.*) \\);')) { continue }",
            "Write-Output $matches[1]"
        ],
        "jsonpath": "$.[?(@.name == 'changeLog')].data[*].strVersion",
        "regex": "([\\d._]+)",
        "reverse": true
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://studio.download.bricklink.info/Studio$majorVersion.0/Archive/$version/Studio+$majorVersion.0.exe"
            }
        }
    }
}
