{
    "version": "4.2.11",
    "description": "A comic app built with Flutter, supporting multiple comic sources.",
    "homepage": "https://github.com/Pacalini/PicaComic",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Pacalini/PicaComic/releases/download/v4.2.11/PicaComic-4.2.11-windows.zip",
            "hash": "a31d73e331d515b5f69e071d90f40c404a01cd0fc18118eba1c7128a81827107"
        }
    },
    "persist_external": [
        [
            "$env:AppData\\com.github.pacalini",
            "data",
            "directory"
        ],
        [
            "$env:LocalAppData\\com.github.pacalini",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "shortcuts": [
        [
            "pica_comic.exe",
            "Pica Comic"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Pacalini/PicaComic/releases/download/v$version/PicaComic-$version-windows.zip"
            }
        }
    }
}
