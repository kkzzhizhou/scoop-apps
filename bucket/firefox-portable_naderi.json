    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/160.0/win64/en-US/Firefox%20Setup%20160.0.exe#/dl.7z",
            "hash": "sha512:d8775c051cc5f5330386a002fec915d2d057b33bbf7e19037d9f65f094d651f63e2302ada829a4cede9a05a24c015db4acb4f56a34d4147beada984487e9c53c"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/160.0/win32/en-US/Firefox%20Setup%20160.0.exe#/dl.7z",
            "hash": "sha512:db6c8fe8702d7a29787d7ca30437a9c1227159b823e0ed1c6b22b600658991e66e70c1765037c26fc635a022160067dcd7b6ba5a3f3843d63a5c48f62746317b"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "Profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
