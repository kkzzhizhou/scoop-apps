{
    "version": "0.2.5",
    "description": "Free & Open-Source CapCut replacement.",
    "homepage": "https://github.com/jub0t/Concat",
    "license": {
        "identifier": "AGPL-3.0",
        "url": "https://github.com/jub0t/Concat/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jub0t/Concat/releases/download/v0.2.5/Concat-0.2.5-windows-x86_64-setup.exe",
            "hash": "233091cb532165b5888457dc496347508b01b995add6155e2569f53005622255"
        },
        "arm64": {
            "url": "https://github.com/jub0t/Concat/releases/download/v0.2.5/Concat-0.2.5-windows-aarch64-setup.exe",
            "hash": "e79b7d732c8e6079615143566beb0369f4ce44039def2a16f4d82b63a2e201b7"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\app.concat.editor\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\app.concat.editor\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "concat.exe",
    "shortcuts": [
        [
            "concat.exe",
            "Concat"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/jub0t/Concat/releases/latest",
        "jp": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jub0t/Concat/releases/download/v$version/Concat-$version-windows-x86_64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/jub0t/Concat/releases/download/v$version/Concat-$version-windows-aarch64-setup.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
