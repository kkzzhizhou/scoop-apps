{
    "version": "0.2.8",
    "description": "Free & Open-Source CapCut replacement.",
    "homepage": "https://github.com/jub0t/concat",
    "license": {
        "identifier": "AGPL-3.0",
        "url": "https://github.com/jub0t/concat/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jub0t/concat/releases/download/v0.2.8/Concat-0.2.8-windows-x86_64-setup.exe",
            "hash": "6ded705620e6c18adbc2ece28a2876db326e4f6361c8e41151dab516419c8776"
        },
        "arm64": {
            "url": "https://github.com/jub0t/concat/releases/download/v0.2.6/Concat-0.2.6-windows-aarch64-setup.exe",
            "hash": "377c3e6eedc88a79d19387a938054e19f755262ad484f590b6a78dfcdb8e926b"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\app.concat.editor\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\app.concat.editor\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "concat.exe",
    "shortcuts": [
        [
            "concat.exe",
            "Concat"
        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://api.github.com/repos/jub0t/concat/releases'",
            "$cont = (Invoke-WebRequest $url).Content",
            "$r = 'Concat-([\\d.]+)-windows-x86_64' ",
            "if (!($cont -match $r)) { error \"Could not match $r in $url\"; continue }",
            "$version = $matches[1]",
            "$r = 'Concat-([\\d.]+)-windows-aarch64' ",
            "if (!($cont -match $r)) { error \"Could not match $r in $url\"; continue }",
            "$arm64 = $matches[1]",
            "Write-Output $version $arm64"
        ],
        "regex": "([\\d.]+) (?<arm64>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jub0t/concat/releases/download/v$version/Concat-$version-windows-x86_64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/jub0t/concat/releases/download/v$matchArm64/Concat-$matchArm64-windows-aarch64-setup.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
