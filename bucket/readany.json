{
    "version": "1.3.6",
    "description": "AI-powered cross-platform e-book reader with semantic search, RAG chat, local vector store, notes, TTS, and WebDAV sync.",
    "homepage": "https://codedogqby.github.io/ReadAny/",
    "license": {
        "identifier": "GNU GENERAL PUBLIC LICENSE",
        "url": "https://github.com/codedogQBY/ReadAny#License-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/codedogQBY/ReadAny/releases/download/v1.3.6/ReadAny_1.3.6_x64-setup.exe#/dl.7z",
            "hash": "da80ef0efdc930c7bc816dc0d8225341c87c33022bf8bad48e69c10aa1ae71f9",
            "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\com.readany.app\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\com.readany.app\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\com.readany.app\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.readany.app\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "app.exe",
            "ReadAny"
        ]
    ],
    "shortcuts": [
        [
            "app.exe",
            "ReadAny"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/codedogQBY/ReadAny/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/codedogQBY/ReadAny/releases/download/v$version/ReadAny_$version_x64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.json"
        }
    }
}
