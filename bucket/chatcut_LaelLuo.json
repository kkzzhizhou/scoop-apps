{
    "version": "0.3.16",
    "description": "ChatCut desktop - AI video editor that edits with prompts (bundled agent runtime, ~600MB download)",
    "homepage": "https://chatcut.io",
    "license": {
        "identifier": "Proprietary"
    },
    "architecture": {
        "64bit": {
            "url": "https://d2k0dx41dpnoir.cloudfront.net/ChatCut%20Setup%200.3.16.exe#/dl.7z",
            "hash": "sha512:e10d739009b850a5cca0568a6091c9859070b70ed7b000d9f39f6f995a9b583923db8e9198a09a69025e761c54ff02418430ecf3d64d269024497fbcd68bc788",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "ChatCut.exe",
            "ChatCut"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/ChatCut",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "updater",
                "source": "LocalAppData/chatcut-desktop-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "checkver": {
        "url": "https://d2k0dx41dpnoir.cloudfront.net/latest.yml",
        "regex": "version:\\s+([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://d2k0dx41dpnoir.cloudfront.net/ChatCut%20Setup%20$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512:\\s+$base64"
        }
    }
}
