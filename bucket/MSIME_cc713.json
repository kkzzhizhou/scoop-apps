{
    "version": "0.12.0",
    "description": "水杉输入法 (Metasequoia IME) — 开源的 Windows 中文 / 日文 TSF 输入法",
    "homepage": "https://msime.app/",
    "license": "GPL-3.0-only",
    "suggests": "extras/vcredist2022",
    "architecture": {
        "64bit": {
            "url": "https://github.com/metasequoiaime/msime-windows/releases/download/v0.12.0/MetasequoiaIME_Setup_v0.12.0.exe#/MetasequoiaIME_Setup.exe",
            "hash": "2baf40185ab95b109f2fd42087a1bf90ae1bb0e8298311d17031c4fccc2bb933"
        }
    },
    "installer": {
        "script": "Start-Process -FilePath \"$dir\\MetasequoiaIME_Setup.exe\" -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/SP-', \"/DIR=$dir\") -Wait"
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\unins000.exe\") { Start-Process -FilePath \"$dir\\unins000.exe\" -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART') -Wait }"
    },
    "notes": [
        "TSF 输入法，安装 / 卸载需管理员权限，建议用管理员终端执行 scoop 命令。",
        "安装后按 Win + 空格 切换，可能需要注销或重启生效。",
        "缺 VC++ x64 运行库会闪退，可先 scoop install vcredist2022。"
    ],
    "checkver": {
        "github": "https://github.com/metasequoiaime/msime-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/metasequoiaime/msime-windows/releases/download/v$version/MetasequoiaIME_Setup_v$version.exe#/MetasequoiaIME_Setup.exe"
            }
        }
    }
}
