    "bin": [
        [
            "fastclaw.cmd",
            "fastclaw"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/fastclaw-ai/fastclaw"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/fastclaw-ai/fastclaw/releases/download/v$version/fastclaw_windows_amd64.zip"
            },
