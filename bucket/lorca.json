{
    "version": "0.1.14",
    "description": "Lorca desktop app: chat with your bots, which run on computers you own.",
    "homepage": "https://lorca.app",
    "license": "GPL-3.0-or-later",
    "notes": [
        "Lorca Desktop is self-updating via GitHub (desktop-v* release channel), so it may also update itself in place after installation.",
        "The app stores its account, credentials, chats and preferences outside the Scoop directory (Windows app data, bundle id app.lorca), so this manifest does not persist them."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/egoist/lorca/releases/download/desktop-v0.1.14/lorca-0.1.14-windows-amd64.tar.gz",
            "hash": "115472ce3221531c60c46dee979b135a4180c07f0054d49d36e3302856bb75f9"
        }
    },
    "bin": "Lorca.exe",
    "shortcuts": [
        [
            "Lorca.exe",
            "Lorca"
        ]
    ],
    "checkver": {
        "github": "https://github.com/egoist/lorca",
        "regex": "releases/tag/(desktop-v([0-9.]+))"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/egoist/lorca/releases/download/desktop-v$version/lorca-$version-windows-amd64.tar.gz"
            }
        },
        "hash": {
            "url": "$baseurl/lorca-$version-windows-amd64.tar.gz.sha256",
            "regex": "([a-f0-9]{64})"
        }
    }
}
