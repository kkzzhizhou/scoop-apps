{
    "version": "0.3.9",
    "description": "Check your agent's changes, fast. A light, native git client for macOS, Windows and Linux",
    "homepage": "https://binaryify.com/mygit",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Binaryify/MyGit/releases/download/v0.3.9/MyGit-windows-amd64.zip",
            "hash": "807e1f97d9d850a0ea791314b7b1d60140834fdaa04a56220a15d18368abedd1"
        }
    },
    "bin": "MyGit.exe",
    "persist": "helper",
    "shortcuts": [
        [
            "MyGit.exe",
            "MyGit"
        ]
    ],
    "pre_install": "if (!(Test-Path \"$dir\\helper\")) { New-Item -ItemType Directory -Path \"$dir\\helper\" | Out-Null }",
    "env_set": {
        "MYGIT_HELPER_DIR": "$persist_dir\\helper"
    },
    "suggest": {
        "git": "Main/git"
    },
    "notes": [
        "Settings are stored in %APPDATA%\\MyGit\\settings.json and are kept across updates automatically.",
        "The git command must be available on PATH for MyGit to work."
    ],
    "checkver": {
        "github": "https://github.com/Binaryify/MyGit"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Binaryify/MyGit/releases/download/v$version/MyGit-windows-amd64.zip",
                "hash": "https://github.com/Binaryify/MyGit/releases/download/v$version/MyGit-windows-amd64.zip.sha256"
            }
        }
    }
}
