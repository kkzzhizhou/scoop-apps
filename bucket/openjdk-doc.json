    "shortcuts": [
        [
            "index.html",
            "openjdk-doc"
        ]
    ],
    "checkver": {
        "url": "https://archlinux.org/packages/extra/x86_64/openjdk-doc/",
        "regex": "\"version\"\\s+content=\"(.+?)\""
    },
    "autoupdate": {
        "url": "https://mirrors.tuna.tsinghua.edu.cn/archlinux/extra/os/x86_64/openjdk-doc-$version-x86_64.pkg.tar.zst"
    }
