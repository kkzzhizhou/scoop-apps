{
    "version": "0.22.4",
    "description": "A small, fast code editor written in Go, with a native GPU-drawn UI (no webview, no Electron)",
    "homepage": "https://github.com/sorrycc/Mayoi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sorrycc/Mayoi/releases/download/v0.22.4/mayoi-0.22.4-windows-amd64.tar.gz",
            "hash": "f8493a0d3d35a87aa26f15221fbec6ce31b101daeeff96374ddfdbf417ab3878"
        },
        "arm64": {
            "url": "https://github.com/sorrycc/Mayoi/releases/download/v0.22.4/mayoi-0.22.4-windows-arm64.tar.gz",
            "hash": "e2b94452ade89357dd4e0297b9daa2edaf489c814c13d0383e3d3314f314921f"
        }
    },
    "bin": "mayoi.exe",
    "shortcuts": [
        [
            "mayoi.exe",
            "Mayoi"
        ]
    ],
    "env_set": {
        "MAYOI_DATA_DIR": "$persist_dir\\data"
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\data\")) { New-Item -ItemType Directory -Path \"$persist_dir\\data\" | Out-Null }"
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/sorrycc/Mayoi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sorrycc/Mayoi/releases/download/v$version/mayoi-$version-windows-amd64.tar.gz",
                "hash": {
                    "url": "https://github.com/sorrycc/Mayoi/releases/download/v$version/SHA256SUMS",
                    "regex": "(?m)^([a-fA-F0-9]{64})\\s+mayoi-[\\d.]+-windows-amd64\\.tar\\.gz$"
                }
            },
            "arm64": {
                "url": "https://github.com/sorrycc/Mayoi/releases/download/v$version/mayoi-$version-windows-arm64.tar.gz",
                "hash": {
                    "url": "https://github.com/sorrycc/Mayoi/releases/download/v$version/SHA256SUMS",
                    "regex": "(?m)^([a-fA-F0-9]{64})\\s+mayoi-[\\d.]+-windows-arm64\\.tar\\.gz$"
                }
            }
        }
    },
    "notes": [
        "Mayoi keeps settings.json, keybindings.json, state.json, window-state.json and updater.json in %AppData%\\Mayoi by default; this manifest points MAYOI_DATA_DIR at the persisted data folder so everything survives a Scoop update.",
        "The data folder is persisted as a separate 'data' subdirectory, so settings, session state, crash logs and crash reports are kept without touching the program files (mayoi.exe, ghostty-vt.dll, icon.png).",
        "Before 0.22.4 Mayoi had no built-in updater, so 'scoop update mayoi' (or 'scoop update *') remains the way to upgrade it."
    ]
}
