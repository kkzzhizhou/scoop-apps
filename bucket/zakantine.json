{
    "version": "4",
    "description": "Performance-focused Nintendo Switch 2 emulator fork",
    "homepage": "https://github.com/kanade333/Zakantine",
    "license": "GPL-3.0",
    "notes": [
        "Zakantine requires legally obtained game files, keys, and firmware. These are not included.",
        "The release uses the existing %APPDATA%\\eden data directory. Back up your saves before testing builds."
    ],
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/kanade333/Zakantine/releases/download/zakantine-v4/Zakantine-v4-Windows-x64.zip",
            "hash": "887fb560239b5eb5f6d7ce4d097db6ea71150cbdf973b8ad17f55f93df3fd854"
        }
    },
    "extract_dir": "Zakantine-v4-Windows-x64",
    "shortcuts": [
        [
            "zakantine.exe",
            "Nintendo Switch 2 [nsw2][zakantine]"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/kanade333/Zakantine/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "zakantine-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kanade333/Zakantine/releases/download/zakantine-v$version/Zakantine-v$version-Windows-x64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/kanade333/Zakantine/releases/tags/zakantine-v$version",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest",
                    "mode": "json"
                }
            }
        },
        "extract_dir": "Zakantine-v$version-Windows-x64"
    }
}
