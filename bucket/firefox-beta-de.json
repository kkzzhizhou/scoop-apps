    "homepage": "https://www.mozilla.org/de-DE/firefox/beta/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0b10/win64/de-DE/Firefox%20Setup%20154.0b10.exe#/dl.7z",
            "hash": "sha512:c64f8de0d6c8d1ecbd94b085b7b026e3239514e855cb2d80b400c17a787cd143aec998573515b03c6d031214d5ec934c8f9995a2408b57a486b3e5a3c278ac44"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0b10/win32/de-DE/Firefox%20Setup%20154.0b10.exe#/dl.7z",
            "hash": "sha512:c64f8de0d6c8d1ecbd94b085b7b026e3239514e855cb2d80b400c17a787cd143aec998573515b03c6d031214d5ec934c8f9995a2408b57a486b3e5a3c278ac44"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-beta-de",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox Beta (de)",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_DEVEL_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/de-DE/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/de-DE/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/de-DE/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/de-DE/$basename"
                }
            }
        }
    }
}
