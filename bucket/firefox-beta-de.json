            "hash": "sha512:d0043cbb12296fe3ce4dc4f0f1363fc98b9fcfd0a7ed7636c7b71b7290c7c2154863b7cbd3d2ab69f89f1bd5ee34a9ef0efa083ed1a56e13049b8d8eb18aa2b4"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0b2/win32/de-DE/Firefox%20Setup%20156.0b2.exe#/dl.7z",
            "hash": "sha512:d0043cbb12296fe3ce4dc4f0f1363fc98b9fcfd0a7ed7636c7b71b7290c7c2154863b7cbd3d2ab69f89f1bd5ee34a9ef0efa083ed1a56e13049b8d8eb18aa2b4"
