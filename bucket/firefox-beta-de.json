    "homepage": "https://www.mozilla.org/de-DE/firefox/beta/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/158.0b4/win64/de-DE/Firefox%20Setup%20158.0b4.exe#/dl.7z",
            "hash": "sha512:1f7a56e03b5a83484d9603d464cd4bce8e3e073e9ecb54e466fc920a58e545b1f9d0429a3476ad211f72df0a12db1d6ee45efc5659b5a498541ed7cd7d5e8672"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/158.0b4/win32/de-DE/Firefox%20Setup%20158.0b4.exe#/dl.7z",
            "hash": "sha512:1f7a56e03b5a83484d9603d464cd4bce8e3e073e9ecb54e466fc920a58e545b1f9d0429a3476ad211f72df0a12db1d6ee45efc5659b5a498541ed7cd7d5e8672"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-beta-de",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox Beta (de)",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_DEVEL_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/de-DE/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/de-DE/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/de-DE/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/de-DE/$basename"
                }
            }
        }
    }
}
