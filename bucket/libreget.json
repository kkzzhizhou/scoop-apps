{
    "version": "1.0.0",
    "description": "Open-source download manager for courses (Udemy/Hotmart), YouTube, music & 1,800+ sites. Built with Tauri 2.0, Rust & Svelte.",
    "homepage": "https://github.com/OpenSelena/libreget",
    "license": {
        "identifier": "GPL-3.0 license",
        "url": "https://github.com/OpenSelena/libreget#GPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/OpenSelena/libreget/releases/download/v1.0.0/LibreGet_1.0.0_x64-setup.exe",
            "hash": "e3918a143b3c557fd06fa1f94a5763a3010fb6d6a7ed6f1ae23ce80c8c0dca67",
            "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\com.openselena.libreget\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\com.openselena.libreget\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\com.openselena.libreget\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.openselena.libreget\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "libreget.exe",
    "shortcuts": [
        [
            "libreget.exe",
            "LibreGet"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/OpenSelena/libreget/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/OpenSelena/libreget/releases/download/v$version/LibreGet_$version_x64-setup.exe"
            }
        }
    }
}
