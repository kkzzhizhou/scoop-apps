{
    "version": "0.4.37",
    "description": "开源的SSL证书管理工具，可以帮助你自动申请、部署SSL证书，并在证书即将过期时自动续期。An open-source SSL certificate management tool that helps you automatically apply for and deploy SSL certificates, as well as automatically renew them when they are about to expire",
    "homepage": "https://docs.certimate.me",
    "license": "MIT",
    "notes": "https://github.com/ViCrack/scoop-bucket/blob/master/bucket/certimate.json",
    "architecture": {
        "64bit": {
            "url": "https://github.com/certimate-go/certimate/releases/download/v0.4.37/certimate_v0.4.37_windows_amd64.zip",
            "hash": "d3be14e3fcf805e9d0efb1b097e093a9f5607dea14a7705284afab1c179becd8"
        }
    },
    "bin": "certimate.exe",
    "checkver": {
        "github": "https://api.github.com/repos/certimate-go/certimate/releases/latest",
        "jsonpath": "$..browser_download_url",
        "regex": "/certimate_v([\\d.]+)_windows_amd64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/certimate-go/certimate/releases/download/v$version/certimate_v$version_windows_amd64.zip"
            }
        }
    }
}
