    "architecture": {
        "64bit": {
            "url": "https://github.com/certimate-go/certimate/releases/download/v0.4.34/certimate_v0.4.34_windows_amd64.zip",
            "hash": "127f4772f4afa483188d1881d4f71eb6c94dd872b4dc130f224ec938838b79fa"
        }
    },
    "bin": "certimate.exe",
    "checkver": {
        "url": "https://api.github.com/repos/certimate-go/certimate/releases/latest",
        "jsonpath": "$..browser_download_url",
        "regex": "/certimate_v([\\d.]+)_windows_amd64\\.zip"
    },
    "autoupdate": {
        "architecture": {
