        [
            "MooTool Next Electron.exe",
            "MooTool"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/rememberber/MooTool/releases",
        "jp": "$[*].tag_name",
        "regex": "next-electron-v([\\d.]+)"
