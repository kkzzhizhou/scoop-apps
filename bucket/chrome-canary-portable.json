            "hash": "1c7a2d9d6015c7b7801f1974ff46671dce3476e4b40b14ec1c471e0014a9382b"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/j5vyvfpoinlpnvvbhk7wqxi3eq_153.0.8002.0/153.0.8002.0_chrome_installer.exe#/dl.7z",
