            "hash": "c5d3158eb07ddb883d4569440b43aee0a1705276479468c7f846047740b0df70"
        }
    },
    "installer": {
        "script": "Expand-7zipArchive \"$dir\\chrome.7z\" -ExtractDir 'Chrome-bin' -Removal"
