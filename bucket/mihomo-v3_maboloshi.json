{
    "version": "1.19.31",
    "description": "A simple Python Pydantic model for Honkai: Star Rail parsed data from the Mihomo API.",
    "homepage": "https://github.com/MetaCubeX/mihomo",
    "license": "GPL-3.0-or-later",
    "suggest": {
        "mihomo-tray": "scoop-private/mihomo-tray-rs"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/MetaCubeX/mihomo/releases/download/v1.19.31/mihomo-windows-amd64-v3-v1.19.31.zip",
            "hash": "f1a81678517dee871b51858f2a62d190d014b389057c67db575d1ddba892d19b"
        }
    },
    "pre_install": "Get-ChildItem \"$dir\\mihomo*.exe\" | Rename-Item -NewName 'mihomo.exe'",
    "bin": [
        "mihomo.exe",
        [
            "mihomo.exe",
            "clash"
        ]
    ],
    "env_set": {
        "CLASH_HOME_DIR": "$persist_dir"
    },
    "post_install": [
        "info 'Adding firewall rules for mihomo.exe; this opens one UAC prompt.'",
        "& \"$bucketsdir\\$bucket\\scripts\\mihomo-v3\\mihomo-firewall.ps1\" -Action Enable -ProgramPath \"$dir\\mihomo.exe\""
    ],
    "pre_uninstall": [
        "info 'Removing the firewall rules that were added for mihomo.exe; this opens one UAC prompt.'",
        "& \"$bucketsdir\\$bucket\\scripts\\mihomo-v3\\mihomo-firewall.ps1\" -Action Disable -ProgramPath \"$dir\\mihomo.exe\""
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/MetaCubeX/mihomo/releases/download/v$version/mihomo-windows-amd64-v3-v$version.zip"
            }
        }
    }
}
