{
    "version": "2.3.2",
    "description": "A full-featured download manager.",
    "homepage": "https://imfile.io/",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/imfile-io/imfile-desktop#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/imfile-io/imfile-desktop/releases/download/v2.3.2/imFile-Setup-2.3.2.exe#/dl.7z",
            "hash": "sha512:2599d2bda1060bfe601aaf9cfb2f5454d56f32893921489070482e15e882daf68e56a5cf95652c411fc768ff4fe705bccaf011c845554a2fe2979684025f5bdf",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        },
        "arm64": {
            "url": "https://github.com/imfile-io/imfile-desktop/releases/download/v2.3.2/imFile-Setup-2.3.2-arm64.exe#/dl.7z",
            "hash": "sha512:2599d2bda1060bfe601aaf9cfb2f5454d56f32893921489070482e15e882daf68e56a5cf95652c411fc768ff4fe705bccaf011c845554a2fe2979684025f5bdf",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\" -Target \"$env:APPDATA\\imFile\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\imFile\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "shortcuts": [
        [
            "imFile.exe",
            "imFile"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/imfile-io/imfile-desktop/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/imfile-io/imfile-desktop/releases/download/v$version/imFile-Setup-$version.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/imfile-io/imfile-desktop/releases/download/v$version/imFile-Setup-$version-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512:\\s+$base64"
        }
    }
}
