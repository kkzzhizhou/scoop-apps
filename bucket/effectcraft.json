{
    "version": "0.3.1",
    "description": "Motion graphics and visual effects compositor: an open-source, clean-room reimplementation of Adobe After Effects written in pure Rust.",
    "homepage": "https://getartcraft.com/apps/effectcraft",
    "license": "MIT OR Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/effectcraft/releases/download/v0.3.1/effectcraft-0.3.1-windows-x64-portable.zip",
            "hash": "540c503b60df43239eedfbb57bd70cdbd0346602cd3d2a3e675bacb123009f19",
            "extract_dir": "effectcraft-0.3.1-windows-x64-portable"
        },
        "32bit": {
            "url": "https://github.com/storytold/effectcraft/releases/download/v0.3.1/effectcraft-0.3.1-windows-x86-portable.zip",
            "hash": "013f89e69f3876ea96b150fd86352e9e70d19dfe2921037c7e355633f589b921",
            "extract_dir": "effectcraft-0.3.1-windows-x86-portable"
        }
    },
    "bin": [
        "effectcraft.exe",
        "effectcraft-cli.exe"
    ],
    "persist": "EffectCraft",
    "shortcuts": [
        [
            "effectcraft.exe",
            "EffectCraft"
        ]
    ],
    "pre_install": "if (!(Test-Path \"$dir\\EffectCraft\")) { New-Item -ItemType Directory -Path \"$dir\\EffectCraft\" | Out-Null }",
    "env_set": {
        "EFFECTCRAFT_CONFIG_DIR": "$persist_dir\\EffectCraft"
    },
    "checkver": {
        "github": "https://github.com/storytold/effectcraft"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/effectcraft/releases/download/v$version/effectcraft-$version-windows-x64-portable.zip",
                "extract_dir": "effectcraft-$version-windows-x64-portable"
            },
            "32bit": {
                "url": "https://github.com/storytold/effectcraft/releases/download/v$version/effectcraft-$version-windows-x86-portable.zip",
                "extract_dir": "effectcraft-$version-windows-x86-portable"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "find": "$basename"
        }
    },
    "notes": [
        "EFFECTCRAFT_CONFIG_DIR is set to the persisted folder, so settings, shortcut presets, plug-ins and auto-saves survive updates. Upstream default on Windows is %APPDATA%\\EffectCraft.",
        "Two commands are installed: `effectcraft` launches the compositor GUI, `effectcraft-cli` is the headless renderer/scripting/MCP client (e.g. `effectcraft-cli render --comp Main --out main.mp4`).",
        "Projects use the `.ecproj` format; Adobe After Effects `.aep`/`.aepx` files are not supported.",
        "Upstream states macOS is the most tested platform and Windows still has early interaction bugs."
    ]
}
