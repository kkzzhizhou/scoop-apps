{
    "version": "2.1.6",
    "description": "The Syncthing relay server",
    "homepage": "https://syncthing.net/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/syncthing/relaysrv/releases/download/v2.1.6/strelaysrv-windows-amd64-v2.1.6.zip",
            "hash": "6c7ceb3bdbc7a86560678281e7be2750331aa511635234d3c9ca30279f474710",
            "extract_dir": "strelaysrv-windows-amd64-v2.1.6"
        },
        "32bit": {
            "url": "https://github.com/syncthing/relaysrv/releases/download/v2.1.6/strelaysrv-windows-386-v2.1.6.zip",
            "hash": "29e6fc3491600eb99ce03531185f80497d57b588b706ef7f3cabf26e6c6fd53c",
            "extract_dir": "strelaysrv-windows-386-v2.1.6"
        }
    },
    "bin": [
        [
            "strelaysrv.exe",
            "strelaysrv",
            "-keys \"$dir\""
        ]
    ],
    "persist": [
        "cert.pem",
        "key.pem"
    ],
    "pre_install": [
        "foreach ($name in @('cert.pem', 'key.pem')) {",
        "    if (!(Test-Path \"$persist_dir\\$name\")) {",
        "        New-Item -Force -Path \"$dir\" -Name $name | Out-Null",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/syncthing/relaysrv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/syncthing/relaysrv/releases/download/v$version/strelaysrv-windows-amd64-v$version.zip",
                "extract_dir": "strelaysrv-windows-amd64-v$version"
            },
            "32bit": {
                "url": "https://github.com/syncthing/relaysrv/releases/download/v$version/strelaysrv-windows-386-v$version.zip",
                "extract_dir": "strelaysrv-windows-386-v$version"
            }
        }
    }
}
