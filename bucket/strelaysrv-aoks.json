{
    "version": "2.1.5",
    "description": "The Syncthing relay server",
    "homepage": "https://syncthing.net/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/syncthing/relaysrv/releases/download/v2.1.5/strelaysrv-windows-amd64-v2.1.5.zip",
            "hash": "3c9fb377754fc201834877eaec29e960bbece12ce52172b67e08a1190775fd3b",
            "extract_dir": "strelaysrv-windows-amd64-v2.1.5"
        },
        "32bit": {
            "url": "https://github.com/syncthing/relaysrv/releases/download/v2.1.5/strelaysrv-windows-386-v2.1.5.zip",
            "hash": "21ce91fdc8bd546b70e832d8a39e5134f5a82200e079efc6d8e0079def784f53",
            "extract_dir": "strelaysrv-windows-386-v2.1.5"
        }
    },
    "bin": [
        [
            "strelaysrv.exe",
            "strelaysrv",
            "-keys \"$dir\""
        ]
    ],
    "persist": [
        "cert.pem",
        "key.pem"
    ],
    "pre_install": [
        "foreach ($name in @('cert.pem', 'key.pem')) {",
        "    if (!(Test-Path \"$persist_dir\\$name\")) {",
        "        New-Item -Force -Path \"$dir\" -Name $name | Out-Null",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/syncthing/relaysrv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/syncthing/relaysrv/releases/download/v$version/strelaysrv-windows-amd64-v$version.zip",
                "extract_dir": "strelaysrv-windows-amd64-v$version"
            },
            "32bit": {
                "url": "https://github.com/syncthing/relaysrv/releases/download/v$version/strelaysrv-windows-386-v$version.zip",
                "extract_dir": "strelaysrv-windows-386-v$version"
            }
        }
    }
}
