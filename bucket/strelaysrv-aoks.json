{
    "version": "2.1.7",
    "description": "The Syncthing relay server",
    "homepage": "https://syncthing.net/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/syncthing/relaysrv/releases/download/v2.1.7/strelaysrv-windows-amd64-v2.1.7.zip",
            "hash": "44fffd73184678d4e5eed6b25b4b112ae9573d111858c85b5dfa95e132564871",
            "extract_dir": "strelaysrv-windows-amd64-v2.1.7"
        },
        "32bit": {
            "url": "https://github.com/syncthing/relaysrv/releases/download/v2.1.7/strelaysrv-windows-386-v2.1.7.zip",
            "hash": "3ffb0aedc0cb72b7ca9bc3bf3a8fe79774893ac5d9ba36d66b11eeb91870010d",
            "extract_dir": "strelaysrv-windows-386-v2.1.7"
        }
    },
    "bin": [
        [
            "strelaysrv.exe",
            "strelaysrv",
            "-keys \"$dir\""
        ]
    ],
    "persist": [
        "cert.pem",
        "key.pem"
    ],
    "pre_install": [
        "foreach ($name in @('cert.pem', 'key.pem')) {",
        "    if (!(Test-Path \"$persist_dir\\$name\")) {",
        "        New-Item -Force -Path \"$dir\" -Name $name | Out-Null",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/syncthing/relaysrv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/syncthing/relaysrv/releases/download/v$version/strelaysrv-windows-amd64-v$version.zip",
                "extract_dir": "strelaysrv-windows-amd64-v$version"
            },
            "32bit": {
                "url": "https://github.com/syncthing/relaysrv/releases/download/v$version/strelaysrv-windows-386-v$version.zip",
                "extract_dir": "strelaysrv-windows-386-v$version"
            }
        }
    }
}
