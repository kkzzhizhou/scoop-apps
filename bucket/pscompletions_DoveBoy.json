{
    "version": "8.0.2",
    "description": "A completion manager for a better and simpler tab-completion experience in PowerShell.",
    "homepage": "https://github.com/abgox/PSCompletions",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/abgox/PSCompletions/blob/main/LICENSE"
    },
    "notes": [
        "Use the module by running: 'Import-Module PSCompletions'.",
        "Add to $Profile to auto-import on startup."
    ],
    "url": "https://cdn.powershellgallery.com/packages/pscompletions.8.0.2.nupkg",
    "hash": "9f15f50acd5fc271be7f1eec6be2553c1bf537a535982fc4b70cf7315840b600",
    "pre_install": "Remove-Item \"$dir\\_rels\", \"$dir\\package\", \"$dir\\*Content*.xml\" -Recurse",
    "psmodule": {
        "name": "PSCompletions"
    },
    "persist": "data",
    "checkver": {
        "url": "https://www.powershellgallery.com/packages/PSCompletions",
        "regex": "<h2>([\\d.]+)</h2>"
    },
    "autoupdate": {
        "url": "https://cdn.powershellgallery.com/packages/pscompletions.$version.nupkg"
    }
}
