{
    "version": "3.1.6",
    "description": "Decompress and extract files from any type of archive or installer.",
    "homepage": "https://github.com/wefalltomorrow/UniExtract2",
    "license": "GPL-2.0-or-later",
    "url": "https://github.com/wefalltomorrow/UniExtract2/releases/download/v3.1.6/UniExtract2-v3.1.6.zip",
    "hash": "3c66a8a976daea9f624c0b3fbb28e188a5326b1b3d9b80062a46d8d1c939171b",
    "post_install": [
        "$ini = Get-Content \"$dir\\UniExtract.ini\" -Raw",
        "$new = $ini -replace '(?m)^updateinterval=\\d+', 'updateinterval=999999' -replace '(?m)^nightlyupdates=1', 'nightlyupdates=0'",
        "if ($new -ne $ini) { $new | Set-Content \"$dir\\UniExtract.ini\" -Encoding Ascii }"
    ],
    "bin": "UniExtract.exe",
    "persist": [
        "log",
        "UniExtract.ini"
    ],
    "shortcuts": [
        [
            "UniExtract.exe",
            "Universal Extractor"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/wefalltomorrow/UniExtract2/releases/download/v$version/UniExtract2-v$version.zip"
    }
}
