{
    "version": "1.4.0.5",
    "description": "A JPEGView fork that upscales/downscales in linear space, avoiding the visual errors of many other viewers.",
    "homepage": "https://github.com/KrokusPokus/JPEGView_L",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KrokusPokus/JPEGView_L/releases/download/v1.4.0.5/JPEGView_L_v1.4.0.5.zip",
            "hash": "2bbf7ce6534cb727b4da65a9cd01b781eb794761b1b6ae8de343da992dfd6281"
        }
    },
    "extract_dir": "JPEGView_L",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\JPEGView.ini\")) {",
        "    $cont = (Get-Content \"$dir\\JPEGView.ini\").Replace('StoreToEXEPath=false', 'StoreToEXEPath=true')",
        "    Set-Content \"$dir\\JPEGView.ini\" $cont",
        "}",
        "if (Test-Path \"$persist_dir\\ParamDB.db\") { Copy-Item \"$persist_dir\\ParamDB.db\" \"$dir\" | Out-Null }",
        "if (Test-Path \"$persist_dir\\KeyMap.txt\") { Copy-Item \"$persist_dir\\KeyMap.txt\" \"$dir\" | Out-Null }"
    ],
    "bin": "JPEGView.exe",
    "shortcuts": [
        [
            "JPEGView.exe",
            "JPEGView"
        ]
    ],
    "persist": "JPEGView.ini",
    "uninstaller": {
        "script": [
            "if (Test-Path \"$dir\\ParamDB.db\") { Copy-Item \"$dir\\ParamDB.db\" \"$persist_dir\" | Out-Null }",
            "if (Test-Path \"$dir\\KeyMap.txt\") { Copy-Item \"$dir\\KeyMap.txt\" \"$persist_dir\" | Out-Null }"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KrokusPokus/JPEGView_L/releases/download/v$version/JPEGView_L_v$version.zip"
            }
        }
    }
}
