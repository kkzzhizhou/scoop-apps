            "TigerVNC Server Configuration"
        ]
    ],
    "checkver": {
        "github": "https://github.com/TigerVNC/tigervnc"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://sourceforge.net/projects/tigervnc/files/stable/$version/tigervnc64-winvnc-$version.exe"
            }
        },
        "hash": {
            "mode": "sourceforge"
