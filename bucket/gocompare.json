{
    "version": "1.0.0",
    "description": "Native file and folder comparison tool with diff and three-way merge.",
    "homepage": "https://github.com/jhzhang09/gocompare",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jhzhang09/gocompare/releases/download/v1.0.0/gocompare-1.0.0-windows-amd64-portable.zip",
            "hash": "c06e9a2dd4a72b2aabef513020d7d0562f0509b786405df9161df5ef4dcde8c7"
        },
        "arm64": {
            "url": "https://github.com/jhzhang09/gocompare/releases/download/v1.0.0/gocompare-1.0.0-windows-arm64-portable.zip",
            "hash": "6d469739a79e95918905d3745555ac8bad631f09ae37c72d5d605383095a8ad2"
        }
    },
    "bin": "GoCompare.exe",
    "shortcuts": [
        [
            "GoCompare.exe",
            "GoCompare"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\GoCompare\")) { New-Item -ItemType Directory -Path \"$dir\\GoCompare\" | Out-Null }"
    ],
    "env_set": {
        "GOCOMPARE_DATA_DIR": "$persist_dir\\GoCompare"
    },
    "notes": [
        "Remote connection bookmarks and file backups are stored in the GoCompare folder inside the app directory, since GOCOMPARE_DATA_DIR is redirected there.",
        "Language, theme and palette preferences are still saved to %USERPROFILE%\\.config\\gocompare\\settings.json."
    ],
    "checkver": {
        "github": "https://github.com/jhzhang09/gocompare"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jhzhang09/gocompare/releases/download/v$version/gocompare-$version-windows-amd64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/jhzhang09/gocompare/releases/download/v$version/gocompare-$version-windows-arm64-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "find": "$basename"
        }
    },
    "persist": [
        "GoCompare"
    ]
}
