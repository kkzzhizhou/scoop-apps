{
    "version": "2.0.1.0",
    "description": "Tool to backup your Remnant 2 saves and view your world rolls",
    "homepage": "https://github.com/Razzmatazzz/RemnantSaveGuardian",
    "license": "GPL-3.0-only",
    "url": "https://github.com/Razzmatazzz/RemnantSaveGuardian/releases/download/2.0.1/RemnantSaveGuardian_2.0.1.0.zip",
    "hash": "870172406170ead00be8072fb94477ce8b2fda0e7f05a435ed5621cedf347d99",
    "shortcuts": [
        [
            "RemnantSaveGuardian.exe",
            "Remnant Save Guardian"
        ]
    ],
    "checkver": {
        "script": [
            "try {",
            "    $latest = Invoke-RestMethod https://api.github.com/repositories/671650722/releases/latest -Headers $(if ($auth = Get-GitHubToken) { @{authorization=\"Bearer $auth\"} })",
            "    $latest.tag_name, $latest.assets[0].name -join ' '",
            "}",
            "catch { '' }"
        ],
        "regex": "\\A(?<tag>[\\d.]+) RemnantSaveGuardian_([\\d.]+)\\.zip\\Z"
    },
    "autoupdate": {
        "url": "https://github.com/Razzmatazzz/RemnantSaveGuardian/releases/download/$matchTag/RemnantSaveGuardian_$version.zip"
    }
}
