    "pre_install": [
        "Set-Content \"$dir\\IceSky.bat\" '@pushd %~dp0",
        "@start uv run python -m http.server 8993 --bind 127.0.0.1",
        "@start http://127.0.0.1:8993",
        "@popd' -Encoding Ascii"
    ],
    "bin": "IceSky.bat",
