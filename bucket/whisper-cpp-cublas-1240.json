        "https://huggingface.co/ggerganov/whisper.cpp/tree/main"
    ],
    "bin": [
        "whisper-bench.exe",
        "whisper-cli.exe",
        "whisper-command.exe",
        "whisper-lsp.exe",
        "whisper-quantize.exe",
        "whisper-server.exe",
        "whisper-stream.exe",
        "whisper-talk-llama.exe",
        "whisper-vad-speech-segments.exe"
    ],
    "url": "https://github.com/ggml-org/whisper.cpp/releases/download/v1.9.2/whisper-cublas-12.4.0-bin-x64.zip",
    "hash": "443110ddaad70d4290ab2e77179e31cf712035bbc4fad56bb4519a90c917b39c",
    "extract_dir": "Release",
    "checkver": {
        "script": [
            "$headers = @{ 'User-Agent' = 'Scoop' }",
            "if ($GitHubToken) { $headers['Authorization'] = 'token ' + $GitHubToken }",
            "$rels = Invoke-RestMethod -Uri 'https://api.github.com/repos/ggml-org/whisper.cpp/releases?per_page=100' -Headers $headers",
            "$tag = ($rels | Where-Object { -not $_.prerelease -and -not $_.draft -and $_.tag_name -match '^v[\\d.]+$' } | Select-Object -First 1).tag_name",
            "if (-not $tag) { throw 'No stable v-tag release found' }",
            "\"$($tag.TrimStart('v'))-12.4.0\""
        ],
        "regex": "((?<app>[\\d.]+)-12\\.4\\.0)"
    },
    "autoupdate": {
        "url": "https://github.com/ggml-org/whisper.cpp/releases/download/v$matchApp/whisper-cublas-12.4.0-bin-x64.zip"
    }
}
