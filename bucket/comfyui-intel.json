{
    "version": "0.37.0",
    "description": "The most powerful and modular diffusion model GUI, api and backend with a graph/nodes interface.",
    "homepage": "https://www.comfy.org",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Comfy-Org/ComfyUI/releases/download/v0.37.0/ComfyUI_windows_portable_intel.7z",
            "hash": "1041af3a25ca2c7b3615db3027ca0fd40df37c1758c4e9955e762672193ac4cc"
        }
    },
    "extract_dir": "ComfyUI_windows_portable",
    "bin": "run_intel_gpu.bat",
    "persist": [
        "ComfyUI\\models",
        "ComfyUI\\custom_nodes",
        "ComfyUI\\user",
        "ComfyUI\\output",
        "ComfyUI\\input",
        "ComfyUI\\extra_model_paths.yaml"
    ],
    "shortcuts": [
        [
            "run_intel_gpu.bat",
            "ComfyUI"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\ComfyUI\\extra_model_paths.yaml\")) { Copy-Item \"$dir\\ComfyUI\\extra_model_paths.yaml.example\" \"$dir\\ComfyUI\\extra_model_paths.yaml\" -ErrorAction SilentlyContinue }"
    ],
    "notes": [
        "ComfyUI starts a local web server and opens the UI in your browser.",
        "Models, custom nodes, workflows and generated media are kept in the app's ComfyUI folder and are preserved across updates.",
        "This portable build targets Intel GPUs; keep your Intel graphics drivers up to date."
    ],
    "checkver": {
        "github": "https://github.com/Comfy-Org/ComfyUI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Comfy-Org/ComfyUI/releases/download/v$version/ComfyUI_windows_portable_intel.7z",
                "extract_dir": "ComfyUI_windows_portable"
            }
        }
    }
}
