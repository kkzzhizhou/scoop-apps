        "url": "https://github.com/iebb/mithka#BSD-3-Clause-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/iebb/mithka/releases/download/v1.5.5/mithka-1.5.5-20260924-windows-x64-setup.exe",
            "hash": "130a5841b7014aec80f153b9971e43828d95b3d9b0fe9319032f0ed2508b7650"
        },
        "arm64": {
            "url": "https://github.com/iebb/mithka/releases/download/v1.5.5/mithka-1.5.5-20260924-windows-arm64-setup.exe",
            "hash": "de8c8483aef02aa3e70ab016c488bea090b78feedb750fa036b5bd210fb4e2cd"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\ad.neko\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\ad.neko\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "mithka.exe",
    "shortcuts": [
        [
            "mithka.exe",
            "Mithka"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/iebb/mithka/releases/latest",
        "jp": "$.assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+)/mithka-([\\d.]+)-(?<date>[\\d]+)-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iebb/mithka/releases/download/v$version/mithka-$version-$matchDate-windows-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/iebb/mithka/releases/download/v$version/mithka-$version-$matchDate-windows-arm64-setup.exe"
            }
        }
    }
}
