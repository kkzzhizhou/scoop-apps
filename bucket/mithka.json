        "url": "https://github.com/iebb/mithka#BSD-3-Clause-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/iebb/mithka/releases/download/v1.6.10/mithka-1.6.10-20261009-windows-x64-setup.exe",
            "hash": "bef402ebbe0ee7ccfb2a3c667cee8755354384a1b06d467ba520f4babc960edc"
        },
        "arm64": {
            "url": "https://github.com/iebb/mithka/releases/download/v1.6.10/mithka-1.6.10-20261009-windows-arm64-setup.exe",
            "hash": "471e0026aa0d01a6eb1f6f3391e7ed40b9d1ed3e8c44f0c277c581cbcebf641d"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\ad.neko\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\ad.neko\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "mithka.exe",
    "shortcuts": [
        [
            "mithka.exe",
            "Mithka"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/iebb/mithka/releases/latest",
        "jp": "$.assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+)/mithka-([\\d.]+)-(?<date>[\\d]+)-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iebb/mithka/releases/download/v$version/mithka-$version-$matchDate-windows-x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/iebb/mithka/releases/download/v$version/mithka-$version-$matchDate-windows-arm64-setup.exe"
            }
        }
    }
}
