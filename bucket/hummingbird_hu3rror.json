{
    "version": "0.3.0",
    "description": "Modern music player written in Rust using GPUI, focused on performance, extensibility and design",
    "homepage": "https://git.mailliw.org/hummingbird/hummingbird",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/hummingbird-player/hummingbird/releases/download/0.3.0/Hummingbird-x86_64.exe#/Hummingbird.exe",
            "hash": "f6e941f690842601fb535152e1190498e21c15d61fa57b798cd917d8c5444e3e"
        },
        "arm64": {
            "url": "https://github.com/hummingbird-player/hummingbird/releases/download/0.3.0/Hummingbird-aarch64.exe#/Hummingbird.exe",
            "hash": "d7a34edc79d4bb7699f0e1f18fb3f7db3ec612ca6a0d3f6b1fe863ef2c3bfe10"
        }
    },
    "bin": "Hummingbird.exe",
    "persist_external": [
        [
            "$env:AppData\\mailliw\\hummingbird",
            "data",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "shortcuts": [
        [
            "Hummingbird.exe",
            "Hummingbird"
        ]
    ],
    "checkver": {
        "github": "https://github.com/hummingbird-player/hummingbird"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/hummingbird-player/hummingbird/releases/download/$version/Hummingbird-x86_64.exe#/Hummingbird.exe"
            },
            "arm64": {
                "url": "https://github.com/hummingbird-player/hummingbird/releases/download/$version/Hummingbird-aarch64.exe#/Hummingbird.exe"
            }
        }
    }
}
