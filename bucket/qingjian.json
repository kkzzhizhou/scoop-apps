{
    "version": "0.3.2",
    "description": "用 Rust 写的拼音输入法，候选词旁多一条正在学的语言的译词",
    "homepage": "https://qingjian.app/",
    "license": "GPL-3.0-or-later",
    "notes": "青简是 TSF 输入法，注册 DLL 要写 HKCR 与 HKLM\\SOFTWARE\\Microsoft\\CTF。输入引擎 qingjian-server 在切到青简时自动拉起，也可以从开始菜单启动。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/qingjian-team/qingjian/releases/download/v0.3.2/qingjian-0.3.2-windows-x86_64-setup.exe",
            "hash": "7437277f82d940a573cf47aa8994600a2a1b9b73625643114807452a017f925b"
        }
    },
    "innosetup": true,
    "post_install": [
        "$clsid = '{4FDCA82D-E923-49BF-9E75-BB906B93B8BB}'",
        "$tsf = @(",
        "    @{ Dll = (Get-ChildItem -LiteralPath $dir -Filter 'qingjian_tsf-*.dll' | Where-Object { $_.Name -notlike '*-x86.dll' } | Select-Object -First 1); Regsvr = \"$env:windir\\System32\\regsvr32.exe\" },",
        "    @{ Dll = (Get-ChildItem -LiteralPath $dir -Filter 'qingjian_tsf-*-x86.dll' | Select-Object -First 1); Regsvr = \"$env:windir\\SysWOW64\\regsvr32.exe\" }",
        ") | Where-Object { $_.Dll }",
        "& \"$env:windir\\System32\\icacls.exe\" $dir /grant '*S-1-15-2-1:(OI)(CI)RX' /T /C /Q | Out-Null",
        "$elevated = ([Security.Principal.WindowsPrincipal]::new([Security.Principal.WindowsIdentity]::GetCurrent())).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "try {",
        "    foreach ($item in $tsf) {",
        "        if ($elevated) { & $item.Regsvr '/s' $item.Dll.FullName }",
        "        else { Start-Process -FilePath $item.Regsvr -ArgumentList '/s', $item.Dll.FullName -Verb RunAs -Wait -ErrorAction Stop }",
        "    }",
        "} catch {",
        "    Write-Host '注册「青简」文本服务失败，请以管理员身份运行 regsvr32 注册安装目录下的 qingjian_tsf-<版本>.dll。' -ForegroundColor Yellow",
        "}",
        "try {",
        "    if (-not ('Qingjian.Tsf' -as [type])) {",
        "        Add-Type -Namespace 'Qingjian' -Name 'Tsf' -MemberDefinition '[DllImport(\"input.dll\", CharSet = CharSet.Unicode)] public static extern bool InstallLayoutOrTip(string psz, uint dwFlags);'",
        "    }",
        "    if (-not [Qingjian.Tsf]::InstallLayoutOrTip(\"0x0804:$clsid{8119F8E0-CF81-423B-9189-C0D7374324B3}\", 0)) {",
        "        Write-Host '没能自动添加「青简」键盘，请在「设置 → 时间和语言 → 语言和区域 → 中文(简体) → 键盘」里手动添加。' -ForegroundColor Yellow",
        "    }",
        "} catch {",
        "    Write-Host \"没能自动添加「青简」键盘：$($_.Exception.Message)\" -ForegroundColor Yellow",
        "}"
    ],
    "shortcuts": [
        [
            "qingjian-server.exe",
            "青简"
        ],
        [
            "qingjian-settings.exe",
            "青简设置"
        ]
    ],
    "pre_uninstall": [
        "$clsid = '{4FDCA82D-E923-49BF-9E75-BB906B93B8BB}'",
        "Get-Process -Name qingjian-server, qingjian-settings -ErrorAction SilentlyContinue | Stop-Process -Force",
        "try {",
        "    if (-not ('Qingjian.Tsf' -as [type])) {",
        "        Add-Type -Namespace 'Qingjian' -Name 'Tsf' -MemberDefinition '[DllImport(\"input.dll\", CharSet = CharSet.Unicode)] public static extern bool InstallLayoutOrTip(string psz, uint dwFlags);'",
        "    }",
        "    [void][Qingjian.Tsf]::InstallLayoutOrTip(\"0x0804:$clsid{8119F8E0-CF81-423B-9189-C0D7374324B3}\", 1)",
        "} catch {",
        "    Write-Host \"没能自动移除「青简」键盘：$($_.Exception.Message)\" -ForegroundColor Yellow",
        "}",
        "$tsf = @(",
        "    @{ Dll = (Get-ChildItem -LiteralPath $dir -Filter 'qingjian_tsf-*.dll' | Where-Object { $_.Name -notlike '*-x86.dll' } | Select-Object -First 1); Regsvr = \"$env:windir\\System32\\regsvr32.exe\" },",
        "    @{ Dll = (Get-ChildItem -LiteralPath $dir -Filter 'qingjian_tsf-*-x86.dll' | Select-Object -First 1); Regsvr = \"$env:windir\\SysWOW64\\regsvr32.exe\" }",
        ") | Where-Object { $_.Dll }",
        "try {",
        "    foreach ($item in $tsf) { Start-Process -FilePath $item.Regsvr -ArgumentList '/u', '/s', $item.Dll.FullName -Verb RunAs -Wait -ErrorAction Stop }",
        "} catch {",
        "    Write-Host \"注销「青简」文本服务失败：$($_.Exception.Message)\" -ForegroundColor Yellow",
        "}"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/qingjian-team/qingjian/releases",
        "regex": "/releases/download/v([\\d.]+)/qingjian-\\1-windows-x86_64-setup\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qingjian-team/qingjian/releases/download/v$version/qingjian-$version-windows-x86_64-setup.exe"
            }
        }
    }
}
