{
    "version": "26.9.1",
    "description": "⚡️ Blazing fast terminal file manager written in Rust, based on async I/O.",
    "homepage": "https://github.com/sxyazi/yazi",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sxyazi/yazi/releases/download/v26.9.1/yazi-x86_64-pc-windows-msvc.zip",
            "hash": "7c033e5f2de6355fd03d865319053fc97db780275974ed17653c057f5d0f8d21",
            "extract_dir": "yazi-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/sxyazi/yazi/releases/download/v26.9.1/yazi-aarch64-pc-windows-msvc.zip",
            "hash": "4d50878132db344dc208f84d8db0799f00905aa36dec30f63beb826f7c760b12",
            "extract_dir": "yazi-aarch64-pc-windows-msvc"
        }
    },
    "post_install": [
        "$appDataPath = \"$env:APPDATA\\yazi\"",
        "$persistPath = \"$persist_dir\\Roaming\"",
        "if (Test-Path $appDataPath) {",
        "    Remove-Item $appDataPath -Recurse -Force",
        "}",
        "if (-Not (Test-Path $persistPath)) {",
        "    New-Item -Path \"$persistPath\" -ItemType Directory | Out-Null",
        "}",
        "New-Item -ItemType Junction -Path \"$appDataPath\" -Target \"$persistPath\" | Out-Null"
    ],
    "bin": [
        "ya.exe",
        "yazi.exe"
    ],
    "post_uninstall": [
        "$appDataPath = \"$env:APPDATA\\con-terminal\"",
        "if (Test-Path $appDataPath) {",
        "    Remove-Item $appDataPath -Recurse -Force",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/sxyazi/yazi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sxyazi/yazi/releases/download/v$version/yazi-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/sxyazi/yazi/releases/download/v$version/yazi-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
