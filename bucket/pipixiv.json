{
    "version": "2.6.0",
    "description": "一个使用Compose Multiplatform开发的第三方Pixiv客户端，支持国内直连",
    "homepage": "https://github.com/darriousliu/PiPixiv",
    "license": {
        "identifier": "Apache-2.0 license",
        "url": "https://github.com/darriousliu/PiPixiv#Apache-2.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/darriousliu/PiPixiv/releases/download/v2.6.0/PiPixiv-v2.6.0-windows-x86_64.msi",
            "hash": "97d1c64982790d6cba9e30797f05b703f53d673d9508e2819899e96ee82953ff"
        }
    },
    "extract_dir": "PiPixiv\\PiPixiv",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\nucleus\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\PiPixiv\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\nucleus\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\PiPixiv\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "PiPixiv.exe",
    "shortcuts": [
        [
            "PiPixiv.exe",
            "PiPixiv"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/darriousliu/PiPixiv/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/darriousliu/PiPixiv/releases/download/v$version/PiPixiv-v$version-windows-x86_64.msi"
            }
        }
    }
}
