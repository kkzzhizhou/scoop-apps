    "extract_dir": "Zhihu-Hyperion",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:USERPROFILE\\.zhihu-hyperion\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:USERPROFILE\\.zhihu-hyperion\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "Zhihu-Hyperion.exe",
    "shortcuts": [
        [
            "Zhihu-Hyperion.exe",
            "Zhihu-Hyperion"
        ]
    ],
    "checkver": {
