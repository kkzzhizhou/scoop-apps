{
    "version": "0.12.12",
    "description": "An open-source ebook reader designed for immersive and deep reading experiences",
    "homepage": "https://readest.com/",
    "license": {
        "identifier": "AGPL-3.0-or-later",
        "url": "https://github.com/readest/readest/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/readest/readest/releases/download/v0.12.12/Readest_0.12.12_x64-setup.exe#/dl.7z",
            "hash": "ad534a31239b651342a484e1af2c9d1038644143f26ca9eb3891a7d94b15a6c5"
        },
        "arm64": {
            "url": "https://github.com/readest/readest/releases/download/v0.12.12/Readest_0.12.12_arm64-setup.exe#/dl.7z",
            "hash": "8ab8c049ff7329456e3af9d424693f4267bcdf7df80f336642ae0c042b25409a"
        }
    },
    "shortcuts": [
        [
            "readest.exe",
            "Readest"
        ]
    ],
    "post_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Force -Recurse",
        "Rename-Item -Path \"$dir\\`$TEMP\" -NewName \"redist\"",
        "$appDataPath = \"$env:APPDATA\\com.bilingify.readest\"",
        "$appLocalDataPath = \"$env:LOCALAPPDATA\\com.bilingify.readest\"",
        "$persistLocal = \"$persist_dir\\Local\"",
        "$persistRoaming = \"$persist_dir\\Roaming\"",
        "function Test-PersistJunction($item, $target) {",
        "    if (-not $item) { return $false }",
        "    $linkTarget = if ($item.PSObject.Properties['LinkTarget'] -and $item.LinkTarget) { $item.LinkTarget } else { $item.Target }",
        "    if ($linkTarget -is [array]) { $linkTarget = $linkTarget[0] }",
        "    if (-not $linkTarget) { return $false }",
        "    return $linkTarget.ToString().TrimEnd('\\', '/') -ieq $target.TrimEnd('\\', '/')",
        "}",
        "function Remove-PersistTarget($path) {",
        "    $item = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue",
        "    if ($item) {",
        "        Remove-Item -LiteralPath $path -Force -Recurse -ErrorAction Stop",
        "    }",
        "}",
        "$appData = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "$isJunction = [bool]($appData -and ($appData.Attributes -band [System.IO.FileAttributes]::ReparsePoint))",
        "if (-not ($isJunction -and (Test-PersistJunction $appData $persistRoaming))) {",
        "    $persistHasData = (Test-Path -LiteralPath $persistRoaming) -and (Get-ChildItem -LiteralPath $persistRoaming -Force -ErrorAction SilentlyContinue | Select-Object -First 1)",
        "    if (-not $persistHasData) {",
        "        New-Item -ItemType Directory -Path (Split-Path -Path $persistRoaming -Parent) -Force -ErrorAction Stop | Out-Null",
        "        Remove-PersistTarget $persistRoaming",
        "        if ($appData -and -not $isJunction) {",
        "            Move-Item -LiteralPath $appDataPath -Destination $persistRoaming -Force -ErrorAction Stop",
        "            $appData = $null",
        "        } else {",
        "            New-Item -Path $persistRoaming -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "        }",
        "    }",
        "    if ($appData -and -not $isJunction) {",
        "        $bakName = \"com.bilingify.readest.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Rename-Item -LiteralPath $appDataPath -NewName $bakName -Force -ErrorAction Stop",
        "        Write-Host \"Existing Readest roaming data has been backed up to: $bakName\" -ForegroundColor Yellow",
        "    }",
        "    if ($isJunction) {",
        "        [System.IO.Directory]::Delete($appDataPath)",
        "    }",
        "    New-Item -ItemType Junction -Path $appDataPath -Target $persistRoaming -ErrorAction Stop | Out-Null",
        "}",
        "$appData = Get-Item -LiteralPath $appLocalDataPath -Force -ErrorAction SilentlyContinue",
        "$isJunction = [bool]($appData -and ($appData.Attributes -band [System.IO.FileAttributes]::ReparsePoint))",
        "if (-not ($isJunction -and (Test-PersistJunction $appData $persistLocal))) {",
        "    $persistHasData = (Test-Path -LiteralPath $persistLocal) -and (Get-ChildItem -LiteralPath $persistLocal -Force -ErrorAction SilentlyContinue | Select-Object -First 1)",
        "    if (-not $persistHasData) {",
        "        New-Item -ItemType Directory -Path (Split-Path -Path $persistLocal -Parent) -Force -ErrorAction Stop | Out-Null",
        "        Remove-PersistTarget $persistLocal",
        "        if ($appData -and -not $isJunction) {",
        "            Move-Item -LiteralPath $appLocalDataPath -Destination $persistLocal -Force -ErrorAction Stop",
        "            $appData = $null",
        "        } else {",
        "            New-Item -Path $persistLocal -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "        }",
        "    }",
        "    if ($appData -and -not $isJunction) {",
        "        $bakName = \"com.bilingify.readest.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Rename-Item -LiteralPath $appLocalDataPath -NewName $bakName -Force -ErrorAction Stop",
        "        Write-Host \"Existing Readest local data has been backed up to: $bakName\" -ForegroundColor Yellow",
        "    }",
        "    if ($isJunction) {",
        "        [System.IO.Directory]::Delete($appLocalDataPath)",
        "    }",
        "    New-Item -ItemType Junction -Path $appLocalDataPath -Target $persistLocal -ErrorAction Stop | Out-Null",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/readest/readest"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/readest/readest/releases/download/v$version/Readest_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/readest/readest/releases/download/v$version/Readest_$version_arm64-setup.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "You may need to install Edge WebView2 Runtime to use Readest.",
        "A installer of Edge WebView2 Runtime is available under the 'redist' folder of the Pot installation directory."
    ]
}
