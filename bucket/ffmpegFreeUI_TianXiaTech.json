            "hash": "88a2709b1d9a41284f50fb90d062780fb8e40e32c253a5bbba30eb1ecbd6f17e"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.40/FFmpegFreeUI.arm64.exe",
            "hash": "378a7282c2ccdee9364c5215aad44fb8951304150fd2b169248dffa7bc2b43a5"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
    "shortcuts": [
        [
            "FFmpegFreeUI.exe",
            "FFmpegFreeUI"
        ]
