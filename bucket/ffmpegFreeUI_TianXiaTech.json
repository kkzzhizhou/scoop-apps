            "hash": "37060a95b039547144a68d6084dd4dd8d5b515c381d8ef2a87e9f69d30a04b42"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.1.36/FFmpegFreeUI.arm64.exe",
            "hash": "dea7f86a198435667c20b8d27fefb4a218364e0acda2b0159039f06f7566ff47"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
