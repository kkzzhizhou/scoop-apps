            "hash": "0d62bc702d56e6af223f41366cfa521b8cea59573652b28ff6f25fe109343078"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.1.40/FFmpegFreeUI.arm64.exe",
            "hash": "5768156fca8506bc82379e9e6ee72b179f23ee821405b0feb6cbe7d31aada0ae"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
    "shortcuts": [
        [
            "FFmpegFreeUI.exe",
