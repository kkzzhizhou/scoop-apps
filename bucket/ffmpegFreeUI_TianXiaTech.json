            "hash": "ff850de58389cb029c3b277e205285bb2832d349bc957913498318852fae719e"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.42/FFmpegFreeUI.arm64.exe",
            "hash": "e95d8340a3812eb186fb55f7e104c74ba84bca4ab334bae2c5de8603a2f90220"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
