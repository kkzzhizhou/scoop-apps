{
    "homepage": "https://github.com/Lake1059/FFmpegFreeUI",
    "description": "3FUI 是 ffmpeg 在 Windows 上的轻度专业交互外壳，收录大量参数，界面美观，交互友好。此项目面向国内使用环境，让普通人也能够轻松压制视频和转换格式",
    "version": "6.1.35",
    "license": "MIT",
    "depends": "versions/windowsdesktop-runtime-10.0",
    "notes": "Installing the .NET Desktop Runtime dependency requires administrator privileges.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.1.35/FFmpegFreeUI.x64.exe",
            "hash": "c388e4c2b3177cf5cac9f223e226e95ea89b3aef8a0a5a7586ed235d24ce0c22"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.1.35/FFmpegFreeUI.arm64.exe",
            "hash": "27cb8b55c3d8e352b223dc3d8d6d96dbc5198ecc97bb56389a99f3197c30979d"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
    "shortcuts": [
        [
            "FFmpegFreeUI.exe",
            "FFmpegFreeUI"
        ]
    ],
    "autoupdate": {
        "architecture": {
