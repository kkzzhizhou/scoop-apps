{
    "homepage": "https://github.com/Lake1059/FFmpegFreeUI",
    "description": "3FUI 是 ffmpeg 在 Windows 上的轻度专业交互外壳，收录大量参数，界面美观，交互友好。此项目面向国内使用环境，让普通人也能够轻松压制视频和转换格式",
    "version": "6.2.23",
    "license": "MIT",
    "depends": "versions/windowsdesktop-runtime-10.0",
    "notes": "Installing the .NET Desktop Runtime dependency requires administrator privileges.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.23/FFmpegFreeUI.x64.exe",
            "hash": "d0f3637b4327c1df20c58498510b4c7b39251bf74ca3d4cded2cb10fef370e99"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.23/FFmpegFreeUI.arm64.exe",
            "hash": "9efac9c01975fe467e7e10ca11382187d05ab3f3494e96ca049fd3eaec15063b"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
    "shortcuts": [
        [
            "FFmpegFreeUI.exe",
            "FFmpegFreeUI"
        ]
    ],
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/$version/FFmpegFreeUI.x64.exe"
            },
            "arm64": {
                "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/$version/FFmpegFreeUI.arm64.exe"
            }
        },
        "hash": {
            "mode": "download"
        }
    }
}
