        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.30/FFmpegFreeUI.arm64.exe",
            "hash": "59709c9469aceaf91ea868791e7da462af10c72bf0c366dc199def7c86c38cbc"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
