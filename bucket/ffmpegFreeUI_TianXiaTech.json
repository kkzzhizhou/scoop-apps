            "hash": "a17b021cd356ee553808c7d5ccb03e784336a9ff3b7f9a89c10a47b53ad6fb50"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.38/FFmpegFreeUI.arm64.exe",
            "hash": "d4570ecd773293f13d9365b4fe6a3f5457bd49fbe8d3743404d91feea375382d"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
