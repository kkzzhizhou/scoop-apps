            "hash": "398cfc9fc45a9cea45fb4d0984abdafe26f8ff0415562e5dc25fa427b33da4d1"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.1.28/FFmpegFreeUI.arm64.exe",
            "hash": "322f5eeda78475d7109bdb7874244b133d7d6e80c03e3e4de2378b9c4eda8695"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
    "shortcuts": [
        [
            "FFmpegFreeUI.exe",
            "FFmpegFreeUI"
        ]
    ],
    "autoupdate": {
