            "hash": "6032a7bef0338e04e18de99a5d1552b2662657b8ad934ca68090a15e94e6c526"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.9/FFmpegFreeUI.arm64.exe",
            "hash": "787d95f0879132ae835fb31e8d876c0bd17f89dd183058d6f08330ea120cf11e"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
    "shortcuts": [
        [
            "FFmpegFreeUI.exe",
            "FFmpegFreeUI"
        ]
    ],
    "autoupdate": {
