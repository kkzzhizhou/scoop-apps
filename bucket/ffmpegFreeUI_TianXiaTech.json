            "hash": "29a4d87818c86282b58507cc50d8904835fe0ae7a0bc29a8c7a1590b0c5cfa4c"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.32/FFmpegFreeUI.arm64.exe",
            "hash": "b0a6320e16a34090723737838c84e9a0a043fbdb3c3188da1839bb84775abe0f"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
    "shortcuts": [
        [
