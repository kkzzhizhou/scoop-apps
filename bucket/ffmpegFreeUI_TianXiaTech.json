            "hash": "707391ffd9548359e45ee32e73cfcb9210da1f529715fea49dc224ba5f679cd1"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.2.39/FFmpegFreeUI.arm64.exe",
