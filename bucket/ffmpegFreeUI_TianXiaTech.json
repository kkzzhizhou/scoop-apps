            "hash": "96cbd90f420aabc7e5f771c105f6427c279903ad313134a57a541fbb2f4a6bee"
        },
        "arm64": {
            "url": "https://github.com/Lake1059/FFmpegFreeUI/releases/download/6.1.38/FFmpegFreeUI.arm64.exe",
            "hash": "81fa33f4f28ef1ab8ffc570c0d9c0849dfb2b7b40bc1cd49f968358279a59f11"
        }
    },
    "pre_install": [
        "$arch = if ($architecture -eq 'arm64') { 'arm64' } else { 'x64' }",
        "Move-Item \"$dir\\FFmpegFreeUI.$arch.exe\" \"$dir\\FFmpegFreeUI.exe\" -Force"
    ],
    "checkver": "github",
    "persist": "Preset",
