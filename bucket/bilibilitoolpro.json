    "homepage": "https://github.com/RayWangQvQ/BiliBiliToolPro",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.0.5/bilibili-tool-pro-v4.0.5-win-x64.zip",
            "hash": "bba3d27f062dc774761ed91081826542432554aa8cd70d947239a02890f59ffe",
            "extract_dir": "win-x64"
        },
        "32bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.0.5/bilibili-tool-pro-v4.0.5-win-x86.zip",
            "hash": "faaab0a8393944ab0fdb9d927c7c5ce4caeb9b7a7e6f2832c8e2f322e412dcc5",
            "extract_dir": "win-x86"
        },
        "arm64": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.0.5/bilibili-tool-pro-v4.0.5-win-arm64.zip",
            "hash": "d328411af91aad47c47ce3896863b80896a8cb865cd07e2cbd3d81a5b57b2556",
            "extract_dir": "win-arm64"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Ray*.exe\" | Rename-Item -NewName 'BiliBiliToolPro.exe'",
        "$CONT = @(",
        "    '{'",
        "    '\"BiliBiliCookies\":['",
        "    '],'",
        "    '}'",
        ")",
        "foreach ($f in @('cookies.json')) {",
        "    if (-not (Test-Path \"$persist_dir\\$f\")) {",
        "        Write-Host 'File' $f 'does not exists. Creating' -f Yellow",
        "        Set-Content \"$dir\\$f\" $CONT -Encoding Ascii",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "BiliBiliToolPro.exe",
            "BiliBiliToolPro"
        ]
    ],
    "persist": [
        "appsettings.Development.json",
        "appsettings.json",
        "appsettings.Production.json",
        "cookies.json"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/RayWangQvQ/BiliBiliToolPro/releases",
        "jp": "$[0].tag_name",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-arm64.zip"
            }
        }
    }
}
