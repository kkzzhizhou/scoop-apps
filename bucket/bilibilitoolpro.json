    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.3/bilibili-tool-pro-v4.2.3-win-x64.zip",
            "hash": "bc00f0c5c5f506786303f1a7135943bd1335cf4c9515317565a21874b4907a6c",
            "extract_dir": "win-x64"
        },
        "32bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.3/bilibili-tool-pro-v4.2.3-win-x86.zip",
            "hash": "27f2158080beb72f23df6327cbf19fa3769df10e08814b5a0b1f50811dab2b4e",
            "extract_dir": "win-x86"
        },
        "arm64": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.3/bilibili-tool-pro-v4.2.3-win-arm64.zip",
            "hash": "50d75ac171fa03c34759fa35dfc0bd834dd74890f33253d8dade8164526f8ca4",
            "extract_dir": "win-arm64"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Ray*.exe\" | Rename-Item -NewName 'BiliBiliToolPro.exe'",
        "$CONT = @(",
        "    '{'",
        "    '\"BiliBiliCookies\":['",
        "    '],'",
        "    '}'",
        ")",
        "foreach ($f in @('cookies.json')) {",
        "    if (-not (Test-Path \"$persist_dir\\$f\")) {",
        "        Write-Host 'File' $f 'does not exists. Creating' -f Yellow",
        "        Set-Content \"$dir\\$f\" $CONT -Encoding Ascii",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "BiliBiliToolPro.exe",
            "BiliBiliToolPro"
        ]
    ],
    "persist": [
        "appsettings.Development.json",
        "appsettings.json",
        "appsettings.Production.json",
        "cookies.json"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/RayWangQvQ/BiliBiliToolPro/releases",
        "jp": "$[0].tag_name",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-arm64.zip"
            }
        }
    }
}
