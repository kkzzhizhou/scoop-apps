    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.1/bilibili-tool-pro-v4.2.1-win-x64.zip",
            "hash": "ae8eb59c788515243fe68369cbb1a5038f63be738b74f296b247dd3d9902fc02",
            "extract_dir": "win-x64"
        },
        "32bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.1/bilibili-tool-pro-v4.2.1-win-x86.zip",
            "hash": "518d1db67ec028297f4e0297468a722b7237fac081b0e37b142ac555d544c718",
            "extract_dir": "win-x86"
        },
        "arm64": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.1/bilibili-tool-pro-v4.2.1-win-arm64.zip",
            "hash": "9938a38e46d6743569883db1c1d48e1d3862ea9a4d7563629b6d93b645cde260",
            "extract_dir": "win-arm64"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Ray*.exe\" | Rename-Item -NewName 'BiliBiliToolPro.exe'",
        "$CONT = @(",
        "    '{'",
        "    '\"BiliBiliCookies\":['",
        "    '],'",
        "    '}'",
        ")",
        "foreach ($f in @('cookies.json')) {",
        "    if (-not (Test-Path \"$persist_dir\\$f\")) {",
        "        Write-Host 'File' $f 'does not exists. Creating' -f Yellow",
        "        Set-Content \"$dir\\$f\" $CONT -Encoding Ascii",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "BiliBiliToolPro.exe",
            "BiliBiliToolPro"
        ]
    ],
    "persist": [
        "appsettings.Development.json",
        "appsettings.json",
        "appsettings.Production.json",
        "cookies.json"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/RayWangQvQ/BiliBiliToolPro/releases",
        "jp": "$[0].tag_name",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-arm64.zip"
            }
        }
    }
}
