    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.2/bilibili-tool-pro-v4.2.2-win-x64.zip",
            "hash": "6d90263f554af6a3f5a634b53af38ef2a91b1a4252e6c18628cc31ea19548978",
            "extract_dir": "win-x64"
        },
        "32bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.2/bilibili-tool-pro-v4.2.2-win-x86.zip",
            "hash": "8822d6576a56495834b3179ca3c2f0b1ed680baedad5d36926ddfece5125846b",
            "extract_dir": "win-x86"
        },
        "arm64": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.2.2/bilibili-tool-pro-v4.2.2-win-arm64.zip",
            "hash": "898ad4a6eea41869402659baaa8a7fe426669e899996c7ab088f65edebbe1140",
            "extract_dir": "win-arm64"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Ray*.exe\" | Rename-Item -NewName 'BiliBiliToolPro.exe'",
        "$CONT = @(",
        "    '{'",
        "    '\"BiliBiliCookies\":['",
        "    '],'",
        "    '}'",
        ")",
        "foreach ($f in @('cookies.json')) {",
        "    if (-not (Test-Path \"$persist_dir\\$f\")) {",
        "        Write-Host 'File' $f 'does not exists. Creating' -f Yellow",
        "        Set-Content \"$dir\\$f\" $CONT -Encoding Ascii",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "BiliBiliToolPro.exe",
            "BiliBiliToolPro"
        ]
    ],
    "persist": [
        "appsettings.Development.json",
        "appsettings.json",
        "appsettings.Production.json",
        "cookies.json"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/RayWangQvQ/BiliBiliToolPro/releases",
        "jp": "$[0].tag_name",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-arm64.zip"
            }
        }
    }
}
