    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.0.7/bilibili-tool-pro-v4.0.7-win-x64.zip",
            "hash": "5c930635854f05a031a685e703e02f282b37c36981159d1b713ba7fa9fe41383",
            "extract_dir": "win-x64"
        },
        "32bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.0.7/bilibili-tool-pro-v4.0.7-win-x86.zip",
            "hash": "c789ea8b610da25ae4ff56da6d48b26ff488244b06f13e06e650d56cd86bdf5a",
            "extract_dir": "win-x86"
        },
        "arm64": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.0.7/bilibili-tool-pro-v4.0.7-win-arm64.zip",
            "hash": "585a8d5b01c25da2bd36c65f43834284251fabcc6ed349ebf8bd7642897a9ade",
            "extract_dir": "win-arm64"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\Ray*.exe\" | Rename-Item -NewName 'BiliBiliToolPro.exe'",
        "$CONT = @(",
        "    '{'",
        "    '\"BiliBiliCookies\":['",
        "    '],'",
        "    '}'",
        ")",
        "foreach ($f in @('cookies.json')) {",
        "    if (-not (Test-Path \"$persist_dir\\$f\")) {",
        "        Write-Host 'File' $f 'does not exists. Creating' -f Yellow",
        "        Set-Content \"$dir\\$f\" $CONT -Encoding Ascii",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "BiliBiliToolPro.exe",
            "BiliBiliToolPro"
        ]
    ],
    "persist": [
        "appsettings.Development.json",
        "appsettings.json",
        "appsettings.Production.json",
        "cookies.json"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/RayWangQvQ/BiliBiliToolPro/releases",
        "jp": "$[0].tag_name",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/$version/bilibili-tool-pro-v$version-win-arm64.zip"
            }
        }
    }
}
