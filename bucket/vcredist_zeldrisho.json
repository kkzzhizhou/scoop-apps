    "pre_install": [
        "if (!(is_admin)) { \"$app requires admin rights to $cmd\"; break }",
        "Start-Process \"$dir\\$fname\" -ArgumentList @('/fo', '/quiet', '/norestart') -Wait -Verb RunAs"
    ],
    "post_install": "Remove-Item \"$dir\\$fname\"",
    "checkver": {
        "script": [
            "$url = 'https://aka.ms/vc14/vc_redist.x64.exe'",
            "$dl = cache_path 'vcredist' 'unknown' $url",
            "Invoke-WebRequest $url -OutFile $dl",
            "$ver = (Get-Item $dl).VersionInfo.ProductVersion",
            "Move-Item $dl (cache_path 'vcredist' $ver $url) -Force",
            "$ver"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://aka.ms/vc$majorVersion/vc_redist.x64.exe"
