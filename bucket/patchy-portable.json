{
    "version": "1.33",
    "description": "Open-source image editor focused on PSD compatibility and workflows familiar to Adobe Photoshop users.",
    "homepage": "https://github.com/SethRobinson/Patchy",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/SethRobinson/Patchy#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/SethRobinson/Patchy/releases/download/v1.33/PatchyWindowsNoInstaller.zip",
            "hash": "35f697631fee9875365eb7595d12dd20b93bd23a6b5600f8416f5af00c317dfb"
        },
        "arm64": {
            "url": "https://github.com/SethRobinson/Patchy/releases/download/v1.33/PatchyWindowsArm64NoInstaller.zip",
            "hash": "ea4a04604b56f051a55a1b01556015cb0321e64a29904b4a33cad8d1c9846b8b"
        }
    },
    "extract_dir": "Patchy",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\RTsoft\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\RTsoft\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "patchy.exe",
    "shortcuts": [
        [
            "patchy.exe",
            "Patchy"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/SethRobinson/Patchy/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SethRobinson/Patchy/releases/download/v$version/PatchyWindowsNoInstaller.zip"
            },
            "arm64": {
                "url": "https://github.com/SethRobinson/Patchy/releases/download/v$version/PatchyWindowsArm64NoInstaller.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
