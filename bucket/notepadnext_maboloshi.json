{
    "version": "0.15",
    "description": "A cross-platform reimplementation of Notepad++",
    "homepage": "https://github.com/dail8859/NotepadNext",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dail8859/NotepadNext/releases/download/v0.15/NotepadNext-v0.15-win64.zip",
            "hash": "148aa88d706bb67a7c1f3727953ed686204be52876336971634b0223e6ed2148"
        }
    },
    "post_install": [
        "# 数据迁移",
        "$link = \"$env:APPDATA\\NotepadNext\"",
        "$target = ensure \"$persist_dir\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "NotepadNext.exe",
            "Notepad Next"
        ]
    ],
    "post_uninstall": [
        "# 删除数据软连接",
        "$link = \"$env:APPDATA\\NotepadNext\"",
        "Remove-Item -Path $link -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dail8859/NotepadNext/releases/download/v$version/NotepadNext-v$version-win64.zip"
            }
        }
    }
}
