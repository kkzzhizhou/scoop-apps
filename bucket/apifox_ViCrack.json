    "license": "Freeware",
    "architecture": {
        "32bit": {
            "url": "https://file-assets.apifox.com/download/2.8.46/Apifox-windows-x86-2.8.46.exe#/dl.7z",
            "hash": "2882c7803b4c96c99c24f58077cb6e16930e97782e76633e2b923152bd8ec117"
        },
        "64bit": {
            "url": "https://file-assets.apifox.com/download/2.8.46/Apifox-2.8.46.exe#/dl.7z",
            "hash": "ee38c152aa92a5c4d94b4faef390769f8ce184ab77f8ac21dcdad6c6a149b5f6"
        }
    },
    "pre_install": [
        "Get-Item \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse"
    ],
    "shortcuts": [
        [
            "Apifox.exe",
            "Apifox",
            "--user-data-dir=\"$dir\\UserData\""
        ]
    ],
    "persist": "UserData",
    "checkver": {
        "url": "https://api.apifox.cn/api/v1/configs/client-updates/2.7.29/win64/latest.yml?",
        "regex": "version:\\s*([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://file-assets.apifox.com/download/$version/Apifox-windows-x86-$version.exe#/dl.7z"
            },
            "64bit": {
                "url": "https://file-assets.apifox.com/download/$version/Apifox-$version.exe#/dl.7z"
            }
        }
    }
