            "hash": "a6795cd6f2fc44b6b449520fb450b497e1b948614ef4b71fcc4d7bd2e3f7d2da"
        },
        "64bit": {
            "url": "https://file-assets.apifox.com/download/2.8.51/Apifox-2.8.51.exe#/dl.7z",
            "hash": "fa232bba1ae3c9517136492d066390ca926d0ab8ccf36e585b817437329d2b05"
