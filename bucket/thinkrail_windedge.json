{
    "version": "0.1.3",
    "description": "Vibe code with pi in a lightweight, real IDE",
    "homepage": "https://thinkrail.ai",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JetBrains/thinkrail/releases/download/v0.1.3/thinkrail-windows-x64.exe#/thinkrail.exe",
            "hash": "24c1b76a686f2e4afd3ee1aac366dfe61fa40580f7c3ec65608ead1dc50477f5"
        }
    },
    "bin": "thinkrail.exe",
    "persist": [
        "agent",
        ".local/bin"
    ],
    "shortcuts": [
        [
            "thinkrail.exe",
            "ThinkRail"
        ]
    ],
    "env_set": {
        "PI_CODING_AGENT_DIR": "${'$'}persist_dir\\agent",
        "THINKRAIL_PREFIX": "${'$'}persist_dir\\.local/bin"
    },
    "checkver": {
        "github": "https://github.com/JetBrains/thinkrail"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JetBrains/thinkrail/releases/download/v$version/thinkrail-windows-x64.exe#/thinkrail.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "$basename"
        }
    }
}
