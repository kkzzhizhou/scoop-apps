{
    "version": "0.1.5",
    "description": "Vibe code with pi in a lightweight, real IDE",
    "homepage": "https://thinkrail.ai",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JetBrains/thinkrail/releases/download/v0.1.5/thinkrail-windows-x64.exe#/thinkrail.exe",
            "hash": "064b2b07d2b3e1b561c6c69dceb32c68b0df61def7ae0361c069ebd26f49ab03"
        }
    },
    "bin": "thinkrail.exe",
    "persist": [
        "agent",
        ".local/bin"
    ],
    "shortcuts": [
        [
            "thinkrail.exe",
            "ThinkRail"
        ]
    ],
    "env_set": {
        "PI_CODING_AGENT_DIR": "${'$'}persist_dir\\agent",
        "THINKRAIL_PREFIX": "${'$'}persist_dir\\.local/bin"
    },
    "checkver": {
        "github": "https://github.com/JetBrains/thinkrail"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JetBrains/thinkrail/releases/download/v$version/thinkrail-windows-x64.exe#/thinkrail.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "$basename"
        }
    }
}
