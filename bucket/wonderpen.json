{
    "homepage": "https://www.tominlab.com/en/wonderpen",
    "description": "Professional writing app with a focused and fluid writing experience.",
    "version": "3.4.0",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.tominlab.com/en/term/privacy"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.tominlab.com/to/get-file/cdn?file=WonderPen/desktop/3.4/WonderPen-v3.4.0.8500-win-x64-installer.exe#/dl.7z",
            "hash": "627d07dc88a968481a0c381d95d538c82957ebbd650864eeb334675e01e9c3dd"
        },
        "32bit": {
            "url": "https://www.tominlab.com/to/get-file/cdn?file=WonderPen/desktop/3.4/WonderPen-v3.4.0.8500-win-ia32-installer.exe#/dl.7z",
            "hash": "eb46b6fede51fada65ce10c30c70b29246ff9b93b4f2a41f4c9c420ac77073d5"
        },
        "arm64": {
            "url": "https://www.tominlab.com/to/get-file/cdn?file=WonderPen/desktop/3.4/WonderPen-v3.4.0.8500-win-arm64-installer.exe#/dl.7z",
            "hash": "4c569b1e4445633d8037c53fb99c53a19267f0af4607ff565c958db45801b440"
        }
    },
    "pre_install": [
        "Expand-7ZipArchive \"$dir\\`$PLUGINSDIR\\app-*.7z\" \"$dir\" -Removal",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
    ],
    "post_install": [
        "if (-not (Get-ChildItem \"$persist_dir\\data\" -Force -ErrorAction SilentlyContinue)) {",
        "    if (Test-Path \"$persist_dir\\WonderPen\") {",
        "        info '[Portable Mode] Migrating persist_external data...'",
        "        Move-Item \"$persist_dir\\WonderPen\\*\" \"$persist_dir\\data\"",
        "        Remove-Item \"$persist_dir\\WonderPen\" -Recurse -Force",
        "    } elseif (Test-Path \"$env:APPDATA\\WonderPen\") {",
        "        info '[Portable Mode] Migrating user data from AppData...'",
        "        Move-Item \"$env:APPDATA\\WonderPen\\*\" \"$persist_dir\\data\"",
        "        Remove-Item \"$env:APPDATA\\WonderPen\" -Recurse -Force",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "WonderPen.exe",
            "WonderPen",
            "--wp-user-data-dir=\"$dir\\data\""
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://www.tominlab.com/wonderpen/downloads/all",
        "regex": "WonderPen-v([\\d.]+)\\.(?<build>\\d+)-win-x64-installer\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.tominlab.com/to/get-file/cdn?file=WonderPen/desktop/$majorVersion.$minorVersion/WonderPen-v$version.$matchBuild-win-x64-installer.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://www.tominlab.com/to/get-file/cdn?file=WonderPen/desktop/$majorVersion.$minorVersion/WonderPen-v$version.$matchBuild-win-ia32-installer.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://www.tominlab.com/to/get-file/cdn?file=WonderPen/desktop/$majorVersion.$minorVersion/WonderPen-v$version.$matchBuild-win-arm64-installer.exe#/dl.7z"
            }
        }
    }
}
