    "notes": "首次启动在设置页填 OpenRouter API key（写进用户环境变量，不落文件）；exe 未签名，SmartScreen 拦截时选「更多信息」→「仍要运行」",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jev-chat/jev-chat-windows/releases/download/v0.1.10/jev-chat-windows-v0.1.10.zip",
            "hash": "71238344ddf461a5bc3226594df64df1f3302547e31043e9e70e9261746b5d4f"
        }
    },
    "extract_dir": "jev-chat-windows",
    "shortcuts": [
        [
            "jev-chat-windows.exe",
            "jev-chat-windows"
        ]
    ],
    "persist": "config.json",
    "checkver": {
        "github": "https://github.com/jev-chat/jev-chat-windows"
    },
    "autoupdate": {
        "url": "https://github.com/jev-chat/jev-chat-windows/releases/download/v$version/jev-chat-windows-v$version.zip",
        "hash": {
            "mode": "extract",
            "url": "https://github.com/jev-chat/jev-chat-windows/releases/expanded_assets/v$version",
            "regex": "jev-chat-windows-v$version\\.zip.*?sha256:$sha256"
        }
    },
    "pre_install": "New-Item -ItemType File -Path \"$dir\\config.json\" -Force"
}
