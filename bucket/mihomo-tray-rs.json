{
    "version": "0.3.2",
    "description": "Minimal Windows tray app for the mihomo core",
    "homepage": "https://github.com/maboloshi/mihomo-tray-rs",
    "license": "MIT",
    "suggest": {
        "mihomo": "scoop-private/mihomo-v3"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/maboloshi/mihomo-tray-rs/releases/download/v0.3.2/mihomo-tray-v0.3.2-win-x64.zip",
            "hash": "67fc7650b3cc7e31374dae673993dcb0b5ac59b2a2c21d02094aa58b382a5249"
        }
    },
    "bin": "mihomo-tray.exe",
    "shortcuts": [
        [
            "mihomo-tray.exe",
            "Mihomo Tray",
            "",
            "mihomo-cat.ico"
        ]
    ],
    "persist": [
        "lang",
        "tray.yml"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $registryKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "    Remove-ItemProperty $registryKey -Name 'mihomo-tray' -ErrorAction SilentlyContinue",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/maboloshi/mihomo-tray-rs/releases/download/v$version/mihomo-tray-v$version-win-x64.zip"
            }
        }
    }
}
