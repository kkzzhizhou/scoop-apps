{
    "version": "0.3.0",
    "description": "Minimal Windows tray app for the mihomo core",
    "homepage": "https://github.com/maboloshi/mihomo-tray-rs",
    "license": "MIT",
    "suggest": {
        "mihomo": "scoop-private/mihomo-v3"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/maboloshi/mihomo-tray-rs/releases/download/v0.3.0/mihomo-tray-v0.3.0-win-x64.zip",
            "hash": "8d981eb8e4541ae650ff92d8b7b629c009f387b741661c17cc591f96bf0c3cfe"
        }
    },
    "bin": "mihomo-tray.exe",
    "shortcuts": [
        [
            "mihomo-tray.exe",
            "Mihomo Tray",
            "",
            "mihomo-cat.ico"
        ]
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $rkey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
        "    Remove-ItemProperty $rkey -Name 'mihomo-tray' -ErrorAction SilentlyContinue",
        "}"
    ],
    "persist": [
        "lang",
        "tray.yml"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/maboloshi/mihomo-tray-rs/releases/download/v$version/mihomo-tray-v$version-win-x64.zip"
            }
        }
    }
}
