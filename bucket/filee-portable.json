{
    "version": "2.5.0",
    "description": "Free, open-source file converter. Convert 255 formats offline by drag & drop — images, PDF, Word, Excel, PowerPoint, HWP/HWPX, video, audio, e-books and archives. No upload, no Office needed.",
    "homepage": "https://filee.sh/",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/KnifeLemon/Filee#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/KnifeLemon/Filee/releases/download/v2.5.0/Filee-2.5.0-win-Portable.zip",
            "hash": "a0e6c5f6b623f100c6ed6d4afae96f6efbee6c6e1ad790fe3e789fa4a9bfdf4f"
        },
        "arm64": {
            "url": "https://github.com/KnifeLemon/Filee/releases/download/v2.5.0/Filee-2.5.0-win-arm64-Portable.zip",
            "hash": "d0ffbdf0e8c07838866dd5f13e8e4dfd9b94308c48edb6016f93a6c7744833fb"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\Filee\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Filee\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "Filee.exe",
    "shortcuts": [
        [
            "Filee.exe",
            "Filee"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/KnifeLemon/Filee/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KnifeLemon/Filee/releases/download/v$version/Filee-$version-win-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/KnifeLemon/Filee/releases/download/v$version/Filee-$version-win-arm64-Portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/Filee-$version-SHA256SUMS.txt"
        }
    }
}
