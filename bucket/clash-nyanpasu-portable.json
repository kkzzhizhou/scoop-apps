            "hash": "84dd04730ca2545e4ce956e7e5f88b54e8e17e84145fd16d27088fb4a17c92a6"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\\moe.elaina.clash.nyanpasu\" -Target \"$env:LOCALAPPDATA\\moe.elaina.clash.nyanpasu\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\moe.elaina.clash.nyanpasu\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "post_install": [
        "if (!(Test-Path \"$persist_dir\\.config\\PORTABLE\")) {",
        "    New-Item -Path \"$persist_dir\\.config\\PORTABLE\" -ItemType file | Out-Null",
        "}"
    ],
    "bin": [
        [
            "Clash Nyanpasu.exe",
            "ClashNyanpasu"
        ]
    ],
    "shortcuts": [
        [
            "Clash Nyanpasu.exe",
            "ClashNyanpasu"
        ]
    ],
    "persist": ".config",
    "checkver": {
        "github": "https://api.github.com/repos/libnyanpasu/clash-nyanpasu/releases/latest",
        "jp": "$.tag_name",
        "regex": "v([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/libnyanpasu/clash-nyanpasu/releases/download/v$version/Clash.Nyanpasu_$version_x86_64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/libnyanpasu/clash-nyanpasu/releases/download/v$version/Clash.Nyanpasu_$version_aarch64_portable.zip"
            }
        }
    }
}
