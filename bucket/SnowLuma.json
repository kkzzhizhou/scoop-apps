{
    "version": "2.4.1",
    "description": "A QQ client interoperability runtime with OneBot v11, WebUI, SDK and MCP.",
    "homepage": "https://github.com/SnowLuma/SnowLuma",
    "license": "SnowLuma Source-Available Non-Commercial License",
    "notes": "Start with the SnowLuma shortcut or `snowluma`; manage updates with `scoop update SnowLuma` instead of the built-in updater.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/SnowLuma/SnowLuma/releases/download/v2.4.1/SnowLuma-v2.4.1-win-x64.zip",
            "hash": "32f52539dc1311881065b7f85bb7ef0c5d4f6459e22a702dde4d88fa15fcdf1b"
        }
    },
    "pre_install": "@('@echo off', 'cd /d \"%~dp0\"', '\"%~dp0node.exe\" \"%~dp0check-node-version.cjs\"', 'if errorlevel 1 exit /b 1', '\"%~dp0node.exe\" \"%~dp0index.mjs\" %*') | Set-Content -LiteralPath \"$dir\\snowluma.cmd\" -Encoding Ascii",
    "bin": [
        [
            "snowluma.cmd",
            "snowluma"
        ]
    ],
    "shortcuts": [
        [
            "snowluma.cmd",
            "SnowLuma"
        ]
    ],
    "persist": [
        "config",
        "data",
        "logs"
    ],
    "checkver": {
        "github": "https://github.com/SnowLuma/SnowLuma"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SnowLuma/SnowLuma/releases/download/v$version/SnowLuma-v$version-win-x64.zip"
            }
        }
    }
