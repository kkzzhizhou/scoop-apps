{
    "version": "0.9.2",
    "description": "Lightweight local Markdown editor for macOS and Windows",
    "homepage": "https://kevinxc5.github.io/leafmark",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KevinXC5/leafmark/releases/download/v0.9.2/leafmark-0.9.2-windows-amd64.tar.gz",
            "hash": "5fcac05334e901aa2b1e5a6c0115025511a0778109ff42f337e3da7fae8db460"
        },
        "arm64": {
            "url": "https://github.com/KevinXC5/leafmark/releases/download/v0.9.2/leafmark-0.9.2-windows-arm64.tar.gz",
            "hash": "b12ea26eeb845126bdd01b780709c0ff119db53f920116f50472fc299736cdb6"
        }
    },
    "bin": "Leafmark.exe",
    "persist": [
        "Leafmark"
    ],
    "shortcuts": [
        [
            "Leafmark.exe",
            "Leafmark"
        ]
    ],
    "pre_install": [
        "if (!(Test-Path \"$dir\\Leafmark\")) { New-Item -ItemType Directory -Path \"$dir\\Leafmark\" | Out-Null }"
    ],
    "env_set": {
        "LEAFMARK_NATIVE_DATA_DIR": "$persist_dir\\Leafmark"
    },
    "notes": [
        "Settings (native-settings.json) and recovery drafts (native-recovery.json) are redirected to $dir\\Leafmark via LEAFMARK_NATIVE_DATA_DIR and persisted across updates.",
        "Recent files and workspace state are still stored in %APPDATA%\\Leafmark (the app reads os.UserConfigDir() directly) and are not managed by Scoop.",
        "No checksums file is published; alternative Leafmark.Setup.*.exe installers exist for this release."
    ],
    "checkver": {
        "github": "https://github.com/KevinXC5/leafmark"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KevinXC5/leafmark/releases/download/v$version/leafmark-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/KevinXC5/leafmark/releases/download/v$version/leafmark-$version-windows-arm64.tar.gz"
            }
        }
    }
}
