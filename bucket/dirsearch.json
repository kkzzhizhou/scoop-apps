{
    "version": "0.5.0",
    "description": "Web path scanner.",
    "homepage": "https://github.com/maurosoria/dirsearch",
    "license": "Freeware",
    "suggest": {
        "Python 3.7+": "python"
    },
    "url": "https://github.com/maurosoria/dirsearch/archive/refs/tags/v0.5.0.zip",
    "hash": "eb0913c964c37674095dda07d85bab65bc36e35fdc9716cc4b8aff691e75af5e",
    "pre_install": [
        "Set-Content \"$dir\\dirsearch.bat\" '@pushd %~dp0",
        "python3 \"dirsearch.py\" %*",
        "@popd' -Encoding Ascii"
    ],
    "post_install": [
        "Move-Item -Path \"$dir\\dirsearch-$version\\*\" -Destination \"$dir\\\"",
        "Remove-Item \"$dir\\dirsearch-$version\" -Force -Recurse",
        "pip3 install -r \"$dir\\requirements.txt\""
    ],
    "bin": "dirsearch.bat",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/maurosoria/dirsearch/archive/refs/tags/v$version.zip"
    }
}
