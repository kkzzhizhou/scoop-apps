{
    "version": "2.0.7",
    "description": "A modern remote terminal workspace",
    "homepage": "https://nyaterm.app/",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/nyakang/nyaterm#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.7/NyaTerm_2.0.7_windows_x64_portable.zip",
            "hash": "1b64a5a18fb3c4d7080f1daf4aa50a6df04186130269cc22f29c28b6465eaa5a"
        },
        "arm64": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.7/NyaTerm_2.0.7_windows_arm64_portable.zip",
            "hash": "0bf56f82cf8a4b580def547dcf0a5eb468e9568ecef5cbb1835b28f40989b92e"
        }
    },
    "extract_dir": "NyaTerm-portable",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:USERPROFILE\\.nyaterm\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:USERPROFILE\\.nyaterm\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "NyaTerm.exe",
    "shortcuts": [
        [
            "NyaTerm.exe",
            "NyaTerm"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/nyakang/nyaterm/releases/latest",
        "jp": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_arm64_portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
