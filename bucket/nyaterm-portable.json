    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.5/NyaTerm_2.0.5_windows_x64_portable.zip",
            "hash": "d8834e419c62cda0d2236e90f27ddc74289eab49393cdcc6c0b9a164b2978329"
        },
        "arm64": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.5/NyaTerm_2.0.5_windows_arm64_portable.zip",
            "hash": "af6f0035797ed6283e44e5b1d363c44ee18811af1c012a2586bd74ccea4dc634"
        }
    },
    "extract_dir": "NyaTerm-portable",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:USERPROFILE\\.nyaterm\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:USERPROFILE\\.nyaterm\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "NyaTerm.exe",
    "shortcuts": [
        [
            "NyaTerm.exe",
            "NyaTerm"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/nyakang/nyaterm/releases/latest",
        "jp": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_arm64_portable.zip"
            }
        }
    }
}
