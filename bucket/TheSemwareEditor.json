{
    "version": "4.50.23",
    "description": "The SemWare Editor, a programmable text editor",
    "homepage": "https://semware.com/",
    "license": "proprietary",
    "url": "https://semware.com/files/tse-pro-install/tse-setup-4.50.23.zip",
    "hash": "6445be62c9d092a001ba4b7621ec79a0bb60ccbc1bf1c6169c989d2f07612cb8",
    "installer": {
        "script": [
            "$archive = \"$dir\\tse.dat\"",
            "$bytes = [IO.File]::ReadAllBytes($archive)",
            "$trimmed = New-Object byte[] ($bytes.Length - 16)",
            "[Array]::Copy($bytes, $trimmed, $trimmed.Length)",
            "[IO.File]::WriteAllBytes($archive, $trimmed)",
            "Expand-7ZipArchive \"$archive\" \"$dir\" -Removal",
            "Expand-7ZipArchive \"$dir\\tse\" \"$dir\" -Removal",
            "Remove-Item \"$dir\\tse.exe\" -Force"
        ]
    },
    "bin": "e32.exe",
    "shortcuts": [
        [
            "e32.exe",
            "The SemWare Editor"
        ]
    ]
}
