{
    "version": "1.3.5",
    "description": "SnowShot 是一款功能强大的截图工具，集成了文字识别、翻译和 AI 对话等功能",
    "homepage": "https://github.com/mg-chao/snow-shot",
    "license": "Apache-2.0|GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mg-chao/snow-apps/releases/download/v1.3.5_snow-shot/snow-shot-1.3.5-windows-x64-portable.zip",
            "hash": "e94ebe0dc972f71461035797fbcf5d3fd42e87c25b74def2c1ebd328a3ef3e4d"
        }
    },
    "pre_install": "Get-ChildItem \"$dir\\Snow Shot_*\\*\" | Move-Item -Destination \"$dir\\\" -Force",
    "shortcuts": [
        [
            "snowshot.exe",
            "Snow Shot"
        ]
    ],
    "post_install": "Remove-Item \"$dir\\uninstall*\", \"$dir\\`$*\" -Force -Recurse -ErrorAction SilentlyContinue",
    "post_uninstall": "if ($purge) { Remove-Item \"$env:LOCALAPPDATA\\com.chao.snowshot\" -Force -Recurse -ErrorAction SilentlyContinue }",
    "persist": [
        "configs",
        "plugins",
        "stores",
        "captureHistoryImages"
    ],
    "checkver": {
        "url": "https://github.com/mg-chao/snow-shot/releases",
        "regex": "tree/v([\\d.\\-a-zA-Z]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mg-chao/snow-apps/releases/download/v$version_snow-shot/snow-shot-$version-windows-x64-portable.zip"
            }
        }
    }
}
