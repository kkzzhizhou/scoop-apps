{
    "version": "3.4.2",
    "description": "A runner for Gitea based on act",
    "homepage": "https://docs.gitea.com/runner/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://gitea.com/gitea/runner/releases/download/v3.4.2/gitea-runner-3.4.2-windows-amd64.exe.xz",
            "hash": "c23f5908e0118aa586dc5735d8def459e5639ca5861265f7d99c80cc4eef2bb5"
        }
    },
    "installer": {
        "script": "Get-Item \"$dir\\gitea-runner*.exe\" | Rename-Item -NewName 'gitea-runner.exe'"
    },
    "bin": "gitea-runner.exe",
    "checkver": {
        "url": "https://gitea.com/api/v1/repos/gitea/runner/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d\\.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gitea.com/gitea/runner/releases/download/v$version/gitea-runner-$version-windows-amd64.exe.xz",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
