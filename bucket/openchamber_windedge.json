{
    "version": "2.3.3",
    "description": "Open-source workspace for running, supervising, and reviewing AI coding agent work across desktop, web, VS Code, and mobile",
    "homepage": "https://github.com/openchamber/openchamber",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/openchamber/openchamber/releases/download/v2.3.3/OpenChamber-2.3.3-win-x64.exe#/dl.7z",
            "hash": "be634341b280599a80491a9487d9e885f273ce9d1adde616669602ad92a3e1f8",
            "installer": {
                "script": [
                    "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Switches \"-t7z\"",
                    "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\Uninstall OpenChamber.exe\", \"$dir\\uninstallerIcon.ico\" -Recurse -Force"
                ]
            }
        },
        "arm64": {
            "url": "https://github.com/openchamber/openchamber/releases/download/v2.3.3/OpenChamber-2.3.3-win-arm64.exe#/dl.7z",
            "hash": "d8356cd678be3ed0633de6c00bbb1567bacb6ef5aa6dec333003f1775c64ac31",
            "installer": {
                "script": [
                    "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\" -Switches \"-t7z\"",
                    "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\Uninstall OpenChamber.exe\", \"$dir\\uninstallerIcon.ico\" -Recurse -Force"
                ]
            }
        }
    },
    "shortcuts": [
        [
            "OpenChamber.exe",
            "OpenChamber"
        ]
    ],
    "checkver": {
        "github": "https://github.com/openchamber/openchamber"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "architecture": {
                "64bit": {
                    "url": "$baseurl/latest.yml",
                    "find": "$basename"
                },
                "arm64": {
                    "url": "$baseurl/latest-arm64.yml",
                    "find": "$basename"
                }
            }
        }
    },
    "notes": "OpenChamber is an Electron app; user data (sessions, settings) is stored under %APPDATA%, outside the app directory, and is not managed by Scoop.",
    "bin": "OpenChamber.exe"
}
