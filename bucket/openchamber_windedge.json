    },
    "shortcuts": [
        [
            "OpenChamber.exe",
            "OpenChamber"
        ]
    ],
    "checkver": {
        "github": "https://github.com/openchamber/openchamber"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "architecture": {
                "64bit": {
                    "url": "$baseurl/latest.yml",
                    "find": "$basename"
                },
                "arm64": {
                    "url": "$baseurl/latest-arm64.yml",
                    "find": "$basename"
                }
            }
