            "hash": "8ec7a027728741ef96eac7095b2bd220e30582d5c5c53ad6082c448df94a7508",
            "installer": {
                "script": [
                    "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Switches \"-t7z\"",
