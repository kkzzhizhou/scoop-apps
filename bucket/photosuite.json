{
    "version": "0.9.21",
    "description": "Desktop image editor with native PSD/PSB compatibility",
    "homepage": "https://photosuite.app",
    "license": "MIT OR Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/eolix/photosuite/releases/download/v0.9.21/photosuite-0.9.21-windows-x64-portable.zip",
            "hash": "e4e3202163179dc4efa24844e5fdc657f65528853023f0377823455f33bb1b10"
        }
    },
    "extract_dir": "photosuite-0.9.20-windows-x64-portable",
    "bin": "photosuite.exe",
    "persist": "PhotoSuiteData",
    "shortcuts": [
        [
            "photosuite.exe",
            "PhotoSuite"
        ]
    ],
    "pre_install": "if (!(Test-Path \"$dir\\PhotoSuiteData\")) { New-Item -ItemType Directory -Path \"$dir\\PhotoSuiteData\" | Out-Null }",
    "env_set": {
        "PHOTOSUITE_CONFIG_DIR": "$persist_dir\\PhotoSuiteData"
    },
    "notes": [
        "Portable ZIP ships with portable.txt, so the app writes preferences, presets, recovery autosaves and libraries to <exe dir>\\PhotoSuiteData (already redirected via PHOTOSUITE_CONFIG_DIR).",
        "Without this portable marker the app would store data in %APPDATA%\\app.photosuite, which Scoop cannot persist.",
        "Release assets include SHA256SUMS.txt used for autoupdate.hash; an MSI (photosuite-0.9.20-windows-x64.msi) is also available if an installer is preferred."
    ],
    "checkver": {
        "github": "https://github.com/eolix/photosuite"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/eolix/photosuite/releases/download/v$version/photosuite-$version-windows-x64-portable.zip",
                "extract_dir": "photosuite-$version-windows-x64-portable"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "find": "$basename"
        }
    }
}
