            "    Rename-Item -LiteralPath $appdir.FullName -NewName $manifest.version",
            "} elseif (!(Test-Path (Join-Path $dir $manifest.version))) {",
            "    abort 'Could not find the Tencent Meeting application directory.'",
            "}",
            "Remove-Item -LiteralPath (Join-Path $dir 'WeMeetApp_new.exe') -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath (Join-Path $dir '$TEMP'), (Join-Path $dir '$WINDIR'), (Join-Path $dir '$PLUGINSDIR') -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
