{
    "version": "0.3.1.56",
    "description": "Fast Windows launcher with indexed apps, custom commands, hotkeys, startup tasks, cron-style scheduling, and usage-based ranking.",
    "homepage": "https://github.com/dodorz/dorun",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dodorz/dorun/releases/download/0.3.1.56/DoRun-v0.3.1.56-windows-x64.zip",
            "hash": "d3fe2e4354822a4667f7168f20737a8cde52e531cd94bb89bc0d660cd8107b36"
        }
    },
    "bin": "DoRun.exe",
    "installer": {
        "script": [
            "'DoRun.yaml', 'Command.conf' | ForEach-Object {",
            "    if (!(Test-Path \"$persist_dir\\$_\")) { New-Item -ItemType File \"$dir\\$_\" -Force | Out-Null }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "DoRun.exe",
            "DoRun"
        ]
    ],
    "persist": [
        "DoRun.yaml",
        "Command.conf"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dodorz/dorun/releases/download/$version/DoRun-v$version-windows-x64.zip"
            }
        }
    }
}
