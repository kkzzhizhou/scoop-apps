    "license": {
        "identifier": "GPL-3.0 license",
        "url": "https://github.com/chen08209/FlClash#GPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/chen08209/FlClash/releases/download/v0.9.5/FlClash-0.9.5-windows-amd64-portable.zip",
            "hash": "22a8ea30a54240dd16722f2e3b02015e5758a0c5e200eb53632c468db88ab93c"
        },
        "arm64": {
            "url": "https://github.com/chen08209/FlClash/releases/download/v0.9.5/FlClash-0.9.5-windows-arm64-portable.zip",
            "hash": "f53106d5c11578bcff163dd31dc80cc35444fe4d3d3cfe0b930436240e63ea5a"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\com.follow\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "if (-not (Get-Service -Name \"FlClashHelperService\" -ErrorAction SilentlyContinue)) { return }",
            "Write-Host \"`nInstallation of `'FlClashHelperService`' detected, it may suspend scoop uninstallation or cleanup process.\" -ForegroundColor DarkYellow",
            "Write-Host \"In this case, open the updated app before cleanup or run following command with administrator privilege:\" -ForegroundColor DarkYellow",
            "Write-Host \"sc.exe stop FlClashHelperService | Out-Null; sc.exe delete FlClashHelperService | Out-Null\" -ForegroundColor DarkYellow",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.follow\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "FlClash.exe",
    "shortcuts": [
        [
            "FlClash.exe",
            "FlClash"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/chen08209/FlClash/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+)/FlClash-([\\d.]+)-windows-amd64"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/chen08209/FlClash/releases/download/v$version/FlClash-$version-windows-amd64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/chen08209/FlClash/releases/download/v$version/FlClash-$version-windows-arm64-portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/FlClash-$version-SHA256SUMS"
        }
    }
}
