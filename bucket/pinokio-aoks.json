    "homepage": "https://desktop.pinokio.co/",
    "license": "GPL-3.0-only",
    "url": "https://github.com/pinokiocomputer/pinokio/releases/download/v8.3.7/Pinokio.exe#/Pinokio.exe",
    "hash": "sha512:dd8c5a30093075f18dc675d1cb88183df5dd72d5d5d2844f487299cc998b82be49fad71b0104562768c0c68a6aecc31438395a42c0b1db1cab713fa27bac3bd3",
    "installer": {
        "script": "Invoke-ExternalCommand -FilePath \"$dir\\Pinokio.exe\" -Args @('/S', '/noredist', \"/D=$dir\") | Out-Null"
    },
    "uninstaller": {
        "script": "Invoke-ExternalCommand -FilePath \"$dir\\Uninstall Pinokio.exe\" -Args @('/S', '/noredist', \"/D=$dir\") | Out-Null"
    },
    "bin": "Pinokio.exe",
    "shortcuts": [
        [
            "Pinokio.exe",
            "Pinokio"
        ]
    ],
    "checkver": {
        "github": "https://github.com/pinokiocomputer/pinokio"
    },
    "autoupdate": {
        "url": "https://github.com/pinokiocomputer/pinokio/releases/download/v$version/Pinokio.exe#/Pinokio.exe",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512: $base64"
        }
    }
}
