    "hash": "sha512:e2edba60bb59466f85c011f3f003298588020ea4b3016d82a2faf8a132c51e4470e1a1b056794dcd872ac13a8969adacd2190e95766a70e3af3823aa17c78ed6",
    "installer": {
        "script": "Invoke-ExternalCommand -FilePath \"$dir\\Pinokio.exe\" -Args @('/S', '/noredist', \"/D=$dir\") | Out-Null"
