{
    "version": "5.7.7.40774747",
    "description": "腾讯云代码助手推出的 AI Agent 办公工具，可自主规划并交付多模态复杂任务结果。",
    "homepage": "https://www.codebuddy.cn/work/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://download.codebuddy.cn/workbuddy/saas/win32-x64-user/WorkBuddy-win32-x64-user-5.7.7.40774747-2e8619da.exe#/dl.7z",
            "hash": "adda63b306165032a6de01d082af284430df6c1487706cc6cf9b319e675ac013",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item -Path \"$dir\\`$*\" -Recurse"
            ]
        }
    },
    "post_install": [
        "# 数据迁移：AppData\\WorkBuddy",
        "$link = \"$env:AppData\\WorkBuddy\"",
        "$target = ensure \"$persist_dir\\WorkBuddy\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}",
        "# 数据迁移：USERPROFILE\\.workbuddy",
        "$link = \"$env:USERPROFILE\\.workbuddy\"",
        "$target = ensure \"$persist_dir\\.workBuddy\"",
        "if (!(Get-Item $link -Force -ErrorAction SilentlyContinue).LinkType) {",
        "    if ((Test-Path $link) -and (Get-ChildItem $target -Force -ErrorAction SilentlyContinue)) {",
        "        Remove-Item -Path \"$link.original\" -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Force $link \"$link.original\"",
        "    } elseif (Test-Path $link) {",
        "        Remove-Item -Path $target -Force -Recurse -ErrorAction SilentlyContinue",
        "        Move-Item -Path $link -Destination $target -Force",
        "    }",
        "    New-DirectoryJunction $link $target | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "WorkBuddy.exe",
            "WorkBuddy",
            "--force-device-scale-factor=1.5"
        ]
    ],
    "post_uninstall": [
        "# 删除数据软连接",
        "$link = @(\"$env:AppData\\WorkBuddy\", \"$env:USERPROFILE\\.workbuddy\")",
        "Remove-Item -Path $link -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "script": [
            "$prefix = 'https://raw.githubusercontent.com/SpecterShell/Dumplings/main/Tasks/Tencent.WorkBuddy'",
            "$stateYamlUrl = $prefix + '/State.yaml'",
            "$stateContent = (Invoke-WebRequest -Uri $stateYamlUrl -UseBasicParsing).Content",
            "$logFileUrl = \"$prefix/$stateContent\"",
            "$logContent = Invoke-RestMethod -Uri $logFileUrl -UseBasicParsing",
            "Write-Output $logContent"
        ],
        "regex": "Version:\\s*(?<version>\\S+)[\\s\\S]+?InstallerUrl:\\s*\\S+/(?<name>[^/\\s]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.codebuddy.cn/workbuddy/saas/win32-x64-user/$matchName#/dl.7z",
                "hash": {
                    "url": "https://raw.githubusercontent.com/microsoft/winget-pkgs/master/manifests/t/Tencent/WorkBuddy/$majorVersion.$minorVersion.$patchVersion/Tencent.WorkBuddy.installer.yaml",
                    "regex": "InstallerSha256:\\s+([a-fA-F0-9]{64})"
                }
            }
        }
    }
}
