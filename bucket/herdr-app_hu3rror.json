{
    "version": "0.1.15",
    "description": "Desktop app for terminals and coding agents: keep work in spaces, see which agents need you, and leave terminals running when the window closes",
    "homepage": "https://herdr.dev",
    "license": "Apache-2.0",
    "suggest": {
        "herdr-core": "muggle/herdr-core"
    },
    "architecture": {
        "64bit": {
            "url": "https://releases.herdr.dev/app/0.1.15/herdr-app-windows-x86_64.tar.gz",
            "hash": "62ddf27ee9acc13d9b3421389817d1cabdc906c23f9ff1363f6cdbc8af3da39c",
            "extract_dir": "herdr-app"
        }
    },
    "bin": "herdr-app.exe",
    "persist_external": [
        [
            "$env:UserProfile\\.config\\herdr-app",
            "app-home",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "shortcuts": [
        [
            "herdr-app.exe",
            "Herdr"
        ]
    ],
    "notes": [
        "Herdr runs terminals through herdr-core: it uses the one on PATH (`scoop install herdr-core`), or installs its own into %LOCALAPPDATA%\\Programs\\herdr-core on first start",
        "Release builds update themselves from releases.herdr.dev inside their own folder"
    ],
    "checkver": {
        "url": "https://releases.herdr.dev/app/latest.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://releases.herdr.dev/app/$version/herdr-app-windows-x86_64.tar.gz",
                "hash": {
                    "url": "https://releases.herdr.dev/app/latest.json",
                    "jsonpath": "$.targets['windows-x86_64'].sha256"
                }
            }
        }
    }
}
