            "hash": "b67db0ba78c17eab14121f1421ca00840dc981ea7770a56137a173ba08a38a4a"
        },
        "arm64": {
            "url": "https://github.com/agalwood/Motrix/releases/download/v2.4.8/Motrix-Setup-2.4.8-arm64.exe#/dl.7z",
            "hash": "d0cc5b6515f471ca2dfb89f32eceee08878d4fb4d5936deaeb8f383b4a42f7ec"
        }
    },
    "installer": {
        "script": [
            "$archives = @(Get-ChildItem -LiteralPath \"$dir\\`$PLUGINSDIR\" -Filter 'app-*.7z' -File)",
            "if ($archives.Count -ne 1) {",
            "    throw \"Expected exactly one app-*.7z archive in `$PLUGINSDIR, found $($archives.Count).\"",
            "}",
            "Expand-7zipArchive $archives[0].FullName \"$dir\"",
            "Remove-Item \"$dir\\`$*\" -Force -Recurse"
        ]
    },
    "shortcuts": [
        [
            "Motrix.exe",
            "Motrix"
        ]
    ],
    "checkver": {
        "github": "https://github.com/agalwood/Motrix"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/agalwood/Motrix/releases/download/v$version/Motrix-Setup-$version.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/agalwood/Motrix/releases/download/v$version/Motrix-Setup-$version-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/agalwood/Motrix/releases/latest",
            "jsonpath": "$.assets[?(@.name == '$basename')].digest"
        }
    }
}
