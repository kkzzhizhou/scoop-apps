{
    "version": "2.0.0-beta.6",
    "description": "A simple & beautiful GUI application for scrcpy",
    "homepage": "http://simonaking.com/scrcpy-gui/",
    "license": {
        "identifier": "GPL-3.0 license",
        "url": "https://github.com/SimonAKing/scrcpy-gui#GPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/SimonAKing/scrcpy-gui/releases/download/v2.0.0-beta.6/Scrcpy.GUI-2.0.0-beta.6-win-x64.exe#/dl.7z",
            "hash": "53006064445a7956d462681adacd050f5c4f786698c260fee786fe27947240c8",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        },
        "32bit": {
            "url": "https://github.com/SimonAKing/scrcpy-gui/releases/download/v2.0.0-beta.6/Scrcpy.GUI-2.0.0-beta.6-win-ia32.exe#/dl.7z",
            "hash": "66ecd4cc32cc04978e0fc2230cdbadc24650d4993172c23ed6d201ea75213522",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-32.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\scrcpy-gui\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\scrcpy-gui\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "Scrcpy GUI.exe",
            "ScrcpyGUI"
        ]
    ],
    "shortcuts": [
        [
            "Scrcpy GUI.exe",
            "ScrcpyGUI"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/SimonAKing/scrcpy-gui/releases",
        "jp": "$[*].tag_name",
        "regex": "v([\\d.]+-[\\w.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SimonAKing/scrcpy-gui/releases/download/v$version/Scrcpy.GUI-$version-win-x64.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://github.com/SimonAKing/scrcpy-gui/releases/download/v$version/Scrcpy.GUI-$version-win-ia32.exe#/dl.7z"
            }
        }
    }
}
