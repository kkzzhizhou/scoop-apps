{
    "version": "4.0.0-beta.6",
    "description": "Redefining the open-source download manager",
    "homepage": "https://rayburst.pages.dev/",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/AnInsomniacy/rayburst#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.0.0-beta.6/Rayburst_4.0.0-beta.6_x64-setup.exe#/dl.7z",
            "hash": "3159df4325deb06ddecc9e9d4bd031b816222c428c5348444d448e6087bf2f0f"
        },
        "arm64": {
            "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v4.0.0-beta.6/Rayburst_4.0.0-beta.6_arm64-setup.exe#/dl.7z",
            "hash": "afeb1d04b2ff601e0585af5e0e187ce7c9ad04feeb3d5b149cc84bfa292a3766"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\dev.aninsomniacy.rayburst\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\dev.aninsomniacy.rayburst\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\dev.aninsomniacy.rayburst\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\dev.aninsomniacy.rayburst\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "rayburst.exe",
    "shortcuts": [
        [
            "rayburst.exe",
            "Rayburst"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/AnInsomniacy/rayburst/releases",
        "jp": "$[*].assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+-[\\w.]+)/Rayburst_([\\d.]+-[\\w.]+)_x64-setup"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/AnInsomniacy/rayburst/releases/download/v$version/Rayburst_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
