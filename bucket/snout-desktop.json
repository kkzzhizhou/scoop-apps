{
    "version": "0.4.1",
    "description": "Native desktop workbench for snout, the Rime input method init and update tool",
    "homepage": "https://github.com/ca-x/snout",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/ca-x/snout/blob/master/LICENSE"
    },
    "notes": "Shares its config with the snout CLI; avoid updating both at once.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ca-x/snout/releases/download/v0.4.1/snout-desktop-v0.4.1-windows-x86_64.zip",
            "hash": "5b3bfa9b7daec351d5d4574b5d07655c3768165477e45904e17ff3bf009cee95"
        }
    },
    "shortcuts": [
        [
            "snout-desktop.exe",
            "snout"
        ]
    ],
    "persist_external": [
        [
            "$env:AppData\\snout",
            "snout",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ca-x/snout/releases/download/v$version/snout-desktop-v$version-windows-x86_64.zip"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/ca-x/snout/releases/latest",
            "jsonpath": "$.assets[?(@.name=='snout-desktop-v$version-windows-x86_64.zip')].digest"
        }
    }
}
