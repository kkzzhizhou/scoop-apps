            "url": "https://archive.mozilla.org/pub/thunderbird/releases/153.0.2/win32/fa-IR/Thunderbird%20Setup%20153.0.2.exe#/dl.7z",
            "hash": "sha512:adf3c4a86cd5c630f40a3a1721caa8cd2ff6aad3845d6d8031d849ed055719c6500b02326ff729a1230290a346110017d253a4966b967f91cc4850b5a80e158b"
        }
