{
    "version": "0.5.0",
    "description": "A GPU-accelerated desktop Git client built with GPUI and Rust.",
    "homepage": "https://github.com/noahbclarkson/rgitui",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/noahbclarkson/rgitui/releases/download/v0.5.0/rgitui-0.5.0-x86_64-windows.zip",
            "hash": "778b09fc9b2163db738670fa5d68c9cc7d02df566b042b64a1383ae2162f4a3d"
        }
    },
    "bin": "rgitui.exe",
    "shortcuts": [
        [
            "rgitui.exe",
            "rgitui"
        ]
    ],
    "persist_external": [
        [
            "$env:AppData\\rgitui",
            "config",
            "directory"
        ],
        [
            "$env:LocalAppData\\rgitui",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": {
        "github": "https://github.com/noahbclarkson/rgitui"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/noahbclarkson/rgitui/releases/download/v$version/rgitui-$version-x86_64-windows.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS.txt",
                    "regex": "$sha256\\s+$basename"
                }
            }
        }
    }
}
