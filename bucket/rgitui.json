{
    "version": "0.5.1",
    "description": "A GPU-accelerated desktop Git client built with GPUI and Rust.",
    "homepage": "https://github.com/noahbclarkson/rgitui",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/noahbclarkson/rgitui/releases/download/v0.5.1/rgitui-0.5.1-x86_64-windows.zip",
            "hash": "a968b643fbdcddd4739da1786c51032bac29e1a406ec56cce549c6f6e8913d1b"
        }
    },
    "bin": "rgitui.exe",
    "shortcuts": [
        [
            "rgitui.exe",
            "rgitui"
        ]
    ],
    "persist_external": [
        [
            "$env:AppData\\rgitui",
            "config",
            "directory"
        ],
        [
            "$env:LocalAppData\\rgitui",
            "cache",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": {
        "github": "https://github.com/noahbclarkson/rgitui"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/noahbclarkson/rgitui/releases/download/v$version/rgitui-$version-x86_64-windows.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS.txt",
                    "regex": "$sha256\\s+$basename"
                }
            }
        }
    }
}
