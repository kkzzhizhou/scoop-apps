{
    "version": "153.0.4",
    "description": "Popular open source web browser.",
    "homepage": "https://www.mozilla.org/firefox/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/153.0.4/win64/en-US/Firefox%20Setup%20153.0.4.exe#/dl.7z",
            "hash": "sha512:e31ced9519982aaaec05393f2dbef9b51dd35286bf133b373c135182306503fca5e37bff4d470d9f6c751ff98badd4a6ef1baa81da323cdb564302f3c42350a6"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/153.0.4/win32/en-US/Firefox%20Setup%20153.0.4.exe#/dl.7z",
            "hash": "sha512:810b0ac78934698122939e83baf8330822d6ed82db962e5b288814f382213267dee5ddf87182d78c1652d7f3e9b90144befa9a137473ff483fdb15a59edad2f4"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "Profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
