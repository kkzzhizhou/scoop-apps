            "hash": "sha512:f4b0aa38600935b1e9cdec76a70da40ecbc2f37e0058f2ca3e9daa3077bed8e7aca8e39fbd8df6763291a3f2a541bb1f2629570ba5e0fb646156cf50497f11b3"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0.1/win32/en-US/Firefox%20Setup%20156.0.1.exe#/dl.7z",
            "hash": "sha512:2dc2803d31a4aed8798641f1e36c640a6df978ed3f873b4fd8f847a436b05cf4ad9a6bfc220daf5ce97e56e7ee76d38a0a867063e90e10ad4020e82e07a0a639"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "Profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
