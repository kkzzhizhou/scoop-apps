            "hash": "sha512:869ca1b1cddeaed07587ec11477e636695d8bdc19c470c0443220398d8cd6b57374f196d1f2a8b83080b23b2ca0f572e3a8fc06796dc5f66d0694f67c2cc6874"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0.1/win32/en-US/Firefox%20Setup%20154.0.1.exe#/dl.7z",
            "hash": "sha512:42b65080edae2bff49707e9a7ba7d483a27c735f5c3c181ff685c0611dd98d6ce6337094e70e88bcdeace9d806f1b079079085d809fdd03faeb69e859920f3f9"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "Profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
