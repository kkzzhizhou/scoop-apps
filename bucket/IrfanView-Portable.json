{
    "version": "4.76",
    "description": "IrfanView. A fast, compact and innovative graphic viewer",
    "homepage": "https://www.irfanview.com/",
    "license": {
        "identifier": "Freeware",
        "url": "https://www.irfanview.com/eula.htm"
    },
    "changelog": "https://www.irfanview.com/main_history.htm",
    "architecture": {
        "64bit": {
            "url": "https://www.irfanview.info/files/iview476_x64.zip",
            "hash": "37f10e9c6ecfeba3d5c0f16cc6f07bdda4ffdf85069613d25ec51f8e4733a9eb",
            "shortcuts": [
                [
                    "i_view64.exe",
                    "IrfanView"
                ]
            ],
            "bin": [
                [
                    "i_view64.exe",
                    "irfanview"
                ]
            ]
        },
        "32bit": {
            "url": "https://www.irfanview.info/files/iview476.zip",
            "hash": "2f37d87dc7f9ce445ac0adc1ec01a1e1348094c904fd68033f60b471519bea85",
            "shortcuts": [
                [
                    "i_view32.exe",
                    "IrfanView"
                ]
            ],
            "bin": [
                [
                    "i_view32.exe",
                    "irfanview"
                ]
            ]
        }
    },
    "pre_install": [
        "if (!(Test-Path(\"$dir/i_view64.ini\"))) {",
        "   New-Item \"$dir/i_view64.ini\" | Out-Null",
        "}",
        "if (!(Test-Path(\"$dir/i_view32.ini\"))) {",
        "   New-Item \"$dir/i_view32.ini\" | Out-Null",
        "}"
    ],
    "persist": [
        "i_view64.ini",
        "i_view32.ini",
        "Languages"
    ],
    "extract_to": [
        "",
        "Plugins"
    ],
    "checkver": {
        "url": "https://www.irfanview.com/",
        "regex": ">\\s*version\\s+([\\d\\.-]+)\\s*<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.irfanview.info/files/iview$cleanVersion_x64.zip"
            },
            "32bit": {
                "url": "https://www.irfanview.info/files/iview$cleanVersion.zip"
            }
        }
    }
}
