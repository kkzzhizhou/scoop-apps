            "hash": "sha512:6631bb190d6fa9b2e5c7f0325158a5bc9643f7e79e39d604697be97f34897f6eaefe80f2dd7831a706219edf5308f94e7b035717aba9ee2e18eab7cc4e06494b"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/154.0b4/win32/fa-IR/Firefox%20Setup%20154.0b4.exe#/dl.7z",
            "hash": "sha512:6631bb190d6fa9b2e5c7f0325158a5bc9643f7e79e39d604697be97f34897f6eaefe80f2dd7831a706219edf5308f94e7b035717aba9ee2e18eab7cc4e06494b"
