    "bin": "AppCrashView.exe",
    "shortcuts": [
        [
            "AppCrashView.exe",
            "NirSoft\\AppCrashView"
        ]
    ],
    "persist": [
        "appcrashview_lng.ini",
        "appcrashview.cfg"
