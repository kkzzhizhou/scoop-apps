{
    "version": "3.8.1",
    "description": "An AI-powered IDE",
    "homepage": "https://comate.baidu.com/zh/download/ai-ide",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://comate-ide.cdn.bcebos.com/download/stable/fa0f8340802302f89346535ece9e42a0adc3b824-268947017/Comate-win32-x64.zip",
            "hash": "ba77f23d838a8ea43d20de25171bc0f70facc429cdf77d646c69f364aa9a3cb2",
            "extract_dir": "VSCode-win32-x64"
        },
        "arm64": {
            "url": "https://comate-ide.cdn.bcebos.com/download/stable/fa0f8340802302f89346535ece9e42a0adc3b824-268947017/Comate-win32-arm64.zip",
            "hash": "bb7ec755f8abbb43dde85a144545f07c923118a295fabc090cde3a54b5d58f3c",
            "extract_dir": "VSCode-win32-arm64"
        }
    },
    "post_install": [
        "if (!(Test-Path \"$dir\\data\\extensions\") -and (Test-Path \"$env:USERPROFILE\\.comate\\extensions\")) {",
        "    info '[Portable Mode] Copying extensions...'",
        "    Copy-Item \"$env:USERPROFILE\\.comate\\extensions\" \"$dir\\data\" -Recurse",
        "}",
        "if (!(Test-Path \"$dir\\data\\user-data\") -and (Test-Path \"$env:AppData\\Comate\")) {",
        "    info '[Portable Mode] Copying user data...'",
        "    Copy-Item \"$env:AppData\\Comate\" \"$dir\\data\\user-data\" -Recurse",
        "}",
        "$extensions_file = \"$dir\\data\\extensions\\extensions.json\"",
        "if ((Test-Path \"$extensions_file\")) {",
        "    info 'Adjusting path in extensions file...'",
        "    (Get-Content \"$extensions_file\") -replace '(?<=comate(/|\\\\\\\\)).*?(?=(/|\\\\\\\\)data(/|\\\\\\\\)extensions)', $version | Set-Content \"$extensions_file\"",
        "}"
    ],
    "bin": [
        [
            "bin/Comate.cmd",
            "comate"
        ]
    ],
    "shortcuts": [
        [
            "Comate.exe",
            "Comate",
            "--user-data-dir=\"$dir\\data\\user-data\" --extensions-dir=\"$dir\\data\\extensions\""
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://comate.baidu.com/api/aiIde/updates/stable/win32/x64/user/latest.json",
        "regex": "(?s)(?=.*\"productVersion\"\\s*:\\s*\"([\\d.]+)\")(?=.*\"url\"\\s*:\\s*\"https://comate-ide\\.cdn\\.bcebos\\.com/download/stable/(?<build>[^/]+)/Comate-win32-x64-user-setup\\.exe\")"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://comate-ide.cdn.bcebos.com/download/stable/$matchBuild/Comate-win32-x64.zip"
            },
            "arm64": {
                "url": "https://comate-ide.cdn.bcebos.com/download/stable/$matchBuild/Comate-win32-arm64.zip"
            }
        }
    }
}
