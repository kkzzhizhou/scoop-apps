{
	"version": "2026.10.06.093140",
	"description": "A javaagent filter for JetBrains IDEs and products.",
	"homepage": "https://jetbrains.ankio.net/",
	"license": "Freeware",
	"url": "https://jetbrains.ankio.net/static/ja-netfilter.zip",
	"hash": "95368b526a9e2be0a734c8e76942c952eb76c159293c72e3d485fc1a775ea7e4",
	"post_install": [
		"pushd \"$dir\\scripts\"",
		"cscript //nologo install-current-user.vbs",
		"popd"
	],
	"pre_uninstall": [
		"pushd \"$dir\\scripts\"",
		"cscript //nologo uninstall-current-user.vbs",
		"popd"
	],
	"checkver": {
		"script": [
			"$res = Invoke-WebRequest -Uri 'https://jetbrains.ankio.net/static/ja-netfilter.zip' -Method Head -UseBasicParsing",
			"$lm = $res.Headers['Last-Modified']",
			"if (-not $lm) { $lm = $res.Headers['last-modified'] }",
			"$dt = [DateTimeOffset]::Parse($lm).UtcDateTime",
			"Write-Output ($dt.ToString('yyyy.MM.dd.HHmmss'))"
		],
		"regex": "(?<version>[\\d.]+)"
	},
	"autoupdate": {
		"url": "https://jetbrains.ankio.net/static/ja-netfilter.zip"
	}
}
