        "github": "https://github.com/RedwindA/gotify-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/RedwindA/gotify-desktop/releases/download/v$version/Gotify-Desktop-$version-windows-amd64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "$basename"
        }
    }
