            "hash": "7a83567e2b7d5273d06d249b22ab9fa197c1b2efb143d82828e42f1c60217fb8"
        }
    },
    "bin": "Gotify Desktop.exe",
    "shortcuts": [
        [
            "Gotify Desktop.exe",
            "Gotify Desktop"
        ]
    ],
    "pre_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue"
