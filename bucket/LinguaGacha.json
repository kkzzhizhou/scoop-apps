            "hash": "f253059ffc33c62df7480337bcacc241e34d2782139ebd42b5d3bf49eedb1ef3"
        }
    },
    "shortcuts": [
        [
            "app.exe",
            "LinguaGacha"
        ]
    ],
    "pre_install": [
        "if ((Test-Path \"$persist_dir\\config.json\") -and !(Test-Path \"$persist_dir\\userdata\\config.json\")) {",
        "    New-Item \"$persist_dir\\userdata\" -ItemType Directory -Force | Out-Null",
        "    Copy-Item \"$persist_dir\\config.json\" \"$persist_dir\\userdata\\config.json\"",
        "}",
        "if (Test-Path \"$persist_dir\\resource\\preset\") {",
        "    Copy-Item \"$persist_dir\\resource\\preset\" \"$dir\\resource\\preset\" -Recurse -Force",
        "}"
    ],
    "persist": "userdata",
    "checkver": {
        "github": "https://github.com/neavo/LinguaGacha",
        "regex": "MANUAL_BUILD_v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/neavo/LinguaGacha/releases/download/MANUAL_BUILD_v$version/LinguaGacha_v$version_Windows_x64.zip"
            }
        }
    }
}
