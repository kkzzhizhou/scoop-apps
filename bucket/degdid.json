{
    "version": "1786223989",
    "description": "Deletes all instances of Microsoft's GDID and prevents minting of new ones",
    "homepage": "https://github.com/yegors/deGDID",
    "license": "MIT",
    "url": "https://raw.githubusercontent.com/yegors/deGDID/main/degdid.ps1",
    "hash": "4f02f58a42e7c907b9e30cf74f7702e3762ecdbdbf9242dc4ddc22356ee951f0",
    "pre_install": "Move-Item \"$dir/degdid.ps1\" (New-Item -ItemType Directory \"$dir/bin\")",
    "env_add_path": "bin",
    "checkver": {
        "script": "try { Get-Date (Invoke-RestMethod 'https://api.github.com/repositories/1294791465/commits?path=degdid.ps1&per_page=1' -Headers $(if ($auth = Get-GitHubToken) { @{authorization=\"Bearer $auth\"} }))[0].commit.committer.date -UFormat %s } catch { '' }",
        "regex": "\\A(\\d+)\\Z"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/yegors/deGDID/main/degdid.ps1"
    }
}
