{
    "version": "4.21.2",
    "description": "Windows GUI for installing, configuring, updating, and monitoring the Beszel agent",
    "homepage": "https://github.com/MiranoVerhoef/BeszelAgentManager",
    "license": "MIT",
    "notes": [
        "Installs to the protected Program Files directory. Installation and uninstallation require administrator approval.",
        "Scoop updates upgrade the existing installation in place.",
        "After installation, open BeszelAgentManager and configure the Hub connection before installing the agent."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/MiranoVerhoef/BeszelAgentManager/releases/download/4.21.2/BeszelAgentManagerSetup.exe",
            "hash": "1d3636350aa8ebf730896cc9e47e5ba91b5e9dd09c2ae0642dd0849b464c7e84"
        }
    },
    "installer": {
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-",
            "/LOG=$dir\\install.log",
            "/MERGETASKS=!startmenuicon,!desktopicon"
        ]
    },
    "post_install": [
        "$target = Join-Path $env:ProgramW6432 'BeszelAgentManager\\app\\BeszelAgentManager.exe'",
        "if (!(Test-Path -LiteralPath $target -PathType Leaf)) { throw \"BeszelAgentManager was not installed at '$target'. Check '$dir\\install.log'.\" }",
        "startmenu_shortcut $target 'BeszelAgentManager' $null $null $global"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'update') { return }",
            "$uninstaller = Join-Path $env:ProgramW6432 'BeszelAgentManager\\unins000.exe'",
            "if (Test-Path -LiteralPath $uninstaller -PathType Leaf) {",
            "    $log = Join-Path $dir 'uninstall.log'",
            "    $uninstallArgs = @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', \"/LOG=$log\")",
            "    if (!(Invoke-ExternalCommand -FilePath $uninstaller -ArgumentList $uninstallArgs -RunAs -Activity 'Uninstalling BeszelAgentManager ...')) {",
            "        throw \"BeszelAgentManager uninstallation failed. Check '$log'.\"",
            "    }",
            "}"
        ]
    },
    "post_uninstall": [
        "$shortcut = Join-Path (shortcut_folder $global) 'BeszelAgentManager.lnk'",
        "if (Test-Path -LiteralPath $shortcut) { Remove-Item -LiteralPath $shortcut -Force -ErrorAction Stop }"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/MiranoVerhoef/BeszelAgentManager/releases/download/$version/BeszelAgentManagerSetup.exe"
            }
        },
        "hash": {
            "url": "https://github.com/MiranoVerhoef/BeszelAgentManager/releases/download/$version/SHA256SUMS.txt"
        }
    }
}
