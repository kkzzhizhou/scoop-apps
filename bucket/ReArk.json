    "installer": {
        "script": [
            "Start-Process \"$dir\\ReArk-setup.exe\" -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART','/SP-','/NOCANCEL','/NORUN','/NOICONS',\"/DIR=$dir\" -Wait",
            "Remove-Item \"$dir\\ReArk-setup.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": "Start-Process \"$dir\\unins000.exe\" -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait"
    },
    "shortcuts": [
        [
            "ReArk.exe",
            "ReArk"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": [
            "https://github.com/lkimuk/ReArk/releases/download/v$version/ReArk-$version-windows-x64-setup.exe#/ReArk-setup.exe",
            "https://github.com/lkimuk/ReArk/archive/refs/tags/v$version.zip#/ReArk-source.zip"
        ]
    },
    "notes": [
        "【工具类型】: 逆向工程与安全分析工具",
        "【主要功能】: 智能二进制逆向分析与 AI 辅助审计，支持 HarmonyOS NEXT (HAP/APP/ABC)、Android (APK/AAB)、iOS (IPA) 与原生 PE/ELF/Mach-O 二进制",
        "【适用场景】: 移动应用安全审计、恶意软件分析、HarmonyOS/Android/iOS 应用逆向、原生二进制静态分析与反编译",
        "【技术特点】: 基于 C++ + Qt6 开发的原生 GUI；集成 capstone 反汇编引擎与 FFmpeg 多媒体库；内置 JRE 运行时与 hdc (HarmonyOS Device Connector) 工具；支持 AI Agent 工作流",
        "【注意事项】: 安装方式为 Inno Setup 静默安装到 Scoop 应用目录；unins000.exe 为官方卸载程序，会清理注册表卸载项；附带的 Java 运行时位于 runtime\\java\\bin\\；已附带 v1.1.1 源码归档 ReArk-source.zip 便于审计与二次开发"
    ]
