            "hash": "1cf20cb4c69ed25586af033b782feed7a80e80ecb501e0db7e0f3d88a43a5844",
            "installer": {
                "script": [
                    "$file = (Get-ChildItem \"$dir\" 'RunJS*.exe' | Select-Object -First 1).FullName",
                    "Expand-7ZipArchive \"$file\" \"$dir\\\" -Removal",
                    "Expand-7ZipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
                    "Remove-Item \"$dir\\`$PLUGINSDIR\",\"$dir\\`$R0\"  -Force -Recurse"
                ]
            }
        }
    },
    "bin": "RunJS.exe",
    "shortcuts": [
        [
            "RunJS.exe",
            "RunJS"
        ]
    ],
    "checkver": {
        "github": "https://github.com/lukehaas/RunJS"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lukehaas/RunJS/releases/download/v$version/RunJS-Setup-$version.exe"
            }
        }
    }
