{
    "version": "9.9.35.260902",
    "description": "An instant messaging software service developed by Tencent",
    "homepage": "https://im.qq.com/pcqq/index.shtml",
    "license": {
        "identifier": "Proprietary",
        "url": "https://ti.qq.com/agreement/index.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/LaelLuo/scoop/releases/download/qqnt-9.9.35.260902/qqnt-9.9.35.260902-x64.exe#/dl.7z",
            "hash": "9f4b408e7e33f6d74ddf2b117d6953367a42dbb41af6d82150482d3ffebf05f7"
        }
    },
    "extract_dir": "Files",
    "shortcuts": [
        [
            "QQ.exe",
            "QQ"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/QQ",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "qqex",
                "source": "AppData/QQEX",
                "target": "$persist_dir/qqex",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "tencent-qqnt",
                "source": "AppData/Tencent/QQNT",
                "target": "$persist_dir/tencent-qqnt",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "chat-updater",
                "source": "LocalAppData/qq-chat-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            },
            {
                "label": "play-updater",
                "source": "LocalAppData/qq-play-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "checkver": {
        "script": [
            "# Please keep this script. An empty Accept-Encoding header can cause the CDN to deliver expired cache.",
            "# See : https://github.com/ScoopInstaller/Extras/issues/15916",
            "$headers = @{ 'Accept-Encoding' = 'gzip' }",
            "$url = 'https://cdn-go.cn/qq-web/im.qq.com_new/latest/rainbow/windowsConfig.js'",
            "$response = Invoke-WebRequest -Uri $url -UseBasicParsing -Headers $headers",
            "Write-Output $response.Content"
        ],
        "regex": "QQNT(?:V2)?/([\\d\\.]+)/release/[0-9a-f]+/QQ_([\\d\\.]+)_([\\d]+)_x86_01\\.exe",
        "replace": "${2}.${3}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LaelLuo/scoop/releases/download/qqnt-$version/qqnt-$version-x64.exe#/dl.7z",
                "hash": {
                    "mode": "download"
                }
            }
        }
    },
    "notes": [
        "**GitHub 镜像分发（2026-09-15 终态架构）**：腾讯 QQNTV2 分发需动态签名（裸链接对一切脚本下载器 403，签名时效 <1h，由 im.qq.com 免登录 GetSign 接口签发），清单无法直连腾讯发布。故安装包转存为本仓库 Release asset（tag=qqnt-<版本>），清单 url 指向 GitHub——任意客户端无条件可下，签名时效与老包清理问题一并消除。",
        "版本跟进由 `.github/workflows/qqnt-mirror.yml` 全自动完成（每 6 小时检测腾讯新版 → scripts/qqnt-mirror.ps1 签名下载 → 发 Release → 更新本清单三件套 → 提交）。autoupdate 模板指向 GitHub asset 仅作已有版本的重建通道；新版本必须等 workflow 先发 Release。单 x64 架构（x86/arm64 无镜像源）。",
        "签名机制细节与备用手动工具见 scripts/qqnt-fetch.ps1 与 scripts/qqnt-mirror.ps1；QQ 客户端自研热更新（QQEX 启动器式版本目录）仍是并行可用的替代通道。",
        "沿革：2026-09-15 先后经历钉 9.9.33（winget 哈希）、误推签名 URL 回退、checkver 集成 GetSign 的 -u 一键流，最终因「老路径包将被清理、门面无版可钉」切到本镜像架构。"
    ]
}
