    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\mihomo-party\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "Clash Party.exe",
    "shortcuts": [
        [
            "Clash Party.exe",
            "Clash Party"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/mihomo-party-org/clash-party/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
