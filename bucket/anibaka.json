{
    "version": "5.1.0+0823",
    "description": "一个支持超分辨率的在线动漫弹幕APP。多平台，多番剧源，多弹幕，高清无广告。追番看番必备软件。",
    "homepage": "https://ani-baka.vercel.app/",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AniBakaBaka/AniBaka/releases/download/5.1.0%2B0823/baka-5.1.0%2B0823-windows-x64.zip",
            "hash": "d67f2cd014aabe78f4f0b619d799a2b2965337c7581508a8396ed566b382df00"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\com.sichuankejing.lupinshenghuo\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.sichuankejing.lupinshenghuo\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "baka.exe",
    "shortcuts": [
        [
            "baka.exe",
            "Baka"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/AniBakaBaka/AniBaka/releases",
        "jp": "$[0].assets[*].browser_download_url",
        "regex": "/releases/download/([\\d.]+)%2B([\\d]+)/baka-([\\d.]+)%2B([\\d]+)-windows",
        "replace": "${1}+${2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AniBakaBaka/AniBaka/releases/download/$match1%2B$match2/baka-$match3%2B$match4-windows-x64.zip"
            }
        }
    }
