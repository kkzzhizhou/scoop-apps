    "checkver": {
        "script": [
            "$url = 'https://download.deepseek.com/desktop/dsh-latest-windows-x64.exe'",
            "$request = [System.Net.HttpWebRequest]::Create($url)",
            "$request.AddRange(0, 2097151)",
            "$request.Timeout = 30000",
            "$request.ReadWriteTimeout = 30000",
            "$response = $null",
            "$tempFile = $null",
            "try {",
            "    $response = $request.GetResponse()",
            "    if ([int]$response.StatusCode -ne 206) { throw \"Expected a partial download (HTTP 206), received $([int]$response.StatusCode)\" }",
            "    if ($response.ContentLength -gt 2097152) { throw \"Version probe exceeded 2 MiB: $($response.ContentLength)\" }",
            "    $tempFile = [System.IO.Path]::GetTempFileName()",
            "    $output = [System.IO.File]::OpenWrite($tempFile)",
            "    try { $response.GetResponseStream().CopyTo($output) } finally { $output.Dispose() }",
            "    if ((Get-Item $tempFile).Length -gt 2097152) { throw 'Version probe exceeded 2 MiB' }",
            "    $version = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($tempFile).ProductVersion",
            "    if ($version -notmatch '^[\\d.]+(?:-[\\w.]+)?$') { throw \"Unexpected installer ProductVersion: $version\" }",
            "    Write-Output $version",
            "} finally {",
            "    if ($response) { $response.Close() }",
            "    if ($tempFile -and (Test-Path $tempFile)) { Remove-Item $tempFile -Force }",
            "}"
        ],
        "regex": "(?<version>[\\d.]+(?:-[\\w.]+)?)"
    },
