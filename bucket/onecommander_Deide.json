    "bin": "OneCommander.exe",
    "shortcuts": [
        [
            "OneCommander.exe",
            "OneCommander"
        ]
    ],
    "pre_install": "Copy-Item \"$persist_dir\\Themes_User\\*\" -Destination \"$dir\\Themes\" -Recurse -ErrorAction SilentlyContinue -Force",
    "pre_uninstall": "Copy-Item \"$dir\\Themes\\*\" -Exclude Scrollbar, Nortorn, Nord, MinimalWhite, LightRoundedFlat, LightMica, Light, DarkMica, Dark -Destination \"$persist_dir\\Themes_User\" -Recurse -ErrorAction SilentlyContinue -Force",
    "persist": [
        "Settings",
        "Templates",
        "Logs",
        "Resources",
        "Themes_User"
    ],
    "checkver": {
        "url": "https://onecommander.com/download",
        "regex": "OneCommander([\\d.]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://onecommander.com/OneCommander$version.zip"
    }
}
