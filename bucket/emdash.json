{
    "version": "1.2.13",
    "description": "Desktop worktree IDE that dispatches 25+ CLI coding agents, with tickets and SSH remotes.",
    "homepage": "https://emdash.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/generalaction/emdash/releases/download/v1.2.13/emdash-x64.exe#/dl.7z",
            "hash": "fdf8b453db5d6588df5b08f824a70d13a8c8869555c343e7648e1218d393d36c",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse -ErrorAction SilentlyContinue"
            ]
        }
    },
    "shortcuts": [
        [
            "Emdash.exe",
            "Emdash"
        ]
    ],
    "notes": [
        "这是 generalaction/emdash 的官方 Windows 安装包（便携解压，不走系统安装器）。",
        "请用 scoop update emdash 更新，尽量关闭应用内自动更新。",
        "使用前通常需要已安装 Git 以及至少一种 CLI coding agent。",
        "便携化会把 %APPDATA%\\emdash 映射到 Scoop persist；该目录名来自应用源码里的 USER_DATA_DIR_NAME。"
    ],
    "checkver": {
        "github": "https://github.com/generalaction/emdash"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/generalaction/emdash/releases/download/v$version/emdash-x64.exe#/dl.7z"
            }
        }
    },
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/emdash",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            }
        ]
    }
}
