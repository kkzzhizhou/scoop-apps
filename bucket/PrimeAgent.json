{
    "version": "0.8.0",
    "description": "Coding agent CLI with IPython-backed tools and session management",
    "homepage": "https://github.com/PrimeIntellect-ai/prime-agent",
    "license": "MIT",
    "notes": [
        "Install one supported Node.js package first: nodejs, nodejs-lts, versions/nodejs24, nonportable/nodejs-np, or nonportable/nodejs-lts-np.",
        "Prime Agent requires Node.js 22.8.0 or newer.",
        "The IPython/Python runtime is not bootstrapped during Scoop installation; run `prime-agent` once and follow its prompt, or prepare it manually."
    ],
    "suggest": {
        "Node.js (current)": "main/nodejs",
        "Node.js LTS": "main/nodejs-lts",
        "Node.js 24": "versions/nodejs24",
        "Node.js (non-portable)": "nonportable/nodejs-np",
        "Node.js LTS (non-portable)": "nonportable/nodejs-lts-np"
    },
    "architecture": {
        "64bit": {
            "url": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.8.0/prime-agent-0.8.0.tgz",
            "hash": "f5b0093c7e0fddb73f94773d74383585456adfa84f12a4082d3098f23bb8fab6"
        }
    },
    "extract_dir": "package",
    "installer": {
        "script": [
            "$node = Get-Command node -ErrorAction SilentlyContinue",
            "$npm = Get-Command npm -ErrorAction SilentlyContinue",
            "if (!$node -or !$npm) { throw 'Prime Agent requires Node.js and npm. Install one of the suggested Node.js Scoop packages, then run this installation again.' }",
            "$nodeVersion = (& node --version).Trim()",
            "if ($nodeVersion -notmatch '^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$' -or [int]$Matches.major -lt 22 -or ([int]$Matches.major -eq 22 -and [int]$Matches.minor -lt 8)) { throw \"Prime Agent requires Node.js 22.8.0 or newer; found $nodeVersion.\" }",
            "Push-Location $dir",
            "try {",
            "    npm install --omit=dev --no-fund --no-audit --loglevel=error --progress=false",
            "    if ($LASTEXITCODE -ne 0) { throw 'npm dependency installation failed' }",
            "} finally {",
            "    Pop-Location",
            "}",
            "Set-Content -Path \"$dir\\prime-agent.cmd\" -Encoding ASCII -Value '@echo off', 'node \"%~dp0dist\\bundle\\cli.js\" %*'"
        ]
    },
    "bin": "prime-agent.cmd",
    "checkver": {
        "url": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/stable",
        "regex": "v([\\dA-Za-z.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v$version/prime-agent-$version.tgz"
            }
        },
        "hash": {
            "url": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v$version/SHA256SUMS",
            "regex": "^(?<sha256>[a-f0-9]{64})\\s+prime-agent-$version\\.tgz$"
        }
    }
}
