{
    "version": "2.1.1",
    "description": "Game accelerator",
    "homepage": "https://github.com/NetchX/Netch",
    "license": "MIT",
    "notes": [
        "Netch 2.0 is a rewrite and starts with fresh settings (persisted as data-v2 / mode-v2).",
        "Your 1.9 data is kept in $persist_dir\\data and $persist_dir\\mode for manual migration."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/NetchX/Netch/releases/download/2.1.1/Netch-2.1.1-winui-x64-self-contained.7z",
            "hash": "8c3b92978b9904ec365bee10c064ce764270a323e910d38af1a70fdd41706ad8"
        }
    },
    "pre_install": [
        "ensure \"$dir\\data\" | Out-Null",
        "if (!(Test-Path \"$persist_dir\\data-v2\\settings.json\")) { Set-Content \"$dir\\data\\settings.json\" '{ \"CheckUpdateWhenOpened\": false, \"AutoCheckUpdateIntervalHours\": 0 }' -Encoding Ascii -Force }"
    ],
    "bin": [
        [
            "Netch.App.exe",
            "netch"
        ]
    ],
    "shortcuts": [
        [
            "Netch.App.exe",
            "Netch"
        ]
    ],
    "persist": [
        [
            "data",
            "data-v2"
        ],
        "logging",
        [
            "mode",
            "mode-v2"
        ]
    ],
    "checkver": {
        "github": "https://github.com/NetchX/Netch/"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/NetchX/Netch/releases/download/$version/Netch-$version-winui-x64-self-contained.7z"
            }
        }
    }
}
