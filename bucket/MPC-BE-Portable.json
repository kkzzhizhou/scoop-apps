        "}"
    ],
    "persist": [
        "mpc-be64.ini",
        "mpc-be.ini",
        "Default.mpcpl"
    ],
    "checkver": {
        "url": "https://sourceforge.net/projects/mpcbe/rss?path=/MPC-BE/Release%20builds",
        "regex": "MPC-BE\\.([\\d.]+)\\.x64-installer\\.zip"
    },
    "autoupdate": {
        "architecture": {
