{
    "version": "1.5.0.1237a",
    "description": "Locate files and folders by name instantly.",
    "homepage": "https://www.voidtools.com",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": [
                "https://www.voidtools.com/Everything-1.5.0.1237a.x64.zip",
                "https://www.voidtools.com/Everything.lng.zip"
            ],
            "hash": [
                "409237ddca7b80a1bbc26289edf5b9c54ae289651945de0e60db81e66557a0d7",
                "cf679c0e2ca241828b01816b52c841b48290f916e643f99aa9148bdac823f204"
            ]
        }
    },
    "pre_install": [
        "if (Test-Path \"$dir\\Everything64.exe\") { Rename-Item \"$dir\\Everything64.exe\" 'Everything.exe' }",
        "ensure \"$persist_dir\" | Out-Null",
        "Copy-Item -Path \"$persist_dir\\*\" -Destination \"$dir\" -Recurse -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "$dir_escaped = \"$dir\".Replace('\\', '\\\\')",
        "@('install-context.reg', 'uninstall-context.reg') | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\$bucket\\scripts\\$app\\$_\") {",
        "        $content = Get-Content \"$bucketsdir\\$bucket\\scripts\\$app\\$_\" -Encoding Unicode",
        "        $content = $content.Replace('$install_dir', $dir_escaped)",
        "        if ($global) {",
        "            $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE')",
        "        }",
        "        Set-Content -Path \"$dir\\$_\" $content -Encoding Unicode",
        "    }",
        "}",
        "# 导入注册表",
        "reg import \"$dir\\install-context.reg\""
    ],
    "bin": "Everything.exe",
    "shortcuts": [
        [
            "Everything.exe",
            "Everything"
        ]
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    Stop-Process -Name 'everything' -Force -ErrorAction SilentlyContinue",
        "    $ServiceName = $(Get-Service -Name Everything* -ErrorAction SilentlyContinue).Name",
        "    if ($ServiceName) {",
        "        # cmd 只是容器：一次提权里连跑 stop + delete，避免弹两次 UAC；-RunAs 在已提权时不再弹",
        "        Invoke-ExternalCommand -FilePath cmd.exe -ArgumentList @('/c', 'sc.exe', 'stop', $ServiceName, '&', 'sc.exe', 'delete', $ServiceName) -Quiet -RunAs",
        "    }",
        "    reg import \"$dir\\uninstall-context.reg\"",
        "}",
        "Get-ChildItem \"$dir\\*\" -Exclude 'Everything.exe', 'Everything.lng', 'install-context.reg', 'uninstall-context.reg', 'install.json', 'manifest.json' | Copy-Item -Destination \"$persist_dir\" -ErrorAction SilentlyContinue -Force"
    ],
    "checkver": {
        "url": "https://www.voidtools.com/forum/viewtopic.php?f=12&t=9787",
        "regex": "Everything-([\\d.]+a)\\.x64"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://www.voidtools.com/Everything-$version.x64.zip",
                    "https://www.voidtools.com/Everything.lng.zip"
                ]
            }
        }
    }
}
