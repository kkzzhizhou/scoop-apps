{
    "version": "3.6.0",
    "description": "SiYuan is a privacy-first, self-hosted, fully open source personal knowledge management software, supports fine-grained block-level reference, and Markdown WYSIWYG.",
    "homepage": "https://b3log.org/siyuan",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/appdev/siyuan-unlock/releases/download/v3.6.0/siyuan-unlock-v3.6.0-win.exe#/dl.7z",
            "hash": "b586d463a58657b402fa858e3864a581a33bdd0c90323c65df708b1969b2303a",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\" -Force -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "siyuan.exe",
            "SiYuan Note"
        ]
    ],
    "post_install": [
        "$appConfigPath = \"$env:USERPROFILE\\.config\\siyuan\"",
        "$appDataPath = \"$env:APPDATA\\SiYuan-Electron\"",
        "$persistConfig = \"$persist_dir\\Config\"",
        "$persistRoaming = \"$persist_dir\\Roaming\"",
        "function Test-PersistJunction($item, $target) {",
        "    if (-not $item) { return $false }",
        "    $linkTarget = if ($item.PSObject.Properties['LinkTarget'] -and $item.LinkTarget) { $item.LinkTarget } else { $item.Target }",
        "    if ($linkTarget -is [array]) { $linkTarget = $linkTarget[0] }",
        "    if (-not $linkTarget) { return $false }",
        "    return $linkTarget.ToString().TrimEnd('\\', '/') -ieq $target.TrimEnd('\\', '/')",
        "}",
        "function Remove-PersistTarget($path) {",
        "    $item = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue",
        "    if ($item) {",
        "        Remove-Item -LiteralPath $path -Force -Recurse -ErrorAction Stop",
        "    }",
        "}",
        "$appData = Get-Item -LiteralPath $appConfigPath -Force -ErrorAction SilentlyContinue",
        "$isJunction = [bool]($appData -and ($appData.Attributes -band [System.IO.FileAttributes]::ReparsePoint))",
        "if (-not ($isJunction -and (Test-PersistJunction $appData $persistConfig))) {",
        "    $persistHasData = (Test-Path -LiteralPath $persistConfig) -and (Get-ChildItem -LiteralPath $persistConfig -Force -ErrorAction SilentlyContinue | Select-Object -First 1)",
        "    if (-not $persistHasData) {",
        "        New-Item -ItemType Directory -Path (Split-Path -Path $persistConfig -Parent) -Force -ErrorAction Stop | Out-Null",
        "        Remove-PersistTarget $persistConfig",
        "        if ($appData -and -not $isJunction) {",
        "            Move-Item -LiteralPath $appConfigPath -Destination $persistConfig -Force -ErrorAction Stop",
        "            $appData = $null",
        "        } else {",
        "            New-Item -Path $persistConfig -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "        }",
        "    }",
        "    if ($appData -and -not $isJunction) {",
        "        $bakName = \"siyuan.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Rename-Item -LiteralPath $appConfigPath -NewName $bakName -Force -ErrorAction Stop",
        "        Write-Host \"Existing SiYuan config has been backed up to: $bakName\" -ForegroundColor Yellow",
        "    }",
        "    if ($isJunction) {",
        "        [System.IO.Directory]::Delete($appConfigPath)",
        "    }",
        "    New-Item -ItemType Junction -Path $appConfigPath -Target $persistConfig -ErrorAction Stop | Out-Null",
        "}",
        "$appData = Get-Item -LiteralPath $appDataPath -Force -ErrorAction SilentlyContinue",
        "$isJunction = [bool]($appData -and ($appData.Attributes -band [System.IO.FileAttributes]::ReparsePoint))",
        "if (-not ($isJunction -and (Test-PersistJunction $appData $persistRoaming))) {",
        "    $persistHasData = (Test-Path -LiteralPath $persistRoaming) -and (Get-ChildItem -LiteralPath $persistRoaming -Force -ErrorAction SilentlyContinue | Select-Object -First 1)",
        "    if (-not $persistHasData) {",
        "        New-Item -ItemType Directory -Path (Split-Path -Path $persistRoaming -Parent) -Force -ErrorAction Stop | Out-Null",
        "        Remove-PersistTarget $persistRoaming",
        "        if ($appData -and -not $isJunction) {",
        "            Move-Item -LiteralPath $appDataPath -Destination $persistRoaming -Force -ErrorAction Stop",
        "            $appData = $null",
        "        } else {",
        "            New-Item -Path $persistRoaming -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "        }",
        "    }",
        "    if ($appData -and -not $isJunction) {",
        "        $bakName = \"SiYuan-Electron.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Rename-Item -LiteralPath $appDataPath -NewName $bakName -Force -ErrorAction Stop",
        "        Write-Host \"Existing SiYuan user data has been backed up to: $bakName\" -ForegroundColor Yellow",
        "    }",
        "    if ($isJunction) {",
        "        [System.IO.Directory]::Delete($appDataPath)",
        "    }",
        "    New-Item -ItemType Junction -Path $appDataPath -Target $persistRoaming -ErrorAction Stop | Out-Null",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/appdev/siyuan-unlock"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/appdev/siyuan-unlock/releases/download/v$version/siyuan-unlock-v$version-win.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
