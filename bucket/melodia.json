{
    "version": "2.0.0-beta.4",
    "description": "参考Spotify UI构建的现代化、轻量级第三方网易云音乐客户端。",
    "homepage": "https://github.com/rinchao0721/Melodia",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/rinchao0721/Melodia#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/rinchao0721/Melodia/releases/download/v2.0.0-beta.4/Melodia-v2.0.0-beta.4-windows-x64.zip",
            "hash": "c9386ad5b7c5ccd70585f1e1b3b749773ab6622322973b799493153ecaf4c9c8"
        }
    },
    "extract_dir": "Melodia",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\cachedata\" -Target \"$env:LOCALAPPDATA\\Melodia\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\Melodia\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Melodia\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Melodia\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "Melodia.exe",
    "shortcuts": [
        [
            "Melodia.exe",
            "Melodia"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/rinchao0721/Melodia/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/rinchao0721/Melodia/releases/download/v$version/Melodia-v$version-windows-x64.zip"
            }
        }
    }
}
