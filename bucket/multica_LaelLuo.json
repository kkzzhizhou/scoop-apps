            "hash": "sha512:9cbbed61c2d1aad21ae51f63768ecb2499c7afc428455557088da6dd71a1ac18438e3e94c05488070ba1cc6daa9672441b35610d72f2405db15c46b71b8adb9c",
            "pre_install": [
