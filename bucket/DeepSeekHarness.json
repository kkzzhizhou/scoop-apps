            "hash": "sha512:dfd3ce979a2c97d3ca32aacf5d0039d9d87f6c2574674daf395f5c4e33890c713a82c270a796efee57e00779955802aca57edaff0d624e2fbc2e2b2d761ab8e6",
            "installer": {
                "script": [
                    "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                    "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall DeepSeek Harness.exe\", \"$dir\\7zip-installer-*.txt\" -Force -Recurse -ErrorAction SilentlyContinue"
                ]
            }
        }
    },
