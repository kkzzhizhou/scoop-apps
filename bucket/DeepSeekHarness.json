    "homepage": "https://www.deepseek.com/harness/en/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.2-rc.1-win-x64.exe#/dl.7z",
            "hash": "sha512:b3070ad09ea87c691a0162d1a4e7acd9c6bb0963bcbee339569d0546743f0c6deaf99f8e86fb202f3de1222498a515044d8f9f133f96c3ce9f35ad238952227f",
            "installer": {
                "script": [
                    "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                    "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall DeepSeek Harness.exe\", \"$dir\\7zip-installer-*.txt\" -Force -Recurse -ErrorAction SilentlyContinue"
                ]
            }
        }
    },
