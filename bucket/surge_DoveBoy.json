    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/surge-downloader/Surge#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/surge-downloader/Surge/releases/download/v0.12.0/Surge_0.12.0_windows_amd64.zip",
            "hash": "c3e2efa63dee1f97e3c5a59ebbe163fcbceb976f177ce0fdc217f7d2eab055d1"
        },
        "32bit": {
            "url": "https://github.com/surge-downloader/Surge/releases/download/v0.12.0/Surge_0.12.0_windows_386.zip",
            "hash": "2e6c3abbb2dcfa8567aee5bc6d24378b20e83889a73a230de283dcd75ab78a37"
        },
        "arm64": {
            "url": "https://github.com/surge-downloader/Surge/releases/download/v0.12.0/Surge_0.12.0_windows_arm64.zip",
            "hash": "2e0b3c1175ef95d780d72b1302ebf83257d77c7285d138ed554acab205f8505d"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\surge\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\surge\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "surge.exe",
    "checkver": {
        "github": "https://api.github.com/repos/surge-downloader/Surge/releases",
        "jp": "$[0].assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+)/Surge_([\\d.]+)_windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/surge-downloader/Surge/releases/download/v$version/Surge_$version_windows_amd64.zip"
            },
            "32bit": {
                "url": "https://github.com/surge-downloader/Surge/releases/download/v$version/Surge_$version_windows_386.zip"
            },
            "arm64": {
                "url": "https://github.com/surge-downloader/Surge/releases/download/v$version/Surge_$version_windows_arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/Surge_$version_checksums.txt"
        }
    }
}
