        "url": "https://github.com/SurgeDM/Surge#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/SurgeDM/Surge/releases/download/v0.13.0/Surge_0.13.0_windows_amd64.zip",
            "hash": "72b6f9265f95b97bb392b872cb2dd4e61b416e78303be68eeb7dbd8b1e19b0a6"
        },
        "32bit": {
            "url": "https://github.com/SurgeDM/Surge/releases/download/v0.13.0/Surge_0.13.0_windows_386.zip",
            "hash": "084f48088f3a5c69fae7a62e2f7e4820664193c70e033a3446dafcbce2941ffd"
        },
        "arm64": {
            "url": "https://github.com/SurgeDM/Surge/releases/download/v0.13.0/Surge_0.13.0_windows_arm64.zip",
            "hash": "ae9c14b99366d178234e779490ea44cbdc46f8a9cbc45d49eb910488ffeb6526"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\surge\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\surge\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "surge.exe",
    "checkver": {
        "github": "https://api.github.com/repos/SurgeDM/Surge/releases",
        "jp": "$[0].assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+)/Surge_([\\d.]+)_windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SurgeDM/Surge/releases/download/v$version/Surge_$version_windows_amd64.zip"
            },
            "32bit": {
                "url": "https://github.com/SurgeDM/Surge/releases/download/v$version/Surge_$version_windows_386.zip"
            },
            "arm64": {
                "url": "https://github.com/SurgeDM/Surge/releases/download/v$version/Surge_$version_windows_arm64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt"
        }
    }
}
