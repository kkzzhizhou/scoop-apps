{
    "version": "0.1.14",
    "description": "Seven offline-first desktop apps for documents, slides, sheets, PDF, mail, git and notes",
    "homepage": "https://office.elygpui.com",
    "license": "MIT",
    "url": "https://github.com/ELY-Open-Source/ElyOffice/releases/download/v0.1.14/ElyOffice-0.1.14-windows-x86_64-setup.exe#/dl.7z",
    "hash": "105896a60a27c5f9c15234888b6cdffc43942fe894d4f626702d2815cf78ced5",
    "installer": {
        "script": [
            "Get-ChildItem $original_dir/PLUGINSDIR -Filter '*-setup.exe' | ForEach-Object {",
            "    $app = $_.Name -replace '-setup\\.exe$', ''",
            "    Expand-7zipArchive -Path $_.FullName -DestinationPath (Join-Path $dir $app) -Switches '-xr!$PLUGINSDIR -xr!uninstall.exe'",
            "}"
        ]
    },
    "extract_dir": "$PLUGINSDIR",
    "extract_to": "PLUGINSDIR",
    "post_install": "Remove-Item -RECURSE $original_dir/PLUGINSDIR",
    "shortcuts": [
        [
            "ElyDoc\\ely-doc.exe",
            "ElyDoc"
        ],
        [
            "ElyTable\\ely-table.exe",
            "ElyTable"
        ],
        [
            "ElyShow\\ely-show.exe",
            "ElyShow"
        ],
        [
            "ElyPDF\\ely-pdf.exe",
            "ElyPDF"
        ],
        [
            "ElyMail\\ely-mail.exe",
            "ElyMail"
        ],
        [
            "ElyTree\\ely-tree.exe",
            "ElyTree"
        ],
        [
            "ElyMark\\ely-mark.exe",
            "ElyMark"
        ]
    ],
    "checkver": {
        "github": "https://github.com/ELY-Open-Source/ElyOffice"
    },
    "autoupdate": {
        "url": "https://github.com/ELY-Open-Source/ElyOffice/releases/download/v$version/ElyOffice-$version-windows-x86_64-setup.exe#/dl.7z"
    }
}
