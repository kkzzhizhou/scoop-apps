    "post_install": [
        "# Emaki's in-app updater targets Velopack installs; Scoop owns updates. Opt out on first install only, never overriding an existing config.",
        "$emakiDir = \"$env:USERPROFILE\\.emaki\"",
        "if (-not (Test-Path \"$emakiDir\\config.json\") -and -not (Test-Path \"$env:USERPROFILE\\.scribe\")) {",
        "    New-Item -ItemType Directory -Force $emakiDir | Out-Null",
        "    [IO.File]::WriteAllText(\"$emakiDir\\config.json\", '{\"app\":{\"check_updates\":false}}')",
        "}"
    ],
    "notes": "Updates are managed by Scoop. On first install, automatic update checks are turned off (Settings > About > Check automatically).",
    "checkver": {
        "github": "https://github.com/alkaline-software/emaki"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/alkaline-software/emaki/releases/download/v$version/AlkalineSoftware.Emaki-$version-win-x64-full.nupkg#/dl.7z"
