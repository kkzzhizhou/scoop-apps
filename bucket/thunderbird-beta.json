            "hash": "sha512:e945d559089407069bd75b9cbaa070a18b63dc02afb56c8bdfbf7dca649a1b15b05e0327d3c0c7609dca1513e996f4f31dbbea2a0d49e23906d61041cc18fd40"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/157.0b3/win32/en-US/Thunderbird%20Setup%20157.0b3.exe#/dl.7z",
            "hash": "sha512:cd601d5c356d473050694e197befe1d9db971afc9a7ca7bfcca031e662f2f7a520cfaa8537d816aecc6c045a0d907dc9e0e1ec1955e8d9bf6dc74f1b49b42f90"
