    "homepage": "https://www.thunderbird.net",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/155.0b2/win64/en-US/Thunderbird%20Setup%20155.0b2.exe#/dl.7z",
            "hash": "sha512:fc8c4161354c2896b7fa0fbc8333dea1a5b361720c242e0bd4eb16f03e1c4181983252fed97ef070710fbe8bdfb558dbf0028a72f916704bf80050d003eeb784"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/155.0b2/win32/en-US/Thunderbird%20Setup%20155.0b2.exe#/dl.7z",
            "hash": "sha512:c35ed19145e5e173a922675c11338ca5990d721f00836221d0986840843b0034e995dd90a102c59c2efca6a3ea521d5401b615898cb7662615877a3e298d908e"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "thunderbird.exe",
            "thunderbird-beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "shortcuts": [
        [
            "thunderbird.exe",
            "Mozilla Thunderbird Beta",
            "-profile \"$dir\\profile\""
        ]
    ],
    "persist": "profile",
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/thunderbird_versions.json",
        "jsonpath": "$.LATEST_THUNDERBIRD_DEVEL_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/win64/en-US/Thunderbird%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/win32/en-US/Thunderbird%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/thunderbird/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            }
        }
    }
}
