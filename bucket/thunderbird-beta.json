            "hash": "sha512:10cc5e4c08062db60a618f8999ad22a5ff399a6826819aac6028a6182f0d5abc9ac431d8ac3bc64b8f48cf1b57717208907665cc9d23c74f7f7aeb398e9b082b"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/159.0b3/win32/en-US/Thunderbird%20Setup%20159.0b3.exe#/dl.7z",
            "hash": "sha512:10886679a3392fe700ea8c2d2bd92386ea5e7bee9c6fa9b9477e7234f3d75bf6bbe67933c8da95f53018e68217a9a279cacaebd46a5a513dc91186df6c5f6b00"
