            "hash": "sha512:b538c9ee0a8a05e3252e9435705398db7f1c5de4b8629655d9192da0870a3e4bad9216dba25a71f8fc839309500de17a7d5748a2ed35faa3a4cbe61e93383338"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/158.0b1/win32/en-US/Thunderbird%20Setup%20158.0b1.exe#/dl.7z",
            "hash": "sha512:e7c210838c4f9940cc95b3781b8dd269f79886921014d6c419022cddd1b88810c579dfca76edeced5603b1faa61387877b1d166e281dbd9731e523f7f815ff49"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "thunderbird.exe",
            "thunderbird-beta",
            "-profile \"$dir\\profile\""
