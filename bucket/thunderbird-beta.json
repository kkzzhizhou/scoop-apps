            "hash": "sha512:029433227640e2fa03e06014fb98a2a41a73767a52162fb28add33b7118b89d8c19b0e578b8af245bf79052841f259417babb62f5604a8ff16e60a44aa8f4bfd"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/158.0b2/win32/en-US/Thunderbird%20Setup%20158.0b2.exe#/dl.7z",
            "hash": "sha512:4857a18691c28eacdc5871ce2cc4a3cd1c1b1bc17cff5515a7043d937dbe8014e836bc797b7b1c0f44f435772b309984d0d1189b805f75852785b4d56bc6adfd"
