            "hash": "sha512:cc01d30936a81e7fc5ce6df4df458a5792e10a99581dfa44db988fae6f26fa81edf56de7356b16e159c6b461e0b452a201714778b4570ee5882f9d15d1b3ab3f"
        },
        "32bit": {
