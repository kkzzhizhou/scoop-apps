            "hash": "sha512:a70beb562bdade233f861dfe4bd9b5310a7190fe313f05398c0949dc8c8cdba8a3212d1d8cfd1a7d4c2b9da08676b3e035d0aad1fa8901b02e98459ad00eaa38"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/thunderbird/releases/157.0b4/win32/en-US/Thunderbird%20Setup%20157.0b4.exe#/dl.7z",
            "hash": "sha512:a72d88f44b205159a3c59a5467ada30da1b7830e3e7c3cfdefb6ab584ac06a8458a591cf98ab1e583f2640a60bfe9931c0ba7f3360f9c7b40b031bf940c8d73a"
