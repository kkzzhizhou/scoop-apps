{
    "version": "0.4.579",
    "description": "Elegant AI Provider Orchestration",
    "homepage": "https://alma.now/",
    "license": "Proprietary",
    "##": "0.4.5xx 起上游改用自研 almapack 打包: 安装包内是平铺的应用文件, 不再有 electron-builder 的 $PLUGINSDIR/app-64.7z. pre_install 兼容两种布局",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yetone/alma-releases/releases/download/v0.4.579/alma-0.4.579-win-x64.exe#/dl.7z",
            "hash": "e7edf3afe02fb3d34f0451de8f7ee400955c7d491bec27d9b9ac33f8b7d15763",
            "pre_install": [
                "$archive = \"$dir\\`$PLUGINSDIR\\app-64.7z\"",
                "if (Test-Path $archive) { Expand-7zipArchive $archive $dir }",
                "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\Uninstall.exe\" -Force -Recurse -ErrorAction SilentlyContinue",
                "if (!(Test-Path \"$dir\\Alma.exe\")) { throw 'Alma.exe not found after extraction' }"
            ]
        }
    },
    "shortcuts": [
        [
            "Alma.exe",
            "Alma"
        ]
    ],
    "checkver": {
        "github": "https://github.com/yetone/alma-releases"
    },
    "autoupdate": {
        "url": "https://github.com/yetone/alma-releases/releases/download/v$version/alma-$version-win-x64.exe#/dl.7z",
        "hash": {
            "mode": "extract",
            "url": "https://github.com/yetone/alma-releases/releases/expanded_assets/v$version",
            "regex": "alma-$version-win-x64\\.exe.*?sha256:$sha256"
        }
    },
    "post_uninstall": [
        "$shim = Join-Path $env:LOCALAPPDATA 'Alma\\bin'",
        "$key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)",
        "if ($key) {",
        "    $raw = $key.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)",
        "    $cur = @($raw -split ';' | Where-Object { $_ })",
        "    $new = @($cur | Where-Object { $_.TrimEnd('\\') -ne $shim.TrimEnd('\\') })",
        "    if ($new.Count -ne $cur.Count) { $key.SetValue('Path', ($new -join ';'), $key.GetValueKind('Path')) }",
        "    $key.Close()",
        "}",
        "Remove-Item $shim -Recurse -Force -ErrorAction SilentlyContinue"
    ]
}
