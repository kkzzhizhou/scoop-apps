{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "11.0.100",
    "homepage": "https://www.microsoft.com/net/",
    "description": ".NET is a free, cross-platform, open source developer platform for building many different types of applications.",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://dotnetcli.azureedge.net/dotnet/Sdk/11.0.100/dotnet-sdk-11.0.100-win-x64.zip",
            "hash": "ae800f1fa1a6428e0d7c740bb745d9414f15334118c51e246dab9850b738fadd"
        },
        "32bit": {
            "url": "https://dotnetcli.azureedge.net/dotnet/Sdk/11.0.100/dotnet-sdk-11.0.100-win-x86.zip",
            "hash": "cf65b019b399173e4bc9311d14e6f5587838cc1a3f7b72dec4b08441a19441bf"
        },
        "arm64": {
            "url": "https://dotnetcli.azureedge.net/dotnet/Sdk/11.0.100/dotnet-sdk-11.0.100-win-arm64.zip",
            "hash": "f9a271f91ea25a65f7eb742269b0881f657ff35b2b485016d27e2cc7b27c1969"
        }
    },
    "bin": "dotnet.exe",
    "checkver": {
        "url": "https://raw.githubusercontent.com/dotnet/core/master/release-notes/releases-index.json",
        "jsonpath": "$..releases-index[0]",
        "regex": "\"latest-release\": \"(?<shaver>[^\"]+)\",(?s:.)*?\"latest-sdk\": \"(?<version>[^\"]+)\",",
        "replace": "${version}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dotnetcli.azureedge.net/dotnet/Sdk/$version/dotnet-sdk-$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://dotnetcli.azureedge.net/dotnet/Sdk/$version/dotnet-sdk-$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://dotnetcli.azureedge.net/dotnet/Sdk/$version/dotnet-sdk-$version-win-arm64.zip"
            }
        },
        "hash": {
            "url": "https://dotnetcli.blob.core.windows.net/dotnet/checksums/$matchShaver-sha.txt"
        }
    }
}
