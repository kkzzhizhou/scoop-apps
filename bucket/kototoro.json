{
    "version": "2.3.8",
    "description": "Manga, Novel, and Video reader for Android",
    "homepage": "https://github.com/Kototoro-app/Kototoro",
    "license": {
        "identifier": "Apache-2.0 license",
        "url": "https://github.com/Kototoro-app/Kototoro#Apache-2.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Kototoro-app/Kototoro/releases/download/v2.3.8/Kototoro-2.3.8-windows-x64-release.msi",
            "hash": "21ffa8491ef07df108350fda7d5ee3f1f2392a1ada52cc0ffb2565a302f47ffd"
        }
    },
    "extract_dir": "Kototoro-App",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\Kototoro\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Kototoro\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "Kototoro.exe",
    "shortcuts": [
        [
            "Kototoro.exe",
            "Kototoro"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Kototoro-app/Kototoro/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kototoro-app/Kototoro/releases/download/v$version/Kototoro-$version-windows-x64-release.msi"
            }
        }
    }
}
