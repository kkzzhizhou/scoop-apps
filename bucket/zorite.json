{
    "version": "0.14.0",
    "description": "A daily-journal note app for the desktop, organized like Logseq but edited like an ordinary document rather than an outliner.",
    "homepage": "https://github.com/packetThrower/zorite",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/packetThrower/zorite/releases/download/v0.14.0/Zorite-Windows-amd64-0.14.0.zip",
            "hash": "5ff3013e4e54213df5f0f1f467aaebbc02c681b2fc4855b50503c0ee9471a260"
        },
        "arm64": {
            "url": "https://github.com/packetThrower/zorite/releases/download/v0.14.0/Zorite-Windows-arm64-0.14.0.zip",
            "hash": "c4b88922236c711903040361dae0853a6c4a4600c6f331c95fbb2e9ecc8b39d1"
        }
    },
    "bin": [
        [
            "zorite.exe",
            "zorite"
        ]
    ],
    "shortcuts": [
        [
            "zorite.exe",
            "Zorite"
        ]
    ],
    "persist_external": [
        [
            "$env:AppData\\zorite",
            "data",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": {
        "github": "https://github.com/packetThrower/zorite"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/packetThrower/zorite/releases/download/v$version/Zorite-Windows-amd64-$version.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "([a-fA-F0-9]{64})\\s+\\S*Zorite-Windows-amd64-$version\\.zip$"
                }
            },
            "arm64": {
                "url": "https://github.com/packetThrower/zorite/releases/download/v$version/Zorite-Windows-arm64-$version.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "([a-fA-F0-9]{64})\\s+\\S*Zorite-Windows-arm64-$version\\.zip$"
                }
            }
        }
    }
}
