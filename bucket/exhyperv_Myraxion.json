{
    "version": "1.5.2",
    "description": "A GUI software that provides advanced HyperV virtual machine features such as DDA and GPU-PV.",
    "homepage": "https://github.com/Justsenger/ExHyperV",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Justsenger/ExHyperV/releases/download/V1.5.2/ExHyperV_V1.5.2_x64.exe#/ExHyperV.exe",
            "hash": "3be0de2ed2e1eee5b526c3c4a539488980d71af869842fec17a071e8170080e1"
        },
        "arm64": {
            "url": "https://github.com/Justsenger/ExHyperV/releases/download/V1.5.2/ExHyperV_V1.5.2_arm64.exe#/ExHyperV.exe",
            "hash": "7a27691523e5a05050d419f93040d2906fcd14187a3afe5d853423585882f937"
        }
    },
    "license": "GPL-3.0-or-later",
    "suggest": {
        "Microsoft .NET 8.0 Desktop Runtime": "windowsdesktop-runtime-lts"
    },
    "shortcuts": [
        [
            "ExHyperV.exe",
            "ExHyperV"
        ]
    ],
    "pre_install": [
        "$config_path = \"$persist_dir\\config.xml\"",
        "",
        "if (!(Test-Path $config_path) -or (Get-Item $config_path).Length -eq 0) {",
        "    if (!(Test-Path \"$persist_dir\")) { New-Item \"$persist_dir\" -ItemType Directory -Force | Out-Null }",
        "    ",
        "    Write-Host \"Generating default config.xml...\" -ForegroundColor Yellow",
        "    ",
        "    $content = @(",
        "        '<?xml version=\"1.0\" encoding=\"utf-8\"?>',",
        "        '<Config>',",
        "        '  <Language>zh-CN</Language>',",
        "        '</Config>'",
        "    )",
        "    ",
        "    Set-Content -Path $config_path -Value $content -Encoding UTF8",
        "}"
    ],
    "persist": "config.xml",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Justsenger/ExHyperV/releases/download/V$version/ExHyperV_V$version_x64.exe#/ExHyperV.exe"
            },
            "arm64": {
                "url": "https://github.com/Justsenger/ExHyperV/releases/download/V$version/ExHyperV_V$version_arm64.exe#/ExHyperV.exe"
            }
        }
    }
}
