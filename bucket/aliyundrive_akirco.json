{
    "version": "6.9.3",
    "description": "The official client for Alibaba's cloud dirve service",
    "homepage": "https://www.alipan.com/",
    "license": {
        "identifier": "EULA",
        "url": "https://www.alipan.com/protocol/service"
    },
    "url": "https://cdn.aliyundrive.net/downloads/apps/desktop/update/6.9.3/win32/x64/aDrive-6.9.3.exe?_=sourceforge.net",
    "hash": "sha512:8b1d1951ba7e9a83954d202df8d16257ad837dba7eaea0b0f6304bff4eba49fed4e05428a2fe01077bd0d6e697d46f0fdad6f172833b7fc9f82c5db15f123db5",
    "post_install": [
        "@('$PLUGINSDIR', '$TEMP') | ForEach-Object {",
        "    Remove-Item \"$dir\\$_\" -Recurse -Force",
        "}"
    ],
    "post_uninstall": [
        "$cache_dir=Join-Path $env:APPDATA aDrive",
        "Remove-Item $cache_dir -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "aDrive.exe",
            "阿里云盘"
        ]
    ],
    "checkver": {
        "url": "https://api.nicoconi.com/updater/aliyundrive",
        "regex": "version: ([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://cdn.aliyundrive.net/downloads/apps/desktop/update/$version/win32/x64/aDrive-$version.exe?_=sourceforge.net",
        "hash": {
            "url": "https://api.nicoconi.com/updater/aliyundrive",
            "regex": "sha512: $base64"
        }
    }
}
