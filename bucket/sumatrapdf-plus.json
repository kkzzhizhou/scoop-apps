        }
    },
    "bin": "SumatraPDF-Plus.exe",
    "shortcuts": [
        [
            "SumatraPDF-Plus.exe",
            "SumatraPDF Plus"
        ]
    ],
    "persist": [
        "SumatraPDF-settings.txt",
        "sumatrapdfcache",
        "Annotations",
        "dict",
        "ocr",
