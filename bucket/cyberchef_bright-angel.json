    "homepage": "https://gchq.github.io/CyberChef/",
    "license": "Apache-2.0",
    "url": "https://github.com/gchq/CyberChef/releases/download/v11.5.0/CyberChef_8cd426dd4f40f1423912d5fad91b578a86a65112.zip#/CyberChef.zip",
    "hash": "sha256:f6478925d3eaa16ec08626a85f5b85eed10d531a5e18700615fed7ecb024cccf",
    "suggest": {
        "python": "uv"
    },
    "pre_install": [
        "Rename-Item \"$dir\\CyberChef_v$version.html\" \"index.html\" -ErrorAction SilentlyContinue",
        "Set-Content \"$dir\\CyberChef.bat\" '@pushd %~dp0",
        "@start uv run python -m http.server 8991",
        "@start http://127.0.0.1:8991",
        "@popd' -Encoding Ascii"
    ],
    "bin": "CyberChef.bat",
    "shortcuts": [
        [
            "CyberChef.bat",
            "CyberChef"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/gchq/CyberChef/releases/latest",
        "regex": "download/v([\\d.]+)/CyberChef_(?<sha>[0-9a-f]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://github.com/gchq/CyberChef/releases/download/v$version/CyberChef_$matchSha.zip#/CyberChef.zip"
    },
    "notes": [
        "【工具类型】: 安全工具",
        "【主要功能】: 提供加密、编码、压缩、数据分析等 400+ 种数据处理操作的 Web 应用",
        "【适用场景】: CTF 比赛、数据分析、编码解码、加解密、取证分析",
        "【技术特点】: 纯前端 Web 应用，通过 uv 启动本地 HTTP 服务（端口 8991）访问",
        "【注意事项】: 启动后浏览器自动打开 http://127.0.0.1:8991；服务在新窗口运行，关闭该窗口即停止服务；首次运行 uv 可能需要下载 Python，请稍候"
    ]
}
