{
    "version": "r42",
    "description": "A terminal file manager written in Go",
    "homepage": "https://godoc.org/github.com/gokcehan/lf",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/gokcehan/lf/releases/download/r42/lf-windows-amd64.zip",
            "hash": "13bb576b02373610dbcfb97e483272198a1b94cada66298a302954d87613465c"
        },
        "32bit": {
            "url": "https://github.com/gokcehan/lf/releases/download/r42/lf-windows-386.zip",
            "hash": "ac1a28bf62bfeb99738697d534fb0346535e5a457bafbcc502df2a88865f062f"
        }
    },
    "bin": "lf.exe",
    "installer": {
        "script": [
            "if (!(Test-Path \"$persist_dir\\Cache\")) {",
            "    New-Item \"$persist_dir\\Cache\" -Type Directory -Force | Out-Null",
            "}",
            "$runtimeCache = \"$env:LOCALAPPDATA\\lf\"",
            "$runtimeCachePersist = \"$persist_dir\\Cache\"",
            "if (Test-Path $runtimeCachePersist) {",
            "    Remove-Item $runtimeCache -Force -Recurse -ErrorAction SilentlyContinue",
            "    New-Item -Type Junction -Path $runtimeCache -Target $runtimeCachePersist | Out-Null",
            "} else {",
            "    if (Test-Path $runtimeCache) {",
            "        Move-Item $runtimeCache $runtimeCachePersist -Force",
            "        New-Item -Type Junction -Path $runtimeCache -Target $runtimeCachePersist | Out-Null",
            "    }",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$runtimeCache = \"$env:LOCALAPPDATA\\lf\"",
            "$runtimeCachePersist = \"$persist_dir",
            "Remove-Item $runtimeCache -Force -Recurse -ErrorAction SilentlyContinue",
            "Remove-Item $runtimeCachePersist -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "checkver": {
        "github": "https://github.com/gokcehan/lf/",
        "regex": "tag/(r[\\d]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gokcehan/lf/releases/download/$version/lf-windows-amd64.zip"
            },
            "32bit": {
                "url": "https://github.com/gokcehan/lf/releases/download/$version/lf-windows-386.zip"
            }
        }
    }
}
