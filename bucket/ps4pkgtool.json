            "hash": "1ef9bb1f4ec1ad4e10f5a7d814e216323019385977c5b4409c911c5943884ea1"
        }
    },
    "bin": [["PS4 PKG Tool.exe", "ps4pkgtool"]],
    "shortcuts": [["PS4 PKG Tool.exe", "PS4 PKG Tool"]],
    "persist": "AppData",
    "pre_uninstall": "if (Test-Path \"$dir\\PS4 PKG Tool.exe\") { & \"$dir\\PS4 PKG Tool.exe\" --shell-unregister }",
    "checkver": {
        "github": "https://github.com/pearlxcore/PS4PKGTool"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pearlxcore/PS4PKGTool/releases/download/v$version/PS4-PKG-Tool-v$version.zip"
            }
        }
    }
