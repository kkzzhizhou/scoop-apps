    "license": "GPL-3.0-only",
    "notes": [
        "Requires the Microsoft .NET 10 Windows Desktop Runtime.",
        "Can be installed with: scoop install extras/windowsdesktop-runtime",
        "Enable File Explorer integration: ps4pkgtool --shell-register"
