{
    "version": "3.2.5",
    "license": "SIL OFL 1.1",
    "homepage": "https://github.com/font-store/FarbodFont",
    "url": "https://github.com/font-store/FarbodFont/releases/download/v3.2.5/Farbod-3.2.5.zip",
    "hash": "da43dcb7b37a242d426771d20aa181b60ab91411c4b6b5408aa4d5473c07cdc4",
    "pre_install": [
        "Remove-Item $dir\\* -exclude *.ttf -Force -Recurse"
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\naderi\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\naderi\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    },
    "checkver": {
        "url": "https://github.com/font-store/FarbodFont/tags",
        "regex": "/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/font-store/FarbodFont/releases/download/v$version/Farbod-$version.zip"
    }
}
