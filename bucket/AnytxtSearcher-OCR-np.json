{
    "version": "1.3.3514",
    "description": "A local document search application",
    "homepage": "https://anytxt.net/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3514_Windows_X86_64_OCR.exe",
            "hash": "sha1:b341f8a57af3b0f3254a4cc331af6c9543c21e55"
        },
        "32bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3514_Windows_X86_32_OCR.exe",
            "hash": "sha1:bf1ddb3a2052e1ae0f218f91ecd70c4d09f9ba1e"
        }
    },
    "installer": {
        "args": [
            "/silent",
            "/dir=$dir"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": "/silent"
    },
    "bin": "ATGUI.exe",
    "shortcuts": [
        [
            "ATGUI.exe",
            "AnyTXT Searcher OCR"
        ]
    ],
    "checkver": {
        "url": "https://anytxt.net/download/",
        "regex": "Anytxt_([\\d.]+)_Windows_X86_64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_$version_Windows_X86_64_OCR.exe"
            },
            "32bit": {
                "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_$version_Windows_X86_32_OCR.exe"
            }
        },
        "hash": {
            "mode": "sourceforge"
        }
    }
}
