{
    "version": "1.3.3803",
    "description": "A local document search application",
    "homepage": "https://anytxt.net/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3803_Windows_X86_64_OCR.exe",
            "hash": "sha1:6acb3bf89b2767cf687aa1bc82d46e4c70f8f940"
        },
        "32bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3803_Windows_X86_32_OCR.exe",
            "hash": "sha1:95204e1e380f8e3aa2f78e8a4eebbae5bebfc789"
        }
    },
    "installer": {
        "args": [
            "/silent",
            "/dir=$dir"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": "/silent"
    },
    "bin": "ATGUI.exe",
    "shortcuts": [
        [
            "ATGUI.exe",
            "AnyTXT Searcher OCR"
        ]
    ],
    "checkver": {
        "url": "https://anytxt.net/download/",
        "regex": "Anytxt_([\\d.]+)_Windows_X86_64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_$version_Windows_X86_64_OCR.exe"
            },
            "32bit": {
                "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_$version_Windows_X86_32_OCR.exe"
            }
        },
        "hash": {
            "mode": "sourceforge"
        }
    }
}
