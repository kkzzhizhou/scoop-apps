    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3655_Windows_X86_64_OCR.exe",
            "hash": "sha1:25bc7bb09290712482c887e017534a353fa9ac77"
        },
        "32bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3655_Windows_X86_32_OCR.exe",
