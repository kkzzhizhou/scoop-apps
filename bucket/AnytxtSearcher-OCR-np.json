{
    "version": "1.3.3725",
    "description": "A local document search application",
    "homepage": "https://anytxt.net/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3725_Windows_X86_64_OCR.exe",
            "hash": "sha1:61fc2de61fdfcd483a0c6345d0da3f4b727b3351"
        },
        "32bit": {
            "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_1.3.3725_Windows_X86_32_OCR.exe",
            "hash": "sha1:d6cc948c22a52844870f22db92dea1b3a7645106"
        }
    },
    "installer": {
        "args": [
            "/silent",
            "/dir=$dir"
        ]
    },
    "uninstaller": {
        "file": "unins000.exe",
        "args": "/silent"
    },
    "bin": "ATGUI.exe",
    "shortcuts": [
        [
            "ATGUI.exe",
            "AnyTXT Searcher OCR"
        ]
    ],
    "checkver": {
        "url": "https://anytxt.net/download/",
        "regex": "Anytxt_([\\d.]+)_Windows_X86_64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_$version_Windows_X86_64_OCR.exe"
            },
            "32bit": {
                "url": "https://sourceforge.net/projects/anytxt/files/Anytxt_$version_Windows_X86_32_OCR.exe"
            }
        },
        "hash": {
            "mode": "sourceforge"
        }
    }
}
