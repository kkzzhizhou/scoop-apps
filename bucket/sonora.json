{
    "version": "0.49.1",
    "description": "A native music streaming client, built with Rust and GPUI.",
    "homepage": "https://sonorahq.org/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sonorahq/sonora/releases/download/v0.49.1/sonora-v0.49.1-x86_64-pc-windows-msvc.exe#/sonora.exe",
            "hash": "c20629ff020b19b3dd80e5d4862f960036db61e07b7f7d51d95feef20b59b6bd"
        },
        "arm64": {
            "url": "https://github.com/sonorahq/sonora/releases/download/v0.49.1/sonora-v0.49.1-aarch64-pc-windows-msvc.exe#/sonora.exe",
            "hash": "3d9a6650e2e12f7c2348c2d4c914ccd7d715e96b80dbeb120e12a2b448a85ed0"
        }
    },
    "bin": "sonora.exe",
    "shortcuts": [
        [
            "sonora.exe",
            "Sonora"
        ]
    ],
    "persist_external": [
        [
            "$env:AppData\\sonora",
            "config",
            "directory"
        ],
        [
            "$env:LocalAppData\\sonora",
            "data",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": {
        "github": "https://github.com/sonorahq/sonora"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sonorahq/sonora/releases/download/v$version/sonora-v$version-x86_64-pc-windows-msvc.exe#/sonora.exe",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                }
            },
            "arm64": {
                "url": "https://github.com/sonorahq/sonora/releases/download/v$version/sonora-v$version-aarch64-pc-windows-msvc.exe#/sonora.exe",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                }
            }
        }
    }
}
