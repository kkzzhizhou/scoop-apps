        [
            "bin\\Audacity4.exe",
            "Audacity"
        ]
    ],
    "persist": "Portable Settings",
    "checkver": {
        "github": "https://github.com/audacity/audacity",
        "regex": "Audacity-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/audacity/audacity/releases/download/Audacity-$version/audacity-win-$version-x86_64.msi"
            },
            "arm64": {
