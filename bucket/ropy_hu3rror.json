{
    "version": "0.6.1",
    "description": "A clipboard manager built with Rust and GPUI",
    "homepage": "https://github.com/StudentWeis/ropy",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/StudentWeis/ropy/releases/download/0.6.1/ropy-x86_64-pc-windows-msvc.zip",
            "hash": "5f2cf436535ba3270cfd4afd9d6c98252271903a0abc5cf762f67d6ea0edc421"
        }
    },
    "shortcuts": [
        [
            "ropy.exe",
            "Ropy"
        ]
    ],
    "persist_external": [
        [
            "$env:AppData\\ropy",
            "config",
            "directory"
        ],
        [
            "$env:LocalAppData\\ropy",
            "data",
            "directory"
        ]
    ],
    "post_install": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        "$helper = (Resolve-Path \"$bucketsdir/*/scripts/persist-external.ps1\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$helper) { throw 'persist_external: persist-external.ps1 not found under scripts/ in any bucket' }",
        ". $helper",
        "Invoke-PersistExternalUninstall"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/StudentWeis/ropy/releases/download/$version/ropy-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "https://github.com/StudentWeis/ropy/releases/download/$version/ropy-x86_64-pc-windows-msvc.zip.sha256"
                }
            }
        }
    }
}
