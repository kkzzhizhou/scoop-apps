{
    "version": "0.6.0",
    "description": "A clipboard manager built with Rust and GPUI",
    "homepage": "https://github.com/StudentWeis/ropy",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/StudentWeis/ropy/releases/download/0.6.0/ropy-x86_64-pc-windows-msvc.zip",
            "hash": "76f76fc3aed98b12e1234a49b88f98dab40fcf8ee442ace4c950cb6aeffdaca4"
        }
    },
    "shortcuts": [
        [
            "ropy.exe",
            "Ropy"
        ]
    ],
    "persist_external": [
        [
            "$env:AppData\\ropy",
            "config",
            "directory"
        ],
        [
            "$env:LocalAppData\\ropy",
            "data",
            "directory"
        ]
    ],
    "post_install": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalInstall -Manifest $manifest -PersistDir $persist_dir -Dir $dir"
    ],
    "pre_uninstall": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalUninstall -Manifest $manifest -Dir $dir"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/StudentWeis/ropy/releases/download/$version/ropy-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "https://github.com/StudentWeis/ropy/releases/download/$version/ropy-x86_64-pc-windows-msvc.zip.sha256"
                }
            }
        }
    }
}
