{
    "homepage": "https://wingware.com/",
    "description": "A very simple python IDE designed for teaching beginning programmers",
    "license": "unknown",
    "version": "12.1.2.0",
    "url": "https://wingware.com/pub/wing-101/12.1.2.0/wing-101-12.1.2.0-win.zip",
    "hash": "a4f032c486ac2cf905f1d238d1b925d15f2be74b251d472afc09cc1a59433286",
    "installer": {
        "script": [
            "$fold = (Get-ChildItem \"$dir\" '*' | Select-Object -First 1).FullName",
            "Move-Item \"$fold\\*\" \"$dir\"",
            "Remove-Item \"$fold\""
        ]
    },
    "bin": "bin\\console_wing-personal.exe",
    "shortcuts": [
        [
            "bin\\wing-personal.exe",
            "Wing Personal"
        ]
    ],
    "checkver": {
        "url": "https://wingware.com/downloads/wing-101",
        "regex": "Download Wing 101 version ([\\d.]+) product and documentation"
    },
    "autoupdate": {
        "url": "https://wingware.com/pub/wing-101/$version/wing-101-$version-win.zip",
        "hash": {
            "url": "https://wingware.com/pub/wing-101/$version/wing-101-$version-win.zip.sha256",
            "find": "([a-fA-F0-9]{64})"
        }
    }
}
