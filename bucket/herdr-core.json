{
    "version": "0.1.17",
    "description": "Runs programs and coding agents in terminals that stay alive after you leave, letting agents start one another and any shell or app attach to them",
    "homepage": "https://github.com/herdrdev/herdr-core",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://releases.herdr.dev/core/0.1.17/herdr-core-windows-x86_64.zip",
            "hash": "a212b69db0efb808882683f15e5da45ab9606da7bcc54b97b29ed4fa540f5491"
        }
    },
    "bin": [
        "herdr-core.exe",
        [
            "herdr-core.exe",
            "hc"
        ]
    ],
    "notes": [
        "Herdr (herdr-app) looks for herdr-core on PATH first, so it uses this one instead of installing its own",
        "Update with Scoop: `hc update` (even from Herdr's prompt) replaces the files in the versioned folder, and Scoop loses track of the version"
    ],
    "checkver": {
        "url": "https://releases.herdr.dev/core/latest.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://releases.herdr.dev/core/$version/herdr-core-windows-x86_64.zip",
                "hash": {
                    "url": "https://releases.herdr.dev/core/latest.json",
                    "jsonpath": "$.targets['windows-x86_64'].sha256"
                }
            }
        }
    }
}
