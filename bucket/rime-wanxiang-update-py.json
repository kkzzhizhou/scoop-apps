        "        'github_token = ',",
        "        'cnb_token = ',",
        "        'exclude_files = ',",
        "        'auto_update = false'",
        "    )",
        "    Set-Content -Path \"$dir\\settings.ini\" -Value $content -Encoding UTF8",
        "}"
    ],
    "bin": [
        [
            "rime-wanxiang-update-win-mac-ios-android.py",
            "rime-wanxiang-update-py"
        ],
        [
            "rime-wanxiang-update-win-mac-ios-android.py",
