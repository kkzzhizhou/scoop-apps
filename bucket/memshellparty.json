{
    "version": "3.1.0",
    "description": "一款专注于 Java 主流 Web 中间件的内存马快速生成工具，致力于简化安全研究人员和红队成员的工作流程，提升攻防效率",
    "homepage": "https://party.memshell.news",
    "license": "MIT",
    "notes": [
        "https://github.com/ViCrack/scoop-bucket/blob/master/bucket/memshellparty.json https://github.com/vicrack/scoop-bucket",
        "The boot (Web) distribution requires JDK 17 or newer. Set JDK_17_HOME, JDK_19_HOME, JDK_21_HOME, JDK_25_HOME or JAVA_HOME to a compatible JDK."
    ],
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "url": "https://github.com/MemShellParty/MemShellParty/releases/download/v3.1.0/memshell-party-boot-3.1.0.jar",
    "hash": "b6ddfbf721ec3f7dc807ba54a2bc554bb0e5df2b8bb941ea9ab358df1fe1d37f",
    "pre_install": [
        "$batContent = @\"",
        "@echo off",
        "setlocal EnableDelayedExpansion",
        "set \"jdk_path=\"",
        "for %%J in (JDK_25_HOME JDK_21_HOME JDK_19_HOME JDK_17_HOME) do (",
        "    if not defined jdk_path if defined %%J if exist \"!%%J!\\bin\\java.exe\" set \"jdk_path=!%%J!\\bin\\\"",
        ")",
        "if not defined jdk_path if defined JAVA_HOME set \"jdk_path=%JAVA_HOME%\\bin\\\"",
        "if not exist \"%jdk_path%java.exe\" (",
        "    echo ERROR: JDK 17 or newer is required. Set JAVA_HOME or JDK_17_HOME.",
        "    exit /b 1",
        ")",
        "set \"java_version=\"",
        "for /f \"tokens=3\" %%V in ('call \"%jdk_path%java.exe\" -version 2^>^&1 ^| findstr /i \"version\"') do if not defined java_version set \"java_version=%%~V\"",
        "set \"java_major=\"",
        "for /f \"tokens=1,2 delims=.-+\" %%A in (\"%java_version%\") do (",
        "    set \"java_major=%%A\"",
        "    if \"%%A\"==\"1\" set \"java_major=%%B\"",
        ")",
        "echo %java_major%| findstr /r \"^[0-9][0-9]*$\" >nul",
        "if errorlevel 1 (",
        "    echo ERROR: Unable to verify Java version. JDK 17 or newer is required.",
        "    exit /b 1",
        ")",
        "if %java_major% LSS 17 (",
        "    echo ERROR: Java %java_major% is too old. JDK 17 or newer is required.",
        "    exit /b 1",
        ")",
        "pushd \"%~dp0\"",
        "\"%jdk_path%java.exe\" --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.xml/com.sun.org.apache.xalan.internal.xsltc.trax=ALL-UNNAMED --add-opens=java.xml/com.sun.org.apache.xalan.internal.xsltc.runtime=ALL-UNNAMED -jar \"memshell-party-boot-$version.jar\" %*",
        "set \"exit_code=%errorlevel%\"",
        "popd",
        "exit /b %exit_code%",
        "\"@",
        "Set-Content -Path \"$dir/memshellparty.bat\" -Value $batContent -Encoding Ascii"
    ],
    "bin": "memshellparty.bat",
    "shortcuts": [
        [
            "memshellparty.bat",
            "Memshellparty"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/MemShellParty/MemShellParty/releases?per_page=100",
        "script": [
            "if (-not $page) { Write-Warning 'MemShellParty: GitHub returned no release data.'; return }",
            "$candidates = foreach ($release in ($page | ConvertFrom-Json)) {",
            "    if ($release.draft -or $release.prerelease -or $release.tag_name -cnotmatch '^v(?<version>\\d+\\.\\d+\\.\\d+)$') { continue }",
            "    $v = $Matches.version",
            "    $asset = @($release.assets | Where-Object { $_.state -eq 'uploaded' -and $_.name -ceq \"memshell-party-boot-$v.jar\" })",
            "    if ($asset.Count -eq 1) { [PSCustomObject]@{ Version = [version]$v; Url = $asset[0].browser_download_url } }",
            "}",
            "$selected = $candidates | Sort-Object Version -Descending | Select-Object -First 1",
            "if (!$selected) { throw 'No stable MemShellParty boot JAR found in the first 100 releases.' }",
            "if ($selected.Version -lt [version]$json.version) { throw 'Refusing to downgrade MemShellParty because a newer asset is unavailable.' }",
            "$selected.Url"
        ],
        "regex": "^https://github\\.com/(?<url>MemShellParty/MemShellParty/releases/download/v(?<version>[\\d.]+)/memshell-party-boot-\\k<version>\\.jar)$",
        "replace": "${version}"
    },
    "autoupdate": {
        "url": "https://github.com/$matchUrl"
    }
}
