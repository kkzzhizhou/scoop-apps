            "hash": "9e3399b71f6a7465201035d767844345ed27676e5e5ef6572a736f8df2cceb9c"
        },
        "arm64": {
            "url": "https://github.com/libnyanpasu/clash-nyanpasu/releases/download/v2.0.0/Clash.Nyanpasu_2.0.0_arm64-setup.exe#/dl.7z",
            "hash": "a1ec21aa63f5083d0baca758f8b64c94b9cf96cfb076414662ddecd567434641"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\\moe.elaina.clash.nyanpasu\" -Target \"$env:LOCALAPPDATA\\moe.elaina.clash.nyanpasu\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\\Clash Nyanpasu\" -Target \"$env:LOCALAPPDATA\\Clash Nyanpasu\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\\Clash Nyanpasu\" -Target \"$env:APPDATA\\Clash Nyanpasu\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\moe.elaina.clash.nyanpasu\"",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Clash Nyanpasu\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Clash Nyanpasu\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "Clash Nyanpasu.exe",
            "ClashNyanpasu"
        ]
    ],
    "shortcuts": [
        [
            "Clash Nyanpasu.exe",
            "ClashNyanpasu"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/libnyanpasu/clash-nyanpasu/releases/latest",
        "jp": "$.tag_name",
        "regex": "v([\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/libnyanpasu/clash-nyanpasu/releases/download/v$version/Clash.Nyanpasu_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/libnyanpasu/clash-nyanpasu/releases/download/v$version/Clash.Nyanpasu_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
