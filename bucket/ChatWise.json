        "jsonpath": "$[0].version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://releases.chatwise.app/$version/ChatWise-$version-setup.exe#/dl.7z",
                "hash": {
                    "url": "https://releases.chatwise.app/releases",
                    "regex": "\\\"name\\\":\\\"ChatWise-$version-setup.exe\\\".*?\\\"sha512\\\":\\\"$base64"
                }
            }
        }
