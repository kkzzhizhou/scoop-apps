            "hash": "sha512:212a71449f608ec9d86bec0492f7a1a12fd81cb0a17479e10c4726f4fc166e8fd2db1eff8a8ff6bc16ca1c7087e7de3f07dfca29de8913606a4d6d7f85c8a99c",
            "installer": {
                "script": [
                    "Expand-7ZipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
