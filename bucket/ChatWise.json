            "hash": "sha512:48e8b8252c5f9da3c44e218de1db54da59564a2fb60b5d64503c472b34d70e5e616d07607d8a7ccf17b3bf058f087f67d39f160409bad08b7ab41a87b9d70ad8",
            "installer": {
