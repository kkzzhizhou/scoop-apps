{
    "version": "0.19.2.1",
    "description": "The Chromium-based web browser made for people, with love. Best privacy by default, unbiased ad-blocking, no bloat and no noise.",
    "homepage": "https://helium.computer",
    "license": "BSD-3-Clause, GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.19.2.1/helium_0.19.2.1_x64-windows.zip",
            "hash": "8623c04201a0a45a97920c7acdaa3a9f022260c66d6dfe78e7dcb323d4d2d89c",
            "extract_dir": "helium_0.19.2.1_x64-windows"
        },
        "arm64": {
            "url": "https://github.com/imputnet/helium-windows/releases/download/0.19.2.1/helium_0.19.2.1_arm64-windows.zip",
            "hash": "9ef95a8eaa3f11368acf4cfd8d26350c16e5bbfd03776ef2ec2aaf2385e87be7",
            "extract_dir": "helium_0.19.2.1_arm64-windows"
        }
    },
    "post_install": [
        "$targetPersist = \"$persist_dir\\User Data\"",
        "$cUserData = \"$env:LOCALAPPDATA\\imput\\Helium\\User Data\"",
        "function Test-PersistJunction($item, $target) {",
        "    if (-not $item) { return $false }",
        "    $linkTarget = if ($item.PSObject.Properties['LinkTarget'] -and $item.LinkTarget) { $item.LinkTarget } else { $item.Target }",
        "    if ($linkTarget -is [array]) { $linkTarget = $linkTarget[0] }",
        "    if (-not $linkTarget) { return $false }",
        "    return $linkTarget.ToString().TrimEnd('\\', '/') -ieq $target.TrimEnd('\\', '/')",
        "}",
        "function Remove-PersistTarget($path) {",
        "    $item = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue",
        "    if ($item) {",
        "        Remove-Item -LiteralPath $path -Force -Recurse -ErrorAction Stop",
        "    }",
        "}",
        "$parentDir = Split-Path -Path $cUserData -Parent",
        "if (-not (Test-Path -LiteralPath $parentDir)) { New-Item -ItemType Directory -Path $parentDir -Force -ErrorAction Stop | Out-Null }",
        "$appData = Get-Item -LiteralPath $cUserData -Force -ErrorAction SilentlyContinue",
        "$isJunction = [bool]($appData -and ($appData.Attributes -band [System.IO.FileAttributes]::ReparsePoint))",
        "if (-not ($isJunction -and (Test-PersistJunction $appData $targetPersist))) {",
        "    $persistHasData = (Test-Path -LiteralPath $targetPersist) -and (Get-ChildItem -LiteralPath $targetPersist -Force -ErrorAction SilentlyContinue | Select-Object -First 1)",
        "    if (-not $persistHasData) {",
        "        New-Item -ItemType Directory -Path (Split-Path -Path $targetPersist -Parent) -Force -ErrorAction Stop | Out-Null",
        "        Remove-PersistTarget $targetPersist",
        "        if ($appData -and -not $isJunction) {",
        "            Move-Item -LiteralPath $cUserData -Destination $targetPersist -Force -ErrorAction Stop",
        "            $appData = $null",
        "        } else {",
        "            New-Item -Path $targetPersist -ItemType Directory -Force -ErrorAction Stop | Out-Null",
        "        }",
        "    }",
        "    if ($appData -and -not $isJunction) {",
        "        $bakName = \"User Data.bak_$(Get-Date -Format 'yyyyMMddHHmmss')\"",
        "        Rename-Item -LiteralPath $cUserData -NewName $bakName -Force -ErrorAction Stop",
        "        Write-Host \"Existing Helium user data has been backed up to: $bakName\" -ForegroundColor Yellow",
        "    }",
        "    if ($isJunction) {",
        "        [System.IO.Directory]::Delete($cUserData)",
        "    }",
        "    New-Item -ItemType Junction -Path $cUserData -Target $targetPersist -ErrorAction Stop | Out-Null",
        "}"
    ],
    "bin": [
        [
            "chrome.exe",
            "helium"
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Helium"
        ]
    ],
    "persist": "User Data",
    "checkver": {
        "github": "https://github.com/imputnet/helium-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_x64-windows.zip",
                "extract_dir": "helium_$version_x64-windows"
            },
            "arm64": {
                "url": "https://github.com/imputnet/helium-windows/releases/download/$version/helium_$version_arm64-windows.zip",
                "extract_dir": "helium_$version_arm64-windows"
            }
        }
    }
}
