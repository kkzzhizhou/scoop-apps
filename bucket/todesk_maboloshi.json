{
    "version": "5.1.2.0",
    "description": "A unlimited speed multifunctional remote control software",
    "homepage": "https://www.todesk.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.todesk.com/licence.html"
    },
    "architecture": {
        "64bit": {
            "installer": {
                "script": "Expand-7ZipArchive \"$dir\\app64.7z\" \"$dir\" -Removal"
            }
        }
    },
    "url": "https://dl.todesk.com/windows/ToDesk_Setup.exe#/dl.7z",
    "hash": "97a75a1cf79a529523ddb25c7b22e7aeeaa5c120c4819025a7b74a85b74bcfcd",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.ini\")) {",
        "    New-Item -Force -Path \"$persist_dir\\config.ini\" -ItemType File -Value \"[ConfigInfo]`nautoStart=0\" | Out-Null",
        "}"
    ],
    "post_install": "Remove-Item -Path \"$dir\\`$PLUGINSDIR\",\"$dir\\app*.7z\",\"$dir\\uninst.exe\" -Force -Recurse",
    "shortcuts": [
        [
            "ToDesk.exe",
            "ToDesk"
        ]
    ],
    "persist": [
        "Logs",
        "config.ini"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    # -RunAs 在已经提权时不会再弹 UAC",
        "    Invoke-ExternalCommand -FilePath sc.exe -ArgumentList @('delete', 'ToDesk_Service') -Quiet -RunAs",
        "}"
    ],
    "checkver": {
        "url": "https://update.todesk.com/windows/uplog.html",
        "regex": "<div class=\"text\">([\\d.]+)</div>"
    },
    "autoupdate": {
        "url": "https://dl.todesk.com/windows/ToDesk_Setup.exe#/dl.7z"
    }
}
