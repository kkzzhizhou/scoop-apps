        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://api.github.com/repos/XiaoYouChR/Ghost-Downloader-3/releases'",
            "$cont = (Invoke-WebRequest $url).Content",
            "$r = 'Ghost-Downloader-v([\\d.]+)-Windows-x86_64' ",
            "if (!($cont -match $r)) { error \"Could not match $r in $url\"; continue }",
            "$version = $matches[1]",
            "$r = 'Ghost-Downloader-v([\\d.]+)-Windows-arm64' ",
            "if (!($cont -match $r)) { error \"Could not match $r in $url\"; continue }",
            "$arm64 = $matches[1]",
            "Write-Output $version $arm64"
        ],
        "regex": "([\\d.]+) (?<arm64>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$version/Ghost-Downloader-v$version-Windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$matchArm64/Ghost-Downloader-v$matchArm64-Windows-arm64.zip"
            }
        }
    }
