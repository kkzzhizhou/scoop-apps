            "hash": "1723b1ef5ff7791a77638f05b48168331df84f51c19fbec7a1321fe924f3463b"
        },
        "arm64": {
            "url": "https://github.com/PowerShell/PowerShell/releases/download/v7.7.0/PowerShell-7.7.0-win-arm64.zip",
