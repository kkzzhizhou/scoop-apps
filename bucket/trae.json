{
    "version": "2.3.99397",
    "description": "Trae IDE integrates seamlessly into your workflow, collaborating with you to maximize performance and efficiency.",
    "homepage": "https://www.trae.ai/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.trae.ai/terms-of-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/2.3.99397/win32/TRAE-Setup-x64.exe",
            "hash": "b9ab1d0c032671d3e33b7c188107a6f2333b3c760a10ceac1ad49bb5fd7b4e06"
        }
    },
    "innosetup": true,
    "extract_dir": "{code_GetDestDir}",
    "shortcuts": [
        [
            "Trae.exe",
            "Trae"
        ]
    ],
    "post_install": [
        "$homeConfig = Join-Path $persist_dir 'home\\config'",
        "$extensionsDir = Join-Path $homeConfig 'extensions'",
        "$roamingDir = Join-Path $persist_dir 'roaming'",
        "$programsDir = Join-Path $persist_dir 'programs'",
        "foreach ($path in @($homeConfig, $extensionsDir, $roamingDir, $programsDir)) { if (-not (Test-Path $path)) { New-Item -ItemType Directory -Path $path -Force | Out-Null } }",
        "$appDataPath = Join-Path $env:AppData 'Trae'",
        "if (Test-Path $appDataPath) {",
        "  $item = Get-Item $appDataPath -ErrorAction SilentlyContinue",
        "  if ($item -and -not $item.LinkType) {",
        "    Copy-Item \"$appDataPath\\*\" $roamingDir -Force -Recurse -ErrorAction SilentlyContinue",
        "    Remove-Item $appDataPath -Recurse -Force -ErrorAction SilentlyContinue",
        "  }",
        "}",
        "$localProgramsPath = Join-Path $env:LocalAppData 'Programs\\trae'",
        "if (Test-Path $localProgramsPath) {",
        "  $item = Get-Item $localProgramsPath -ErrorAction SilentlyContinue",
        "  if ($item -and -not $item.LinkType) {",
        "    Copy-Item \"$localProgramsPath\\*\" $programsDir -Force -Recurse -ErrorAction SilentlyContinue",
        "    Remove-Item $localProgramsPath -Recurse -Force -ErrorAction SilentlyContinue",
        "  }",
        "}",
        "$userProfilePath = Join-Path $env:USERPROFILE '.trae'",
        "if (Test-Path $userProfilePath) {",
        "  $item = Get-Item $userProfilePath -ErrorAction SilentlyContinue",
        "  if ($item -and -not $item.LinkType) {",
        "    Copy-Item \"$userProfilePath\\*\" $homeConfig -Force -Recurse -ErrorAction SilentlyContinue",
        "    Remove-Item $userProfilePath -Recurse -Force -ErrorAction SilentlyContinue",
        "  }",
        "}",
        "$extensionsFile = Join-Path $extensionsDir 'extensions.json'",
        "if (Test-Path $extensionsFile) {",
        "  info 'Adjusting path in extensions file...'",
        "  (Get-Content $extensionsFile) -replace '(?<=trae(/|\\\\)).*?(?=(/|\\\\)home(/|\\\\)config(/|\\\\)extensions)', $version | Set-Content $extensionsFile",
        "}",
        "#region scoop-portable-profile",
        "# Portable profile helpers for Scoop manifests.",
        "# 说明：构建阶段会把该文件的内容内联进 post_install/pre_uninstall。",
        "function Resolve-PortablePath {",
        "    param(",
        "        [string]$Path,",
        "        [hashtable]$Context",
        "    )",
        "    if ($Path -match '^AppData/(.+)$') {",
        "        return (Join-Path $env:AppData $matches[1])",
        "    }",
        "    elseif ($Path -match '^LocalAppData/(.+)$') {",
        "        return (Join-Path $env:LocalAppData $matches[1])",
        "    }",
        "    elseif ($Path -match '^ProgramData/(.+)$') {",
        "        return (Join-Path $env:ProgramData $matches[1])",
        "    }",
        "    elseif ($Path -match '^UserProfile/(.+)$') {",
        "        return (Join-Path $env:USERPROFILE $matches[1])",
        "    }",
        "    elseif ($Path -match '^\\$dir(?<rest>[/\\\\].*)?$') {",
        "        $suffix = $matches['rest']",
        "        if ($suffix) {",
        "            $suffix = ($suffix -replace '^[/\\\\]+', '')",
        "            $suffix = $suffix.Replace('/', '\\\\')",
        "        }",
        "        return (Join-Path $Context.Dir $suffix)",
        "    }",
        "    elseif ($Path -match '^\\$persist_dir(?<rest>[/\\\\].*)?$') {",
        "        $suffix = $matches['rest']",
        "        if ($suffix) {",
        "            $suffix = ($suffix -replace '^[/\\\\]+', '')",
        "            $suffix = $suffix.Replace('/', '\\\\')",
        "        }",
        "        return (Join-Path $Context.PersistDir $suffix)",
        "    }",
        "    else {",
        "        return ($ExecutionContext.InvokeCommand.ExpandString($Path))",
        "    }",
        "}",
        "function Ensure-PortableDirectory {",
        "    param([string]$Path)",
        "    if (-not (Test-Path $Path)) {",
        "        New-Item -ItemType Directory -Path $Path -Force | Out-Null",
        "    }",
        "}",
        "function Ensure-PortableFile {",
        "    param([string]$Path)",
        "    $parent = Split-Path -Parent $Path",
        "    if ($parent) { Ensure-PortableDirectory $parent }",
        "    if (-not (Test-Path $Path)) {",
        "        New-Item -ItemType File -Path $Path -Force | Out-Null",
        "    }",
        "}",
        "function Copy-PortableData {",
        "    param(",
        "        [string]$Source,",
        "        [string]$Destination",
        "    )",
        "    if (Test-Path $Source) {",
        "        Ensure-PortableDirectory $Destination",
        "        Copy-Item \"$Source\\*\" $Destination -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "# CreateSymbolicLinkW with SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE (0x2) works without elevation",
        "# when Developer Mode is on; PowerShell 5.1 New-Item -ItemType SymbolicLink does not pass that flag.",
        "function New-PortableNativeSymlink {",
        "    param(",
        "        [string]$Link,",
        "        [string]$Target,",
        "        [switch]$Directory",
        "    )",
        "    if (-not ('ScoopPortable.NativeLink' -as [type])) {",
        "        Add-Type -Namespace ScoopPortable -Name NativeLink -MemberDefinition '[DllImport(\"kernel32.dll\", SetLastError = true, CharSet = CharSet.Unicode)] public static extern byte CreateSymbolicLinkW(string lpSymlinkFileName, string lpTargetFileName, int dwFlags);'",
        "    }",
        "    $flags = if ($Directory) { 0x3 } else { 0x2 }",
        "    [void][ScoopPortable.NativeLink]::CreateSymbolicLinkW($Link, $Target, $flags)",
        "}",
        "function Get-PortableLinkItem {",
        "    param([string]$Path)",
        "    # -Force also returns broken links, which Test-Path may not report.",
        "    $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue",
        "    if ($item -and $item.LinkType) { return $item }",
        "    return $null",
        "}",
        "function Remove-PortableLinkItem {",
        "    param([System.IO.FileSystemInfo]$Item)",
        "    # Deletes only the reparse point, never the target's contents.",
        "    if ($Item.Attributes -band [System.IO.FileAttributes]::Directory) {",
        "        [System.IO.Directory]::Delete($Item.FullName)",
        "    }",
        "    else {",
        "        [System.IO.File]::Delete($Item.FullName)",
        "    }",
        "}",
        "function Test-PortableSymlinkTarget {",
        "    param(",
        "        [string]$Link,",
        "        [string]$Target",
        "    )",
        "    $item = Get-PortableLinkItem $Link",
        "    if (-not $item -or $item.LinkType -ne 'SymbolicLink') { return $false }",
        "    $actual = @($item.Target)[0]",
        "    if (-not $actual) { return $false }",
        "    $actualFull = [System.IO.Path]::GetFullPath($actual).TrimEnd('\\')",
        "    $expectedFull = [System.IO.Path]::GetFullPath($Target).TrimEnd('\\')",
        "    return [string]::Equals($actualFull, $expectedFull, [System.StringComparison]::OrdinalIgnoreCase)",
        "}",
        "function Test-PortableSymlinkCapability {",
        "    $probe = Join-Path ([System.IO.Path]::GetTempPath()) (\"scoop-portable-probe-\" + [guid]::NewGuid().ToString('N'))",
        "    $targetDir = Join-Path $probe 'target-dir'",
        "    $targetFile = Join-Path $probe 'target-file'",
        "    $linkDir = Join-Path $probe 'link-dir'",
        "    $linkFile = Join-Path $probe 'link-file'",
        "    try {",
        "        New-Item -ItemType Directory -Path $targetDir -Force | Out-Null",
        "        New-Item -ItemType File -Path $targetFile -Force | Out-Null",
        "        New-PortableNativeSymlink -Link $linkDir -Target $targetDir -Directory",
        "        New-PortableNativeSymlink -Link $linkFile -Target $targetFile",
        "        # The API return value is not trusted; only an existing SymbolicLink counts.",
        "        return ((Test-PortableSymlinkTarget $linkDir $targetDir) -and (Test-PortableSymlinkTarget $linkFile $targetFile))",
        "    }",
        "    catch {",
        "        return $false",
        "    }",
        "    finally {",
        "        foreach ($link in @($linkDir, $linkFile)) {",
        "            $item = Get-PortableLinkItem $link",
        "            if ($item) { Remove-PortableLinkItem $item }",
        "        }",
        "        Remove-Item -LiteralPath $probe -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "function New-PortableSymlink {",
        "    param(",
        "        [string]$Link,",
        "        [string]$Target",
        "    )",
        "    if (Test-PortableSymlinkTarget $Link $Target) {",
        "        return",
        "    }",
        "    $existing = Get-PortableLinkItem $Link",
        "    if ($existing) {",
        "        Remove-PortableLinkItem $existing",
        "    }",
        "    elseif (Test-Path -LiteralPath $Link) {",
        "        throw \"[Portable Mode] $Link exists and is not a link; refusing to replace it.\"",
        "    }",
        "    $parent = Split-Path -Parent $Link",
        "    if ($parent) { Ensure-PortableDirectory $parent }",
        "    $isDirectory = Test-Path -LiteralPath $Target -PathType Container",
        "    New-PortableNativeSymlink -Link $Link -Target $Target -Directory:$isDirectory",
        "    if (-not (Test-PortableSymlinkTarget $Link $Target)) {",
        "        # Secondary fallback; may still fail without the symlink privilege.",
        "        New-Item -ItemType SymbolicLink -Path $Link -Target $Target -Force -ErrorAction SilentlyContinue | Out-Null",
        "    }",
        "    if (-not (Test-PortableSymlinkTarget $Link $Target)) {",
        "        throw \"[Portable Mode] Failed to create SymbolicLink $Link -> $Target\"",
        "    }",
        "}",
        "function Remove-PortableLink {",
        "    param(",
        "        [string]$Link,",
        "        [switch]$Log",
        "    )",
        "    $item = Get-PortableLinkItem $Link",
        "    if ($item) {",
        "        Remove-PortableLinkItem $item",
        "        if ($Log) {",
        "            info \"[Portable Mode] Removed symbolic link: $Link\"",
        "        }",
        "    }",
        "}",
        "function Invoke-PortableMappings {",
        "    param(",
        "        [ValidateSet('Install', 'Uninstall')] [string]$Action,",
        "        [hashtable]$Context,",
        "        [array]$Mappings,",
        "        [switch]$Log",
        "    )",
        "    # Check before touching any link: a failed relink after unlink is what breaks persist.",
        "    if (@($Mappings | Where-Object { $_.Strategy -eq 'symlink' }).Count -gt 0) {",
        "        if (-not (Test-PortableSymlinkCapability)) {",
        "            throw \"[Portable Mode] This session cannot create SymbolicLinks (enable Developer Mode or run elevated); $Action aborted, no links were changed.\"",
        "        }",
        "    }",
        "    foreach ($mapping in $Mappings) {",
        "        $sourcePath = Resolve-PortablePath -Path $mapping.Source -Context $Context",
        "        $targetPath = Resolve-PortablePath -Path $mapping.Target -Context $Context",
        "        $targetType = if ($mapping.TargetType) { $mapping.TargetType } else { 'directory' }",
        "        if ($Action -eq 'Install') {",
        "            if ($mapping.EnsureTarget) {",
        "                if ($targetType -eq 'file') {",
        "                    Ensure-PortableFile $targetPath",
        "                }",
        "                else {",
        "                    Ensure-PortableDirectory $targetPath",
        "                }",
        "            }",
        "            if ($targetType -ne 'file') {",
        "                if ((Test-Path $sourcePath) -and -not (Get-Item $sourcePath -ErrorAction SilentlyContinue).LinkType) {",
        "                    Copy-PortableData -Source $sourcePath -Destination $targetPath",
        "                    Remove-Item $sourcePath -Recurse -Force -ErrorAction SilentlyContinue",
        "                }",
        "            }",
        "            elseif ((Test-Path $sourcePath) -and -not (Get-Item $sourcePath -ErrorAction SilentlyContinue).LinkType) {",
        "                Remove-Item $sourcePath -Recurse -Force -ErrorAction SilentlyContinue",
        "            }",
        "            switch ($mapping.Strategy) {",
        "                'symlink' { New-PortableSymlink -Link $sourcePath -Target $targetPath }",
        "                Default { Copy-PortableData -Source $sourcePath -Destination $targetPath }",
        "            }",
        "            if ($Log) {",
        "                info \"[Portable Mode] Linked $($mapping.Label) -> $targetPath\"",
        "            }",
        "        }",
        "        else {",
        "            Remove-PortableLink -Link $sourcePath -Log:$Log",
        "        }",
        "    }",
        "}",
        "#endregion",
        "Invoke-PortableMappings -Action Install -Context @{ Dir = $dir; PersistDir = $persist_dir } -Mappings @(",
        "    @{ Label = 'home-config'; Source = 'UserProfile/.trae'; Target = \"$persist_dir/home/config\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' },",
        "    @{ Label = 'roaming'; Source = 'AppData/Trae'; Target = \"$persist_dir/roaming\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' },",
        "    @{ Label = 'programs'; Source = 'LocalAppData/Programs/trae'; Target = \"$persist_dir/programs\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' }",
        ") -Log:$true"
    ],
    "persist": "data",
    "checkver": {
        "url": "https://api.trae.ai/icube/api/v1/native/version/trae/latest",
        "jsonpath": "$.data.manifest.win32.download[0].x64",
        "regex": "(?<url>.*stable/(?<version>[\\d.]+)/win32.*.exe)",
        "replace": "${version}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl"
            }
        }
    },
    "pre_uninstall": [
        "#region scoop-portable-profile",
        "# Portable profile helpers for Scoop manifests.",
        "# 说明：构建阶段会把该文件的内容内联进 post_install/pre_uninstall。",
        "function Resolve-PortablePath {",
        "    param(",
        "        [string]$Path,",
        "        [hashtable]$Context",
        "    )",
        "    if ($Path -match '^AppData/(.+)$') {",
        "        return (Join-Path $env:AppData $matches[1])",
        "    }",
        "    elseif ($Path -match '^LocalAppData/(.+)$') {",
        "        return (Join-Path $env:LocalAppData $matches[1])",
        "    }",
        "    elseif ($Path -match '^ProgramData/(.+)$') {",
        "        return (Join-Path $env:ProgramData $matches[1])",
        "    }",
        "    elseif ($Path -match '^UserProfile/(.+)$') {",
        "        return (Join-Path $env:USERPROFILE $matches[1])",
        "    }",
        "    elseif ($Path -match '^\\$dir(?<rest>[/\\\\].*)?$') {",
        "        $suffix = $matches['rest']",
        "        if ($suffix) {",
        "            $suffix = ($suffix -replace '^[/\\\\]+', '')",
        "            $suffix = $suffix.Replace('/', '\\\\')",
        "        }",
        "        return (Join-Path $Context.Dir $suffix)",
        "    }",
        "    elseif ($Path -match '^\\$persist_dir(?<rest>[/\\\\].*)?$') {",
        "        $suffix = $matches['rest']",
        "        if ($suffix) {",
        "            $suffix = ($suffix -replace '^[/\\\\]+', '')",
        "            $suffix = $suffix.Replace('/', '\\\\')",
        "        }",
        "        return (Join-Path $Context.PersistDir $suffix)",
        "    }",
        "    else {",
        "        return ($ExecutionContext.InvokeCommand.ExpandString($Path))",
        "    }",
        "}",
        "function Ensure-PortableDirectory {",
        "    param([string]$Path)",
        "    if (-not (Test-Path $Path)) {",
        "        New-Item -ItemType Directory -Path $Path -Force | Out-Null",
        "    }",
        "}",
        "function Ensure-PortableFile {",
        "    param([string]$Path)",
        "    $parent = Split-Path -Parent $Path",
        "    if ($parent) { Ensure-PortableDirectory $parent }",
        "    if (-not (Test-Path $Path)) {",
        "        New-Item -ItemType File -Path $Path -Force | Out-Null",
        "    }",
        "}",
        "function Copy-PortableData {",
        "    param(",
        "        [string]$Source,",
        "        [string]$Destination",
        "    )",
        "    if (Test-Path $Source) {",
        "        Ensure-PortableDirectory $Destination",
        "        Copy-Item \"$Source\\*\" $Destination -Force -Recurse -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "# CreateSymbolicLinkW with SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE (0x2) works without elevation",
        "# when Developer Mode is on; PowerShell 5.1 New-Item -ItemType SymbolicLink does not pass that flag.",
        "function New-PortableNativeSymlink {",
        "    param(",
        "        [string]$Link,",
        "        [string]$Target,",
        "        [switch]$Directory",
        "    )",
        "    if (-not ('ScoopPortable.NativeLink' -as [type])) {",
        "        Add-Type -Namespace ScoopPortable -Name NativeLink -MemberDefinition '[DllImport(\"kernel32.dll\", SetLastError = true, CharSet = CharSet.Unicode)] public static extern byte CreateSymbolicLinkW(string lpSymlinkFileName, string lpTargetFileName, int dwFlags);'",
        "    }",
        "    $flags = if ($Directory) { 0x3 } else { 0x2 }",
        "    [void][ScoopPortable.NativeLink]::CreateSymbolicLinkW($Link, $Target, $flags)",
        "}",
        "function Get-PortableLinkItem {",
        "    param([string]$Path)",
        "    # -Force also returns broken links, which Test-Path may not report.",
        "    $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue",
        "    if ($item -and $item.LinkType) { return $item }",
        "    return $null",
        "}",
        "function Remove-PortableLinkItem {",
        "    param([System.IO.FileSystemInfo]$Item)",
        "    # Deletes only the reparse point, never the target's contents.",
        "    if ($Item.Attributes -band [System.IO.FileAttributes]::Directory) {",
        "        [System.IO.Directory]::Delete($Item.FullName)",
        "    }",
        "    else {",
        "        [System.IO.File]::Delete($Item.FullName)",
        "    }",
        "}",
        "function Test-PortableSymlinkTarget {",
        "    param(",
        "        [string]$Link,",
        "        [string]$Target",
        "    )",
        "    $item = Get-PortableLinkItem $Link",
        "    if (-not $item -or $item.LinkType -ne 'SymbolicLink') { return $false }",
        "    $actual = @($item.Target)[0]",
        "    if (-not $actual) { return $false }",
        "    $actualFull = [System.IO.Path]::GetFullPath($actual).TrimEnd('\\')",
        "    $expectedFull = [System.IO.Path]::GetFullPath($Target).TrimEnd('\\')",
        "    return [string]::Equals($actualFull, $expectedFull, [System.StringComparison]::OrdinalIgnoreCase)",
        "}",
        "function Test-PortableSymlinkCapability {",
        "    $probe = Join-Path ([System.IO.Path]::GetTempPath()) (\"scoop-portable-probe-\" + [guid]::NewGuid().ToString('N'))",
        "    $targetDir = Join-Path $probe 'target-dir'",
        "    $targetFile = Join-Path $probe 'target-file'",
        "    $linkDir = Join-Path $probe 'link-dir'",
        "    $linkFile = Join-Path $probe 'link-file'",
        "    try {",
        "        New-Item -ItemType Directory -Path $targetDir -Force | Out-Null",
        "        New-Item -ItemType File -Path $targetFile -Force | Out-Null",
        "        New-PortableNativeSymlink -Link $linkDir -Target $targetDir -Directory",
        "        New-PortableNativeSymlink -Link $linkFile -Target $targetFile",
        "        # The API return value is not trusted; only an existing SymbolicLink counts.",
        "        return ((Test-PortableSymlinkTarget $linkDir $targetDir) -and (Test-PortableSymlinkTarget $linkFile $targetFile))",
        "    }",
        "    catch {",
        "        return $false",
        "    }",
        "    finally {",
        "        foreach ($link in @($linkDir, $linkFile)) {",
        "            $item = Get-PortableLinkItem $link",
        "            if ($item) { Remove-PortableLinkItem $item }",
        "        }",
        "        Remove-Item -LiteralPath $probe -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "function New-PortableSymlink {",
        "    param(",
        "        [string]$Link,",
        "        [string]$Target",
        "    )",
        "    if (Test-PortableSymlinkTarget $Link $Target) {",
        "        return",
        "    }",
        "    $existing = Get-PortableLinkItem $Link",
        "    if ($existing) {",
        "        Remove-PortableLinkItem $existing",
        "    }",
        "    elseif (Test-Path -LiteralPath $Link) {",
        "        throw \"[Portable Mode] $Link exists and is not a link; refusing to replace it.\"",
        "    }",
        "    $parent = Split-Path -Parent $Link",
        "    if ($parent) { Ensure-PortableDirectory $parent }",
        "    $isDirectory = Test-Path -LiteralPath $Target -PathType Container",
        "    New-PortableNativeSymlink -Link $Link -Target $Target -Directory:$isDirectory",
        "    if (-not (Test-PortableSymlinkTarget $Link $Target)) {",
        "        # Secondary fallback; may still fail without the symlink privilege.",
        "        New-Item -ItemType SymbolicLink -Path $Link -Target $Target -Force -ErrorAction SilentlyContinue | Out-Null",
        "    }",
        "    if (-not (Test-PortableSymlinkTarget $Link $Target)) {",
        "        throw \"[Portable Mode] Failed to create SymbolicLink $Link -> $Target\"",
        "    }",
        "}",
        "function Remove-PortableLink {",
        "    param(",
        "        [string]$Link,",
        "        [switch]$Log",
        "    )",
        "    $item = Get-PortableLinkItem $Link",
        "    if ($item) {",
        "        Remove-PortableLinkItem $item",
        "        if ($Log) {",
        "            info \"[Portable Mode] Removed symbolic link: $Link\"",
        "        }",
        "    }",
        "}",
        "function Invoke-PortableMappings {",
        "    param(",
        "        [ValidateSet('Install', 'Uninstall')] [string]$Action,",
        "        [hashtable]$Context,",
        "        [array]$Mappings,",
        "        [switch]$Log",
        "    )",
        "    # Check before touching any link: a failed relink after unlink is what breaks persist.",
        "    if (@($Mappings | Where-Object { $_.Strategy -eq 'symlink' }).Count -gt 0) {",
        "        if (-not (Test-PortableSymlinkCapability)) {",
        "            throw \"[Portable Mode] This session cannot create SymbolicLinks (enable Developer Mode or run elevated); $Action aborted, no links were changed.\"",
        "        }",
        "    }",
        "    foreach ($mapping in $Mappings) {",
        "        $sourcePath = Resolve-PortablePath -Path $mapping.Source -Context $Context",
        "        $targetPath = Resolve-PortablePath -Path $mapping.Target -Context $Context",
        "        $targetType = if ($mapping.TargetType) { $mapping.TargetType } else { 'directory' }",
        "        if ($Action -eq 'Install') {",
        "            if ($mapping.EnsureTarget) {",
        "                if ($targetType -eq 'file') {",
        "                    Ensure-PortableFile $targetPath",
        "                }",
        "                else {",
        "                    Ensure-PortableDirectory $targetPath",
        "                }",
        "            }",
        "            if ($targetType -ne 'file') {",
        "                if ((Test-Path $sourcePath) -and -not (Get-Item $sourcePath -ErrorAction SilentlyContinue).LinkType) {",
        "                    Copy-PortableData -Source $sourcePath -Destination $targetPath",
        "                    Remove-Item $sourcePath -Recurse -Force -ErrorAction SilentlyContinue",
        "                }",
        "            }",
        "            elseif ((Test-Path $sourcePath) -and -not (Get-Item $sourcePath -ErrorAction SilentlyContinue).LinkType) {",
        "                Remove-Item $sourcePath -Recurse -Force -ErrorAction SilentlyContinue",
        "            }",
        "            switch ($mapping.Strategy) {",
        "                'symlink' { New-PortableSymlink -Link $sourcePath -Target $targetPath }",
        "                Default { Copy-PortableData -Source $sourcePath -Destination $targetPath }",
        "            }",
        "            if ($Log) {",
        "                info \"[Portable Mode] Linked $($mapping.Label) -> $targetPath\"",
        "            }",
        "        }",
        "        else {",
        "            Remove-PortableLink -Link $sourcePath -Log:$Log",
        "        }",
        "    }",
        "}",
        "#endregion",
        "Invoke-PortableMappings -Action Uninstall -Context @{ Dir = $dir; PersistDir = $persist_dir } -Mappings @(",
        "    @{ Label = 'home-config'; Source = 'UserProfile/.trae'; Target = \"$persist_dir/home/config\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' },",
        "    @{ Label = 'roaming'; Source = 'AppData/Trae'; Target = \"$persist_dir/roaming\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' },",
        "    @{ Label = 'programs'; Source = 'LocalAppData/Programs/trae'; Target = \"$persist_dir/programs\"; Strategy = 'symlink'; EnsureTarget = $true; TargetType = 'directory' }",
        ") -Log:$true"
    ]
}
