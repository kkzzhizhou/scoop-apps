{
    "homepage": "https://www.centbrowser.com/",
    "description": "The Most Feature Rich Chromium",
    "version": "5.3.1184.2",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://static.centbrowser.cn/win_beta/5.3.1184.2/centbrowser_5.3.1184.2_x64.exe#/dl.7z",
            "hash": "1e87533dd3e06e0da0c342ce84a26192a744257f3c27899c5ddb79363c98d7c2"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\chrome.7z\" \"$dir\"",
            "Move-Item \"$dir\\Chrome-bin\\*\" \"$dir\""
        ]
    },
    "post_install": "Remove-Item \"$dir\\chrome.7z\",\"$dir\\Chrome-bin\" -Recurse -Force",
    "shortcuts": [
        [
            "chrome.exe",
            "Cent Browser"
        ]
    ],
    "persist": "User Data",
    "checkver": {
        "url": "https://www.centbrowser.com/history.html",
        "re": "<p id=\"[\\d.]+\">v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.centbrowser.cn/win_beta/$version/centbrowser_$version_x64.exe#/dl.7z"
            }
        }
    }
}
