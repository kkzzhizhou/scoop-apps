{
    "version": "0.10.17",
    "description": "Nemorous - Multi-repository Git collaboration and code browsing desktop tool",
    "homepage": "https://github.com/iwangjie/Nemorous",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/iwangjie/Nemorous/releases/download/v0.10.17/nemorous-0.10.17-windows-amd64.tar.gz",
            "hash": "62ca0730c3d2f182bc14e9bde0435ee175df17e5e1fa570073ae810198cc1273"
        },
        "arm64": {
            "url": "https://github.com/iwangjie/Nemorous/releases/download/v0.10.17/nemorous-0.10.17-windows-arm64.tar.gz",
            "hash": "79d5ba2ec021e934313f75fb9901d60c17c61db119db34d87466d34201b7658e"
        }
    },
    "bin": "Nemorous.exe",
    "shortcuts": [
        [
            "Nemorous.exe",
            "Nemorous"
        ]
    ],
    "notes": [
        "Config is stored in %APPDATA%\\nemorous\\config.json. Set NEMOROUS_CONFIG to use another config file path.",
        "Nemorous has a built-in signed auto-updater. Disable 'auto_update' in Settings if you prefer to update through Scoop."
    ],
    "env_set": {
        "NEMOROUS_CONFIG": "$persist_dir\\nemorous\\config.json",
        "NEMOROUS_WORKSPACE": "$dir"
    },
    "persist": [
        "nemorous"
    ],
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\nemorous\")) { New-Item -ItemType Directory -Path \"$persist_dir\\nemorous\" | Out-Null }"
    ],
    "checkver": {
        "github": "https://github.com/iwangjie/Nemorous"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iwangjie/Nemorous/releases/download/v$version/nemorous-$version-windows-amd64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/iwangjie/Nemorous/releases/download/v$version/nemorous-$version-windows-arm64.tar.gz"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "find": "$basename"
        }
    }
}
