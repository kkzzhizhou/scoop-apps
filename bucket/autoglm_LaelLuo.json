{
    "version": "1.11.6",
    "description": "智谱 AI 输入法，支持全局语音输入和中英混输。",
    "homepage": "https://autoglm.zhipuai.cn/autotyper/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://autoglm.aminer.cn/autotyper/updates/AutoGLM_1.11.6_260911_2005.exe#/installer.exe",
            "hash": "0649787018f8aa933787216b95d948205fcfefa2d561b836feb0e7da04217c45"
        }
    },
    "installer": {
        "script": [
            "$tmpDir = Join-Path $dir '_tmp'",
            "Expand-7zipArchive \"$dir\\installer.exe\" $tmpDir -Removal",
            "$pluginDir = Join-Path $tmpDir '$PLUGINSDIR'",
            "$appArchive = Join-Path $pluginDir 'app-64.7z'",
            "if (-not (Test-Path $appArchive)) { throw 'AutoGLM app archive not found in installer.' }",
            "Expand-7zipArchive $appArchive \"$dir\\app\" -Removal",
            "Remove-Item $tmpDir -Recurse -Force"
        ]
    },
    "shortcuts": [
        [
            "app\\AutoGLM.exe",
            "智谱AI输入法"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/AutoGLM",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "updater",
                "source": "LocalAppData/autoglm-updater",
                "target": "$persist_dir/local/autoglm-updater",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "checkver": {
        "script": [
            "$edge = Get-Item 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe', 'C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe' -ErrorAction SilentlyContinue | Select-Object -First 1",
            "$dom = ''",
            "if ($edge) {",
            "  $profile = Join-Path $env:TEMP ('autoglm-checkver-' + [guid]::NewGuid().ToString('N'))",
            "  $dom = & $edge.FullName --headless=new --disable-gpu --no-first-run \"--user-data-dir=$profile\" '--user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36' --virtual-time-budget=8000 --dump-dom 'https://autoglm.zhipuai.cn/autotyper/' 2>$null | Out-String",
            "  Remove-Item $profile -Recurse -Force -ErrorAction SilentlyContinue",
            "}",
            "if ($dom -match 'https://autoglm\\.aminer\\.cn/autotyper/updates/AutoGLM_(?:win32_x64_)?(?<version>[0-9.]+)(?:_[^\"''`\\s]+)?\\.exe') {",
            "  $matches[0]",
            "} else {",
            "  ''",
            "}"
        ],
        "regex": "(?<url>https://autoglm\\.aminer\\.cn/autotyper/updates/AutoGLM_(?:win32_x64_)?(?<version>[0-9.]+)(?:_[^\"''`\\s]+)?\\.exe)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl#/installer.exe"
            }
        }
    }
}
