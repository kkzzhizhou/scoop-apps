{
    "version": "26.11.02",
    "description": "A real WinUI desktop cleaner with terminal control and multi-database support",
    "homepage": "https://github.com/builtbybel/FluentCleaner",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/builtbybel/FluentCleaner#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/builtbybel/FluentCleaner/releases/download/26.11.02/FluentCleaner-win-x64.zip",
            "hash": "392a8838c56954952894cea6394bb0e130dfbb483e418d8b68c7aff58452dad5"
        }
    },
    "extract_dir": "FluentCleaner-win-x64",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\FluentCleaner\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\FluentCleaner\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "FCleaner.exe",
    "shortcuts": [
        [
            "FCleaner.exe",
            "FCleaner"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/builtbybel/FluentCleaner/releases",
        "jp": "$[*].assets[*].browser_download_url",
        "regex": "releases/download/([\\d.]+)/FluentCleaner-win"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/builtbybel/FluentCleaner/releases/download/$version/FluentCleaner-win-x64.zip"
            }
        }
    }
}
