{
    "version": "1.6.19",
    "description": "Bilibili Downloader. 一个命令行式哔哩哔哩下载器.",
    "homepage": "https://github.com/aliveranme/BBDown",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aliveranme/BBDown/releases/download/v1.6.19/BBDown_v1.6.19_win-x64.zip",
            "hash": "d3b628b3a40b1a13cbbc092c60e137724d5b5f9394cb6744b9cca640fc488a43"
        }
    },
    "bin": "BBDown.exe",
    "pre_install": [
        "New-Item -ItemType File -Path \"$dir\\BBDown.data\" -Force | Out-Null",
        "New-Item -ItemType File -Path \"$dir\\BBDownSubscriptions.json\" -Force | Out-Null",
        "New-Item -ItemType File -Path \"$dir\\BBDownSubscriptions.history.json\" -Force | Out-Null",
        "New-Item -ItemType File -Path \"$dir\\BBDown.archives\" -Force | Out-Null"
    ],
    "persist": [
        "BBDown.data",
        "BBDownSubscriptions.json",
        "BBDownSubscriptions.history.json",
        "BBDown.archives"
    ],
    "checkver": {
        "github": "https://github.com/aliveranme/BBDown"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aliveranme/BBDown/releases/download/v$version/BBDown_v$version_win-x64.zip",
                "hash": {
                    "mode": "extract",
                    "url": "https://github.com/aliveranme/BBDown/releases/expanded_assets/v$version",
                    "regex": "BBDown_v$version_win-x64\\.zip.*?sha256:$sha256"
                }
            }
        }
    }
}
