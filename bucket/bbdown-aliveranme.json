    "architecture": {
        "64bit": {
            "url": "https://github.com/aliveranme/BBDown/releases/download/v1.6.11/BBDown_v1.6.11_win-x64.zip",
            "hash": "1f8a9d3b000ce653dd8a6cf31bd7e676ed7e99d6c2a1af58c8fe7e79fde287f4"
        }
    },
    "bin": "BBDown.exe",
    "pre_install": [
