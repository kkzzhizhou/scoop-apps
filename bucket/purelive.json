{
    "version": "2.0.24.35",
    "description": "一款开源的第三方多平台直播聚合播放器",
    "homepage": "https://github.com/liuchuancong/pure_live",
    "license": {
        "identifier": "AGPL-3.0 license",
        "url": "https://github.com/liuchuancong/pure_live#AGPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/liuchuancong/pure_live/releases/download/v2.0.24/PureLive-2.0.24+35-windows-x64-setup.exe",
            "hash": "47b1d1455d548f300b0eb19a3b071870fc010aaad7eb7ad75b9f26178fb638b9"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\com.mystyle\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.mystyle\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "pure_live.exe",
            "PureLive"
        ]
    ],
    "shortcuts": [
        [
            "pure_live.exe",
            "PureLive"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/liuchuancong/pure_live/releases",
        "jp": "$[0].assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+)/PureLive-([\\d.]+)%2B([\\d]+)-windows",
        "replace": "${1}.${3}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/liuchuancong/pure_live/releases/download/v$match1/PureLive-$match2+$match3-windows-x64-setup.exe"
            }
        }
    }
}
