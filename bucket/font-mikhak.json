{
    "version": "3.4",
    "license": "SIL OFL 1.1",
    "homepage": "https://github.com/aminabedi68/Mikhak/",
    "url": "https://github.com/aminabedi68/Mikhak/releases/download/3.4/Mikhak-v3.4.zip",
    "hash": "1dbbf1cfe8a1752a26196ca3a42067085d03499a9d2d9fb4f34383b375f7a4f4",
    "pre_install": [
        "Move-Item $dir\\Mikhak-v$version\\ttf\\* $dir",
        "Remove-Item $dir\\Mikhak-v$version, $dir\\Mikhak-DS*, $dir\\FD -Force -Recurse"
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\naderi\\scripts\\font.ps1\"",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Install-ScoopFonts -SourceDirectory $dir -FontDirectory $fontInstallDir -RegistryKey $registryKey -Global $global",
            "Update-ScoopFontCache"
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\naderi\\scripts\\font.ps1\"",
            "Uninstall-ScoopFonts -SourceDirectory $dir",
            "Update-ScoopFontCache",
            "Write-Host \"The '$app' font family has been uninstalled.\" -ForegroundColor Magenta"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/aminabedi68/Mikhak/releases/download/$version/Mikhak-v$version.zip"
    }
}
