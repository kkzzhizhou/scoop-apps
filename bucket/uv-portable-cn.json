{
    "version": "0.12.5",
    "description": "An extremely fast Python package installer and resolver, written in Rust.",
    "homepage": "https://github.com/astral-sh/uv",
    "license": "Apache-2.0|MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.5/uv-x86_64-pc-windows-msvc.zip",
            "hash": "4c4d49d8738847d9b71ba319e49a5688c93eac0fe6204b1df24e98528dddf39a"
        },
        "32bit": {
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.5/uv-i686-pc-windows-msvc.zip",
            "hash": "a5993a7c2e75b418e60d5ed733204222330085b14e85269545b084c273c1629b"
        }
    },
    "bin": [
        "uv.exe",
        "uvx.exe"
    ],
    "persist": "data",
    "env_set": {
        "UV_INDEX_URL": "https://mirrors.ustc.edu.cn/pypi/simple",
        "UV_CACHE_DIR": "$dir\\data\\cache",
        "UV_TOOL_DIR": "$dir\\data\\tool",
        "UV_TOOL_BIN_DIR": "$dir\\data\\bin",
        "UV_PYTHON_INSTALL_DIR": "$dir\\data\\python"
    },
    "env_add_path": "data\\bin",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-x86_64-pc-windows-msvc.zip"
            },
            "32bit": {
                "url": "https://github.com/astral-sh/uv/releases/download/$version/uv-i686-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
