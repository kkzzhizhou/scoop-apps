    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Miaoyww/NonsPlayer/releases/download/v1.8.2/Nons_1.8.2_windows_x64_portable.zip",
            "hash": "29359fe7bf0a340ee66cd46af90f3d49768719044c4561a29cda2d5f0f9e60bf",
            "extract_dir": "Nons_1.8.2_windows_x64_portable"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\Nons\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\Nons\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Nons\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\Nons\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "Nons.exe",
            "NonsPlayer"
        ]
    ],
    "shortcuts": [
        [
            "Nons.exe",
            "NonsPlayer"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Miaoyww/NonsPlayer/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Miaoyww/NonsPlayer/releases/download/v$version/Nons_$version_windows_x64_portable.zip",
                "extract_dir": "Nons_$version_windows_x64_portable"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
