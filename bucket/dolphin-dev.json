{
    "version": "2606-306",
    "description": "A Nintendo GameCube and Wii emulator",
    "homepage": "https://dolphin-emu.org/",
    "license": {
        "identifier": "GPL-2.0-or-later",
        "url": "https://github.com/dolphin-emu/dolphin/blob/master/COPYING"
    },
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://dl.dolphin-emu.org/builds/35/cb/dolphin-master-2606-306-x64.7z",
            "hash": "9a398b120c30d865a21fa8b5e115f81bd762ddea65145a6a89e0a3887b9a886c",
            "extract_dir": "Dolphin-x64"
        },
        "arm64": {
            "url": "https://dl.dolphin-emu.org/builds/28/bb/dolphin-master-2606-306-arm64.7z",
            "hash": "026e607a32d2d03286540711b8327feb087cccbb970fce42511267d673802dc5",
            "extract_dir": "Dolphin-ARM64"
        }
    },
    "pre_install": [
        "$appdataPath = \"$Env:AppData\\Dolphin Emulator\"",
        "if ((Test-Path -Path $appdataPath\\*) -and (!(Test-Path -Path $persist_dir\\*))) {",
        "   Write-Warning \"Migrating AppData...\"",
        "   New-Item -Type Directory -Path $persist_dir\\User -Force | Out-Null",
        "   Copy-Item -Recurse -Force $appdataPath\\* -Destination $persist_dir\\User\\",
        "}"
    ],
    "post_install": "Set-Content -Value $null -Path \"$dir\\portable.txt\"",
    "bin": [
        [
            "Dolphin.exe",
            "dolphin-dev"
        ],
        [
            "DolphinTool.exe",
            "dolphintool-dev"
        ]
    ],
    "shortcuts": [
        [
            "Dolphin.exe",
            "Nintendo GameCube & Wii [ngc][dolphin] (dev)"
        ]
    ],
    "persist": "User",
    "checkver": {
        "url": "https://dolphin-emu.org/update/latest/dev",
        "regex": "(?<prefix2>[a-f0-9]{2}/[a-f0-9]{2})/dolphin-master-(?<version>[\\w-]+)-(?:arm64|ARM64)[\\s\\S]+?(?<prefix1>[a-f0-9]{2}/[a-f0-9]{2})/dolphin-master-\\k<version>-x64"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.dolphin-emu.org/builds/$matchPrefix1/dolphin-master-$version-x64.7z"
            },
            "arm64": {
                "url": "https://dl.dolphin-emu.org/builds/$matchPrefix2/dolphin-master-$version-arm64.7z"
            }
        }
    }
}
