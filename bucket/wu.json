{
    "homepage": "https://github.com/dstrml/wu",
    "description": "A fast, native code editor and agent workspace, a Rust fork of Zed",
    "version": "1.1.16",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dstrml/wu/releases/download/v1.1.16/Wu-x86_64.exe",
            "hash": "6901f8545d8e3e249ea6d86425b6677d534366a38dbb533da06880686da5d53c"
        }
    },
    "depends": "innounp",
    "installer": {
        "script": [
            "Expand-InnoArchive -Path \"$dir\\$fname\" -ExtractDir '{app}'",
            "Expand-InnoArchive -Path \"$dir\\$fname\" -ExtractDir '{code_GetInstallDir}' -Removal"
        ]
    },
    "persist_external": [
        [
            "$env:AppData\\Wu",
            "config",
            "directory"
        ],
        [
            "$env:LocalAppData\\Wu",
            "data",
            "directory"
        ]
    ],
    "post_install": [
        "$installContext = (Resolve-Path \"$bucketsdir\\*\\scripts\\wu\\install-context.reg\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "$uninstallContext = (Resolve-Path \"$bucketsdir\\*\\scripts\\wu\\uninstall-context.reg\" -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        "if (!$installContext -or !$uninstallContext) { warn 'wu context menu templates not found in bucket/scripts; skipping context menu setup' } else {",
        "$appPath = $dir.Replace('\\', '\\\\')",
        "(Get-Content $installContext -Raw).Replace('{{dir}}', $appPath) | Set-Content \"$dir\\install-context.reg\" -Encoding Ascii",
        "(Get-Content $uninstallContext -Raw).Replace('{{dir}}', $appPath) | Set-Content \"$dir\\uninstall-context.reg\" -Encoding Ascii",
        "}",
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalInstall"
    ],
    "pre_uninstall": [
        ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
        "Invoke-PersistExternalUninstall"
    ],
    "bin": "bin\\wu.exe",
    "shortcuts": [
        [
            "Wu.exe",
            "Wu"
        ]
    ],
    "notes": [
        "Please disable auto-update in Wu's settings, or the updater installs a second copy outside Scoop's directory.",
        "Context menu: reg import \"$dir\\install-context.reg\"",
        "Remove context menu: reg import \"$dir\\uninstall-context.reg\" (run before uninstalling)",
        "Settings and databases are kept in persist\\wu via persist_external - purge with: scoop uninstall wu -p"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dstrml/wu/releases/download/v$version/Wu-x86_64.exe"
            }
        }
    }
}
