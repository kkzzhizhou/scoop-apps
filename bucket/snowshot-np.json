{
    "version": "1.1.1-beta",
    "description": "SnowShot 是一款功能强大的截图工具，集成了文字识别、翻译和 AI 对话等功能",
    "homepage": "https://github.com/mg-chao/snow-shot",
    "license": "Apache-2.0|GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mg-chao/snow-apps/releases/download/v1.1.1-beta/snow-shot-1.1.1-beta-windows-x64-offline.exe#/dl.7z",
            "hash": "008cda68407b026e505248e3c398aea4c36200f0cd0998b01485660f6209fa00"
        }
    },
    "shortcuts": [
        [
            "snowshot.exe",
            "Snow Shot"
        ]
    ],
    "post_install": "Remove-Item \"$dir\\uninstall*\", \"$dir\\`$*\" -Force -Recurse -ErrorAction SilentlyContinue",
    "post_uninstall": "if ($purge) { Remove-Item \"$env:LOCALAPPDATA\\com.chao.snowshot\" -Force -Recurse -ErrorAction SilentlyContinue }",
    "persist": [
        "configs",
        "plugins",
        "stores",
        "captureHistoryImages"
    ],
    "checkver": {
        "url": "https://github.com/mg-chao/snow-shot/releases",
        "regex": "tree/v([\\d.\\-a-zA-Z]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mg-chao/snow-apps/releases/download/v$version/snow-shot-$version-windows-x64-offline.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/mg-chao/snow-apps/releases/tags/v$version",
            "jp": "$.assets[?(@.browser_download_url == '$url')].digest"
        }
    }
}
