{
    "version": "2.2.0",
    "description": "A desktop client that supports for multiple LLM providers.",
    "homepage": "https://cherry-ai.com",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.2.0/Cherry-Studio-2.2.0-win-x64-setup.exe#/dl.7z",
            "hash": "sha512:0e88e35105d7ea45fe52d7f3cf296405c0d17c22317f4fc97022282220deec80175a6354f10968d1fb3277865c8453ae0afedc47d18bc5f26691c51d5cc29962",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -ErrorAction SilentlyContinue",
                "Set-Content -Path \"$dir\\Cherry Studio.cmd\" -Value '@echo off', 'set \"PORTABLE_EXECUTABLE_DIR=%~dp0\"', 'start \"\" \"%~dp0Cherry Studio.exe\"' -Encoding ASCII"
            ]
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.2.0/Cherry-Studio-2.2.0-win-arm64-setup.exe#/dl.7z",
            "hash": "sha512:9f7c142c794d984c38d4d18e03ccfe4dbeb21b60d558d6d150d8ec3aa9fbfa122642addda50396cb6be143e92b6814e9fe9c2b669ac9b4fde8687c911fec65d1",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -ErrorAction SilentlyContinue",
                "Set-Content -Path \"$dir\\Cherry Studio.cmd\" -Value '@echo off', 'set \"PORTABLE_EXECUTABLE_DIR=%~dp0\"', 'start \"\" \"%~dp0Cherry Studio.exe\"' -Encoding ASCII"
            ]
        }
    },
    "post_install": [
        "if (-not (Get-ChildItem \"$persist_dir\\data\" -Force -ErrorAction SilentlyContinue) -and (Test-Path \"$env:APPDATA\\CherryStudio\")) {",
        "    info '[Portable Mode] Copying user data...'",
        "    Move-Item \"$env:APPDATA\\CherryStudio\\*\" \"$persist_dir\\data\"",
        "    Remove-Item \"$env:APPDATA\\CherryStudio\" -Recurse -Force",
        "}"
    ],
    "shortcuts": [
        [
            "Cherry Studio.cmd",
            "Cherry Studio"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/CherryHQ/cherry-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-win-x64-setup.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "x64-setup.exe\\s+sha512:\\s+$base64"
                }
            },
            "arm64": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-win-arm64-setup.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "arm64-setup.exe\\s+sha512:\\s+$base64"
                }
            }
        }
    }
}
