    "license": {
        "identifier": "GPL-3.0",
        "url": "https://github.com/luolangaga/tubatools/blob/master/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/luolangaga/tubatools/releases/download/v1.5.3/TubaWinUi3_Setup_1.5.3_x64.exe",
            "hash": "1f898cdef435ebcdc135d9af9f18188789e52eda123791948ad778322ad6ff47"
        },
        "arm64": {
            "url": "https://github.com/luolangaga/tubatools/releases/download/v1.5.3/TubaWinUi3_Setup_1.5.3_arm64.exe",
            "hash": "bc1b402849e92c3389f53519673e3e2333c4b2952a076b55f1091bad5f203d06"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\TubaWinUi3\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\TubaWinUi3\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "TubaWinUi3.exe",
    "shortcuts": [
        [
            "TubaWinUi3.exe",
            "图吧工具箱WinUI3"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/luolangaga/tubatools/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/luolangaga/tubatools/releases/download/v$version/TubaWinUi3_Setup_$version_x64.exe"
            },
            "arm64": {
                "url": "https://github.com/luolangaga/tubatools/releases/download/v$version/TubaWinUi3_Setup_$version_arm64.exe"
            }
        }
    }
}
