    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/luolangaga/tubatools/releases/download/v1.6.4/TubaWinUi3_Setup_1.6.4_x64.exe",
            "hash": "71d1d318f1f10dbdb0402fbd0cc422fa18321336770afd4356f26ceaefa0e386"
        },
        "arm64": {
            "url": "https://github.com/luolangaga/tubatools/releases/download/v1.6.4/TubaWinUi3_Setup_1.6.4_arm64.exe",
            "hash": "cbf9b3ff26f0dd1238c8be9311251992004787f6c34c6071813c737b47814789"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\TubaWinUi3\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\TubaWinUi3\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "TubaWinUi3.exe",
    "shortcuts": [
        [
            "TubaWinUi3.exe",
            "图吧工具箱WinUI3"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/luolangaga/tubatools/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/luolangaga/tubatools/releases/download/v$version/TubaWinUi3_Setup_$version_x64.exe"
            },
            "arm64": {
                "url": "https://github.com/luolangaga/tubatools/releases/download/v$version/TubaWinUi3_Setup_$version_arm64.exe"
            }
        }
    }
}
