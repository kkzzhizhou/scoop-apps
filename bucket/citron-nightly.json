{
    "version": "7dc47bab8",
    "description": "Open-source Nintendo Switch emulator (nightly build)",
    "homepage": "https://citron-neo.org/",
    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://github.com/citron-neo/emulator/blob/main/LICENSE"
    },
    "notes": [
        "Citron requires legally obtained game files, keys, and firmware to function. These are not included.",
        "Nightly builds are experimental. Back up your saves before testing."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/citron-neo/CI/releases/download/nightly-windows/Citron-windows-nightly-7dc47bab8-x64-clang-cl.zip",
            "hash": "0cd7ad5b566476e55cf7a766b3d3c370e471fdb950cdafc8fabada993a509ef5"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   New-item \"$persist_dir\\user\" -ItemType Directory | Out-Null",
        "   if (Test-Path \"$env:APPDATA\\citron\") {",
        "       Write-host \"Migrating AppData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:APPDATA\\citron\\*\" -Destination \"$persist_dir\\user\" -Recurse",
        "       Remove-Item -Path \"$env:APPDATA\\citron\" -Recurse",
        "   }",
        "}"
    ],
    "bin": [
        [
            "citron-cmd.exe",
            "citron-nightly"
        ]
    ],
    "shortcuts": [
        [
            "citron.exe",
            "Nintendo Switch [nsw][citron] (nightly)"
        ]
    ],
    "persist": "user",
    "checkver": {
        "url": "https://api.github.com/repos/citron-neo/CI/releases/tags/nightly-windows",
        "regex": "Citron-windows-nightly-(?<version>[a-f0-9]+)-x64-clang-cl\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/citron-neo/CI/releases/download/nightly-windows/Citron-windows-nightly-$version-x64-clang-cl.zip",
                "hash": {
                    "url": "https://api.github.com/repos/citron-neo/CI/releases/tags/nightly-windows",
                    "jsonpath": "$.assets[?(@.name == '$basename')].digest",
                    "mode": "json"
                }
            }
        }
    }
}
