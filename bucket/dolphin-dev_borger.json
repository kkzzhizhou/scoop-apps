{
    "version": "2609-166",
    "description": "A Nintendo GameCube and Wii emulator",
    "homepage": "https://dolphin-emu.org/",
    "license": {
        "identifier": "GPL-2.0-or-later",
        "url": "https://github.com/dolphin-emu/dolphin/blob/master/COPYING"
    },
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://dl.dolphin-emu.org/builds/b6/5d/dolphin-master-2609-166-x64.7z",
            "hash": "ac7b4c19cf0f07a833c291a317aee8a5c16edb04ba42055c59ffca652e16442f",
            "extract_dir": "Dolphin-x64"
        },
        "arm64": {
            "url": "https://dl.dolphin-emu.org/builds/a7/a2/dolphin-master-2609-166-arm64.7z",
            "hash": "ca3c423d15b36734e716a747fcc792cb97e1d46f414e7fea54c856ee9c01b76e",
            "extract_dir": "Dolphin-ARM64"
        }
    },
    "pre_install": [
        "$appdataPath = \"$Env:AppData\\Dolphin Emulator\"",
        "if ((Test-Path -Path $appdataPath\\*) -and (!(Test-Path -Path $persist_dir\\*))) {",
        "   Write-Warning \"Migrating AppData...\"",
        "   New-Item -Type Directory -Path $persist_dir\\User -Force | Out-Null",
        "   Copy-Item -Recurse -Force $appdataPath\\* -Destination $persist_dir\\User\\",
        "}"
    ],
    "post_install": "Set-Content -Value $null -Path \"$dir\\portable.txt\"",
    "bin": [
        [
            "Dolphin.exe",
            "dolphin-dev"
        ],
        [
            "DolphinTool.exe",
            "dolphintool-dev"
        ]
    ],
    "shortcuts": [
        [
            "Dolphin.exe",
            "Nintendo GameCube & Wii [ngc][dolphin] (dev)"
        ]
    ],
    "persist": "User",
    "checkver": {
        "url": "https://dolphin-emu.org/update/latest/dev",
        "script": [
            "$release = Invoke-RestMethod $url",
            "$windowsX64 = $release.artifacts | Where-Object { $_.system -eq 'Windows x64' } | Select-Object -First 1",
            "$windowsArm64 = $release.artifacts | Where-Object { $_.system -eq 'Windows arm64' } | Select-Object -First 1",
            "if (!$windowsX64 -or !$windowsArm64) { throw 'Could not find both Windows builds in the latest Dolphin metadata' }",
            "if ($windowsX64.url -notmatch '/builds/(?<prefix1>[a-f0-9]{2}/[a-f0-9]{2})/') { throw 'Could not find the Windows x64 build path' }",
            "$prefix1 = $Matches.prefix1",
            "if ($windowsArm64.url -notmatch '/builds/(?<prefix2>[a-f0-9]{2}/[a-f0-9]{2})/') { throw 'Could not find the Windows ARM64 build path' }",
            "$prefix2 = $Matches.prefix2",
            "return \"$($release.shortrev) $prefix1 $prefix2\""
        ],
        "regex": "(?<version>[\\w-]+) (?<prefix1>[a-f0-9]{2}/[a-f0-9]{2}) (?<prefix2>[a-f0-9]{2}/[a-f0-9]{2})"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.dolphin-emu.org/builds/$matchPrefix1/dolphin-master-$version-x64.7z"
            },
            "arm64": {
                "url": "https://dl.dolphin-emu.org/builds/$matchPrefix2/dolphin-master-$version-arm64.7z"
            }
        }
    }
}
