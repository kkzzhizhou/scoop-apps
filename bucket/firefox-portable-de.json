        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/156.0/win32/de-DE/Firefox%20Setup%20156.0.exe#/dl.7z",
            "hash": "sha512:430831e106db9ae3cc9aa9d2c0f3480cdda2017ac8833188cd22057b13b21612ad1a27ec5ed2b75589d5e64f33d54f56507f40e4d34737c90346a0b484270a9f"
