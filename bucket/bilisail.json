{
    "version": "1.3.1+0",
    "description": "A cross-platform Bilibili client focused on video, live streaming and offline playback.",
    "homepage": "https://github.com/CKopoer/BiliSail",
    "license": "Unknown",
    "notes": "Microsoft Edge WebView2 Runtime is required for web login and verification.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CKopoer/BiliSail/releases/download/v1.3.1+0/BiliSail-1.3.1+0-windows-x64.msi",
            "hash": "40a9ff8c55cb815fad1b8dc89f9c28167ebed4820c3115df730082d36d9d1341"
        },
        "arm64": {
            "url": "https://github.com/CKopoer/BiliSail/releases/download/v1.3.1+0/BiliSail-1.3.1+0-windows-arm64.msi",
            "hash": "82cb8f52c6e646118ab32f44d2b6da64b4c493d49c299dff004587a12affd03b"
        }
    },
    "extract_dir": "PFiles64\\BiliSail",
    "shortcuts": [
        [
            "bilisail.exe",
            "BiliSail"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/CKopoer/BiliSail/releases?per_page=100",
        "script": [
            "$releases = $page | ConvertFrom-Json",
            "$release = $releases | Where-Object {",
            "    if ($_.draft -or $_.prerelease -or $_.tag_name -notmatch '^v[\\d.]+(?:\\+\\d+)?$') { return $false }",
            "    $version = $_.tag_name.Substring(1)",
            "    $assets = $_.assets | Where-Object { $_.state -eq 'uploaded' -and $_.size -gt 0 }",
            "    foreach ($arch in 'x64', 'arm64') {",
            "        $name = \"BiliSail-$version-windows-$arch.msi\"",
            "        if (!($assets | Where-Object { $_.name -eq $name -and $_.size -gt 1024 }) -or $assets.name -notcontains \"$name.sha256\") { return $false }",
            "    }",
            "    return $true",
            "} | Sort-Object published_at -Descending | Select-Object -First 1",
            "if (!$release) { throw 'No stable BiliSail release with complete Windows MSI assets found.' }",
            "$release.tag_name"
        ],
        "regex": "^v([\\d.]+(?:\\+\\d+)?)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CKopoer/BiliSail/releases/download/v$version/BiliSail-$version-windows-x64.msi"
            },
            "arm64": {
                "url": "https://github.com/CKopoer/BiliSail/releases/download/v$version/BiliSail-$version-windows-arm64.msi"
            }
        },
        "hash": {
            "url": "$url.sha256",
            "regex": "^([a-fA-F0-9]{64})\\s"
        }
    }
}
