    "extract_dir": "Audacity 4",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\Portable Settings\\audacity.cfg\")) {",
        "    ensure \"$dir\\Portable Settings\" | Out-Null",
        "    Set-Content \"$dir\\Portable Settings\\audacity.cfg\" '[Update]', 'DefaultUpdatesChecking=0' -Encoding Ascii",
        "}"
    ],
    "bin": [
        [
            "bin\\Audacity4.exe",
            "Audacity"
        ]
    ],
    "shortcuts": [
        [
            "bin\\Audacity4.exe",
            "Audacity"
        ]
    ],
    "persist": "Portable Settings",
    "checkver": {
        "github": "https://github.com/audacity/audacity",
        "regex": "Audacity-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/audacity/audacity/releases/download/Audacity-$version/audacity-win-$version-x86_64.msi"
            },
            "arm64": {
                "url": "https://github.com/audacity/audacity/releases/download/Audacity-$version/audacity-win-$version-arm64.msi"
            }
        },
        "hash": {
            "url": "$baseurl/CHECKSUMS.txt",
            "regex": "$basename.*?$sha256"
        }
    }
