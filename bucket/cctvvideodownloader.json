{
    "version": "4.4.0",
    "description": "一款适用于央视网的网络视频流解析处理工具",
    "homepage": "https://github.com/letr007/CCTVVideoDownloader",
    "license": {
        "identifier": "Copyright (C) 2025 Letr",
        "url": "https://github.com/letr007/CCTVVideoDownloader#License-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/letr007/CCTVVideoDownloader/releases/download/v4.4.0/CCTVVideoDownloader.v4.4.0.win.x64.zip",
            "hash": "73ad4224beb6c2d1216552b16489ccaf250c296d28b3b8796fc63422e34a15e1"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\CCTVVideoDownloader\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\logdata\" -Target \"$env:APPDATA\\CCTVVideoDownloader\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\CCTVVideoDownloader\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\CCTVVideoDownloader\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "CCTVVideoDownloader.exe",
    "shortcuts": [
        [
            "CCTVVideoDownloader.exe",
            "CCTVVideoDownloader"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/letr007/CCTVVideoDownloader/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/letr007/CCTVVideoDownloader/releases/download/v$version/CCTVVideoDownloader.v$version.win.x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
