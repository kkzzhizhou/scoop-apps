{
    "version": "0.3.0",
    "description": "Command-line tool that creates JSON",
    "homepage": "https://github.com/h4l/json.bash",
    "license": "MIT",
    "url": "https://raw.githubusercontent.com/h4l/json.bash/main/json.bash",
    "hash": "04c9708dcb985a907419c6581438b8972a47607b4779473f4fde1267bdb9fbf7",
    "installer": {
        "script": [
            "Set-Content \"$dir\\jb.bat\" \"@for /f %%i in ('scoop prefix git') do @%%i\\bin\\bash.exe %~dp0json.bash %*\" -Encoding ASCII"
        ]
    },
    "bin": [
        "jb.bat"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/h4l/json.bash/tags",
        "jsonpath": "$[0].name",
        "regex": "v?([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/h4l/json.bash/main/json.bash"
    }
}
