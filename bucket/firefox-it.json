            ],
            "hash": [
                "sha512:3f9796a09314dacb3fefcc17e018875a1bff38374673102014a5998145a27825da5cdfa087984466e7a6671b2d0cfbef51a52f9997691207194c190461373f73",
                "cb75fbc7489904edf08041213b70c67c8dad3f54fdecdadd623fdb0f44cbaef6"
            ]
        },
        "32bit": {
            "url": [
                "https://archive.mozilla.org/pub/firefox/releases/155.0.1/win32/it/Firefox%20Setup%20155.0.1.exe#/dl.7z",
                "https://raw.githubusercontent.com/starise/scoop-confetti/master/scripts/firefox-policies.json#/policies.json"
