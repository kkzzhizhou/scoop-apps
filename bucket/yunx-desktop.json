{
    "version": "1.3.3",
    "description": "YunX（云析）的官方 windows 桌面端",
    "homepage": "https://github.com/tidain/YunX-Desktop",
    "license": {
        "identifier": "AGPL-3.0 license",
        "url": "https://github.com/tidain/YunX-Desktop#AGPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tidain/YunX-Desktop/releases/download/v1.3.3/YunX-Desktop-setup-1.3.3.exe",
            "hash": "ff2703eddaf2ec9538278a685b846489f57c7f18465d33274a4b1e276e880f28"
        }
    },
    "innosetup": true,
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:USERPROFILE\\.yunx-desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:USERPROFILE\\.yunx-desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "YunX-Desktop.exe",
    "shortcuts": [
        [
            "YunX-Desktop.exe",
            "YunX-Desktop"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/tidain/YunX-Desktop/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tidain/YunX-Desktop/releases/download/v$version/YunX-Desktop-setup-$version.exe"
            }
        }
    }
}
