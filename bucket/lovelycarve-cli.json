    "post_install": "$sub = Get-ChildItem $dir -Directory -Filter 'lovelycarve-cli-*' | Select-Object -First 1; Get-ChildItem $sub.FullName | Move-Item -Destination $dir -Force; Remove-Item $sub.FullName -Recurse -Force",
    "bin": "lovelycarve-cli.exe",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/LovelyTeams/LovelyCarve/releases/download/v$version/lovelycarve-cli-v$version-win-x64.zip",
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "([a-fA-F0-9]{64})\\s+lovelycarve-cli-v$version-win-x64\\.zip"
        }
    },
    "notes": [
        "【工具类型】: 取证工具",
        "【主要功能】: 命令行磁盘镜像解析、文件系统分析、文件雕刻与插件分析",
        "【适用场景】: 批量取证处理、自动化脚本、CTF 取证赛题、DFIR 调查",
        "【技术特点】: Rust 开发，内置 linuxinfo 插件，压缩包顶层目录名含构建时间戳，安装时自动归置到根目录",
        "【注意事项】: 图形界面版本可安装本仓库的 LovelyCarve 包"
    ]
