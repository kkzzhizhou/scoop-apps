{
    "version": "3.07",
    "description": "A command line AAC/ALAC encoder frontend based on Apple encoder.",
    "homepage": "https://sites.google.com/site/qaacpage/",
    "license": {
        "identifier": "Public Domain",
        "url": "https://github.com/nu774/qaac/blob/master/COPYING"
    },
    "url": "https://github.com/nu774/qaac/releases/download/v3.07/qaac_3.07.zip",
    "hash": "1fb3ab4aa81725e2607ac1b31afa0e13d2617ee6eb5900f5070c092f5271cbb3",
    "notes": "To fix 'ERROR: CoreAudioToolbox.dll: The specified module could not be found.', Please install `muggle/qaac-qtfiles`",
    "suggest": {
        "qaac-qtfiles": "muggle/qaac-qtfiles"
    },
    "pre_install": "Remove-Item \"$dir\\qaac_*\" -Force -Recurse",
    "architecture": {
        "64bit": {
            "extract_dir": "qaac_3.07\\x64",
            "bin": [
                "qaac64.exe",
                "refalac64.exe",
                [
                    "qaac64.exe",
                    "qaac"
                ],
                [
                    "refalac64.exe",
                    "refalac"
                ]
            ],
            "post_install": [
                "$qtfilesDir = $(appdir 'qaac-qtfiles' $global)",
                "if (Test-Path \"$qtfilesDir\") {",
                "    $qtfilesCurrent = Join-Path \"$qtfilesDir\" 'current'",
                "    if (Test-Path \"$qtfilesCurrent\") {",
                "        Get-ChildItem -Path \"$dir\" -Filter 'QTFiles*' | Remove-Item -Force -Recurse",
                "        New-Item \"$dir\\QTFiles64\" -ItemType Junction -Target \"$qtfilesCurrent\" | Out-Null",
                "    }",
                "}"
            ]
        },
        "32bit": {
            "extract_dir": "qaac_3.07\\x86",
            "bin": [
                "qaac.exe",
                "refalac.exe"
            ],
            "post_install": [
                "$qtfilesDir = $(appdir 'qaac-qtfiles' $global)",
                "if (Test-Path \"$qtfilesDir\") {",
                "    $qtfilesCurrent = Join-Path \"$qtfilesDir\" 'current'",
                "    if (Test-Path \"$qtfilesCurrent\") {",
                "        Get-ChildItem -Path \"$dir\" -Filter 'QTFiles*' | Remove-Item -Force -Recurse",
                "        New-Item \"$dir\\QTFiles\" -ItemType Junction -Target \"$qtfilesCurrent\" | Out-Null",
                "    }",
                "}"
            ]
        }
    },
    "checkver": {
        "github": "https://github.com/nu774/qaac"
    },
    "autoupdate": {
        "url": "https://github.com/nu774/qaac/releases/download/v$version/qaac_$version.zip",
        "architecture": {
            "64bit": {
                "extract_dir": "qaac_$version\\x64"
            },
            "32bit": {
                "extract_dir": "qaac_$version\\x86"
            }
        }
    }
}
