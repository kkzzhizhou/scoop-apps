    "license": {
        "identifier": "AGPL-3.0 license",
        "url": "https://github.com/egoist/mygo-cloudmusic#AGPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/egoist/mygo-cloudmusic/releases/download/v0.1.24/mygo-cloudmusic-setup-0.1.24-amd64.exe#/dl.7z",
            "hash": "681652cde01383f78299a1e77343406fd8a0450c9795a58dba3fdbe656cd54e4"
        },
        "arm64": {
            "url": "https://github.com/egoist/mygo-cloudmusic/releases/download/v0.1.24/mygo-cloudmusic-setup-0.1.24-arm64.exe#/dl.7z",
            "hash": "99f99eef56acefab584fb2e8c06dc4a9c8825a9460afcad05ca4a6db745f5678"
        }
    },
    "pre_install": [
        "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse",
        "Get-ChildItem \"$dir\\MyGo*.exe\" | Rename-Item -NewName 'MyGoCloudMusic.exe'"
    ],
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\MyGo 云音乐\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\MyGo 云音乐\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\MyGo 云音乐\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\MyGo 云音乐\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "MyGoCloudMusic.exe",
    "shortcuts": [
        [
            "MyGoCloudMusic.exe",
            "MyGo云音乐"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/egoist/mygo-cloudmusic/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/egoist/mygo-cloudmusic/releases/download/v$version/mygo-cloudmusic-setup-$version-amd64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/egoist/mygo-cloudmusic/releases/download/v$version/mygo-cloudmusic-setup-$version-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
