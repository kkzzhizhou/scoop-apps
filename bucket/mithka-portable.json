    },
    "extract_dir": "Mithka",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\ad.neko\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\ad.neko\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "mithka.exe",
    "shortcuts": [
        [
            "mithka.exe",
            "Mithka"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/iebb/mithka/releases/latest",
        "jp": "$.assets[*].browser_download_url",
        "regex": "/releases/download/v([\\d.]+)/mithka-([\\d.]+)-(?<date>[\\d]+)-windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iebb/mithka/releases/download/v$version/mithka-$version-$matchDate-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/iebb/mithka/releases/download/v$version/mithka-$version-$matchDate-windows-arm64.zip"
            }
        }
    }
