{
    "version": "1.0.2",
    "description": "跨平台视频播放器，支持导入自己的影视源和 IPTV 直播源。",
    "homepage": "https://github.com/sky22333/sky-tv",
    "license": {
        "identifier": "GPL-3.0 license",
        "url": "https://github.com/sky22333/sky-tv#GPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/sky22333/sky-tv/releases/download/v1.0.2/sky-tv-windows-x64.zip",
            "hash": "15d6fe640b8c4165eb01977047fdae12a119990739aade9282e3d732f870b69c"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\io.github.sky22333\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\io.github.sky22333\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "skytv.exe",
    "shortcuts": [
        [
            "skytv.exe",
            "skytv"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/sky22333/sky-tv/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sky22333/sky-tv/releases/download/v$version/sky-tv-windows-x64.zip"
            }
        }
    }
}
