{
    "version": "1.34.1",
    "description": "酷安跨平台桌面版",
    "homepage": "https://github.com/daimiaopeng/coolapk-desktop",
    "license": {
        "identifier": "MIT license",
        "url": "https://github.com/daimiaopeng/coolapk-desktop#MIT-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v1.34.1/coolapk-desktop_1.34.1_x64-setup.exe#/dl.7z",
            "hash": "18f56504625f450038297ff43feaf3709514d51a2fb1ed8362592e216d3451e1"
        },
        "arm64": {
            "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v1.34.1/coolapk-desktop_1.34.1_arm64-setup.exe#/dl.7z",
            "hash": "349ab60ad2bda3270140e8b219aa2d0ff4684a43bc7ded49695b6be4d84552c6"
        }
    },
    "pre_install": [
        "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse",
        "Get-ChildItem \"$dir\\coolapk*.exe\" | Rename-Item -NewName 'coolapk.exe'"
    ],
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\com.coolapk.desktop\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\com.coolapk.desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\com.coolapk.desktop\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.coolapk.desktop\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "coolapk.exe",
    "shortcuts": [
        [
            "coolapk.exe",
            "Coolapk"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/daimiaopeng/coolapk-desktop/releases/latest",
        "jp": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v$version/coolapk-desktop_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/daimiaopeng/coolapk-desktop/releases/download/v$version/coolapk-desktop_$version_arm64-setup.exe#/dl.7z"
            }
        }
    }
}
