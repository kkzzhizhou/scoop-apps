    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\app.solomd\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\app.solomd\"",
            "Remove-Module -Name AppsUtils"
        ]
