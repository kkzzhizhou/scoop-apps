{
    "version": "3.1.1",
    "description": "针对SpringBoot的开源渗透框架，以及Spring相关高危漏洞利用工具",
    "notes": [
        "【工具类型】: 安全测试工具",
        "【主要功能】: SpringBoot开源渗透框架，支持Spring相关高危漏洞利用",
        "【适用场景】: 漏洞扫描、安全评估、渗透测试",
        "【技术特点】: Python开发，命令行工具，需要Python环境"
    ],
    "homepage": "https://github.com/AabyssZG/SpringBoot-Scan",
    "license": "unknown",
    "suggest": {
        "python": "uv"
    },
    "url": "https://github.com/AabyssZG/SpringBoot-Scan/archive/refs/tags/3.1.1.zip",
    "hash": "6eebe7d75add0f08df4229e6941afde1d2f95182ede33b50f98312abe1a608c8",
    "extract_dir": "SpringBoot-Scan-3.1.1",
    "pre_install": [
        "Set-Content \"$dir\\SpringBoot-Scan.bat\" '@pushd %~dp0",
        "@uv run python \"SpringBoot-Scan.py\" %*",
        "@popd' -Encoding Ascii"
    ],
    "post_install": [
        "uv venv \"$dir\\.venv\"",
        "uv pip install -r $dir\\requirements.txt --python \"$dir\\.venv\\Scripts\\python.exe\""
    ],
    "bin": "SpringBoot-Scan.bat",
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/AabyssZG/SpringBoot-Scan/archive/refs/tags/$version.zip",
        "extract_dir": "SpringBoot-Scan-$version"
    }
}
