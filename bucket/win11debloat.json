{
    "version": "2026.10.30",
    "description": "A simple, lightweight PowerShell script and GUI to remove pre-installed bloatware, disable telemetry and customize Windows 10/11",
    "homepage": "https://github.com/Raphire/Win11Debloat",
    "license": "MIT",
    "url": "https://github.com/Raphire/Win11Debloat/archive/refs/tags/2026.10.30.zip",
    "hash": "b8818711d8464a311cf5b3cfc43ac534a8833670b179de09a22e0e50eb8ded65",
    "extract_dir": "Win11Debloat-2026.10.30",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\Config\\LastUsedSettings.json\")) { New-Item \"$persist_dir\\Config\\LastUsedSettings.json\" -ItemType File -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\Backups\")) { New-Item \"$persist_dir\\Backups\" -ItemType Directory -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\Logs\")) { New-Item \"$persist_dir\\Logs\" -ItemType Directory -Force | Out-Null }"
    ],
    "bin": [
        [
            "Win11Debloat.ps1",
            "win11debloat"
        ]
    ],
    "shortcuts": [
        [
            "Run.bat",
            "Win11Debloat"
        ]
    ],
    "persist": [
        "Backups",
        "Logs",
        "Config/LastUsedSettings.json"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/Raphire/Win11Debloat/archive/refs/tags/$version.zip",
        "extract_dir": "Win11Debloat-$version"
    }
}
