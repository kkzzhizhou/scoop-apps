    ],
    "bin": "nuclei.exe",
    "pre_install": [
        "if ((Test-Path \"$env:USERPROFILE\\nuclei-templates\") -and !(Test-Path \"$persist_dir\\nuclei-templates\")) { Copy-Item \"$env:USERPROFILE\\nuclei-templates\" \"$dir\\nuclei-templates\" -Recurse -Force }"
    ],
    "env_set": {
        "NUCLEI_TEMPLATES_DIR": "$persist_dir\\nuclei-templates"
    },
    "persist": "nuclei-templates",
    "checkver": {
        "github": "https://github.com/projectdiscovery/nuclei"
    },
    "autoupdate": {
        "url": [
            "https://github.com/projectdiscovery/nuclei/releases/download/v$version/nuclei_$version_windows_amd64.zip",
            "https://github.com/projectdiscovery/nuclei/releases/download/v$version/nuclei_$version_linux_amd64.zip"
        ]
    },
    "notes": [
        "【工具类型】: 安全测试工具",
        "【主要功能】: 快速可定制的漏洞扫描器，基于YAML DSL语法，支持丰富的漏洞模板",
        "【适用场景】: 漏洞扫描、安全评估、渗透测试",
        "【技术特点】: Go语言开发，命令行工具，包含Windows和Linux两个版本，默认使用Windows版本",
        "【注意事项】: 模板目录已持久化到 persist\\nuclei\\nuclei-templates（通过 NUCLEI_TEMPLATES_DIR 环境变量指向），升级重装不丢失；首次更新会自动迁移 %USERPROFILE%\\nuclei-templates 旧模板，迁移后可手动删除旧目录；新开终端后环境变量才生效"
    ]
}
