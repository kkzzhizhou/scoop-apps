            "hash": "28c507772b81a110a7d963773d170b08610ccace780f1841ceb8c659f7a8a58a"
        },
        "arm64": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.5.2/Ghost-Downloader-v4.5.2-Windows-arm64-Setup.exe",
