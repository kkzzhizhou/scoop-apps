            "hash": "a69dde674632a69245a6f959d14771e89315c33f51d3269b5845e2f5d49412e7"
        },
        "arm64": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.5.1/Ghost-Downloader-v4.5.1-Windows-arm64-Setup.exe",
