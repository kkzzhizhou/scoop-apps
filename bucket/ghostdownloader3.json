            "hash": "9c198484d55b5c50375e5b79fc372ecf4a0cde307b649b2451c91c09e49eb44f"
        },
        "arm64": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.5.7/Ghost-Downloader-v4.5.7-Windows-arm64-Setup.exe",
