            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.4.6/Ghost-Downloader-v4.4.6-Windows-x86_64-Setup.exe",
            "hash": "d4cc459f396a27f89c8c35155a040bcd73e06fecb5e9ce71ae38ec329866ae4c"
        },
        "arm64": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.4.6/Ghost-Downloader-v4.4.6-Windows-arm64-Setup.exe",
            "hash": "217bec7baac7df5ad702404912dddc3a8fdc21a9349f39ace531a6a04b43d8d9"
        }
    },
    "innosetup": true,
    "bin": "Ghost-Downloader-3.exe",
    "shortcuts": [
        [
            "Ghost-Downloader-3.exe",
            "Ghost-Downloader-3"
        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://api.github.com/repos/XiaoYouChR/Ghost-Downloader-3/releases'",
            "$cont = (Invoke-WebRequest $url).Content",
            "$r = 'Ghost-Downloader-v([\\d.]+)-Windows-x86_64' ",
            "if (!($cont -match $r)) { error \"Could not match $r in $url\"; continue }",
            "$version = $matches[1]",
            "$r = 'Ghost-Downloader-v([\\d.]+)-Windows-arm64' ",
            "if (!($cont -match $r)) { error \"Could not match $r in $url\"; continue }",
            "$arm64 = $matches[1]",
            "Write-Output $version $arm64"
        ],
        "regex": "([\\d.]+) (?<arm64>[\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$version/Ghost-Downloader-v$version-Windows-x86_64-Setup.exe"
            },
            "arm64": {
                "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v$matchArm64/Ghost-Downloader-v$matchArm64-Windows-arm64-Setup.exe"
            }
        }
    }
}
